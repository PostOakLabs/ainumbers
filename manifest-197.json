{
  "tool_id": "credit-risk-rating-calculator",
  "version": "4.0.0",
  "title": "Credit Risk Rating Calculator",
  "description": "Input financial ratios to derive an internal credit rating mapped to S&P, Moody's, and Fitch equivalents (AAA–D). Configurable weighting by industry sector and counterparty type. Outputs rating scorecard, rationale narrative, Markdown memo, and AP2 JSON credit profile. Client-side. Zero PII.",
  "category": "cat-17",
  "tags": ["Credit Rating", "S&P", "Moody's", "Fitch", "Basel III", "IFRS 9", "AP2", "export"],
  "audience": ["credit-analyst", "risk-officer", "relationship-manager"],
  "input_schema": {
    "type": "object",
    "properties": {
      "counterparty_type": { "type": "string", "enum": ["corporate","bank","sovereign","sme"] },
      "sector": { "type": "string", "enum": ["general","tech","healthcare","utilities","realestate","energy","retail","financial"] },
      "weighting_profile": { "type": "string", "enum": ["balanced","leverage","coverage","liquidity"] },
      "net_debt_ebitda": { "type": "number", "description": "Net Debt / EBITDA ratio (×)" },
      "ebitda_interest": { "type": "number", "description": "EBITDA / Interest Expense (×)" },
      "ebitda_margin": { "type": "number", "description": "EBITDA Margin (%)" },
      "fcf_debt": { "type": "number", "description": "Free Cash Flow / Debt (%)" },
      "current_ratio": { "type": "number", "description": "Current Ratio (×)" },
      "debt_equity": { "type": "number", "description": "Debt / Equity (%)" }
    },
    "required": ["counterparty_type","sector","weighting_profile","net_debt_ebitda","ebitda_interest","ebitda_margin","fcf_debt","current_ratio","debt_equity"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "composite_score": { "type": "number", "description": "Weighted composite score 0–100" },
      "internal_rating": { "type": "string", "description": "Internal rating grade e.g. BBB+" },
      "sp_equivalent": { "type": "string" },
      "moodys_equivalent": { "type": "string" },
      "fitch_equivalent": { "type": "string" },
      "rating_category": { "type": "string", "enum": ["ig","hy","dist"] },
      "scorecard": { "type": "array", "items": { "type": "object" } },
      "ap2_mandate": { "type": "object" }
    }
  },
  "mcp_tool_definition": {
    "name": "calculate_credit_risk_rating",
    "description": "Derives an internal credit rating (AAA–D) from six financial ratios using a weighted scoring model calibrated by sector and counterparty type. Maps to S&P, Moody's, and Fitch equivalents. Use when a credit agent needs to establish a counterparty rating before computing PD, RWA, or RAROC.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "counterparty_type": { "type": "string", "enum": ["corporate","bank","sovereign","sme"] },
        "sector": { "type": "string" },
        "weighting_profile": { "type": "string", "enum": ["balanced","leverage","coverage","liquidity"] },
        "net_debt_ebitda": { "type": "number" },
        "ebitda_interest": { "type": "number" },
        "ebitda_margin": { "type": "number" },
        "fcf_debt": { "type": "number" },
        "current_ratio": { "type": "number" },
        "debt_equity": { "type": "number" }
      },
      "required": ["counterparty_type","sector","weighting_profile","net_debt_ebitda","ebitda_interest","ebitda_margin","fcf_debt","current_ratio","debt_equity"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/197-credit-risk-rating-calculator.html",
    "function_name": "runRating",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
