{
  "tool_id": "pci-dss-v4-scope-wizard",
  "version": "1.0.0",
  "title": "PCI DSS v4.0 Scope Assessment Wizard",
  "description": "Step-by-step PCI DSS v4.0 scope assessment covering organisation type, payment channels, cardholder data environment, and architecture. Determines applicable SAQ form (A through D-SP), 12-requirement applicability table, and produces a compliance roadmap Markdown memo and AP2 JSON mandate.",
  "category": "cat-19",
  "tags": [
    "PCI DSS",
    "v4.0",
    "SAQ",
    "CDE",
    "scope",
    "compliance",
    "audit",
    "AP2"
  ],
  "audience": [
    "compliance",
    "security engineer",
    "QSA",
    "merchant",
    "acquirer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "org_type": {
        "type": "string"
      },
      "channels": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "card_data_stored": {
        "type": "boolean"
      },
      "network_segmentation": {
        "type": "string"
      },
      "service_provider_used": {
        "type": "boolean"
      }
    },
    "required": [
      "org_type",
      "channels"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "saq_determination": {
        "type": "string"
      },
      "applicable_requirements": {
        "type": "array"
      },
      "compliance_gaps": {
        "type": "array"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "assess_pci_dss_scope",
    "description": "Runs a PCI DSS v4.0 scope assessment wizard for merchants and service providers. Determines applicable SAQ form, CDE boundary, and 12-requirement applicability. Use when an agent needs to assess PCI DSS scope, determine SAQ type, or generate a compliance mandate for a payment card data environment.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "org_type": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "card_data_stored": {
          "type": "boolean"
        }
      },
      "required": [
        "org_type",
        "channels"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/226-pci-dss-v4-scope-wizard.html",
    "function_name": "runAssessment",
    "timeout_ms": 5000
  },
  "ap2_export": true
}