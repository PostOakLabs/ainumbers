    {
      "name": "convergent-parallel-paths-edges-b-first",
      "_derivation": "A is listed. Two ownership paths reach B: direct A->B 20%, and indirect A->C->B 80% x 40% = 32%. Aggregate at B = 20 + 32 = 52%, which is at or above the 50% threshold, so B is constructively blocked; D is wholly owned by B and inherits the same 52%. Expected values are derived from that arithmetic, not captured from a kernel run. This vector and the next differ ONLY in the order of edges[] and must produce identical output.",
      "policy_parameters": {
        "ownership_graph": {
          "nodes": [
            {
              "id": "A",
              "listed": true,
              "list_source": "ofac"
            },
            {
              "id": "B"
            },
            {
              "id": "C"
            },
            {
              "id": "D"
            }
          ],
          "edges": [
            {
              "from": "A",
              "to": "B",
              "pct": 20
            },
            {
              "from": "A",
              "to": "C",
              "pct": 80
            },
            {
              "from": "C",
              "to": "B",
              "pct": 40
            },
            {
              "from": "B",
              "to": "D",
              "pct": 100
            }
          ]
        }
      },
      "output_payload": {
        "entity_verdicts": [
          {
            "id": "A",
            "aggregate_pct": 100,
            "ofac_pct": 100,
            "eu_pct": 0,
