    {
      "name": "cyclic-cross-holding-bounded",
      "_derivation": "S is listed and owns 50% of X; X and Y wholly own each other, a circular cross-holding. The contribution series is 50% + 50% + ... , which the 100% ownership ceiling caps: X and Y both settle at 100%. The vector exists to pin termination and the ceiling on a cyclic graph, where a re-propagating traversal without a bound would not halt.",
      "policy_parameters": {
        "ownership_graph": {
          "nodes": [
            {
              "id": "S",
              "listed": true,
              "list_source": "ofac"
            },
            {
              "id": "X"
            },
            {
              "id": "Y"
            }
          ],
          "edges": [
            {
              "from": "S",
              "to": "X",
              "pct": 50
            },
            {
              "from": "X",
              "to": "Y",
              "pct": 100
            },
            {
              "from": "Y",
              "to": "X",
              "pct": 100
            }
          ]
