{
  "tool_id": "art-124-content-credential-signature-verifier",
  "note": "art-124 policy core over a caller-attested signature result. Since v1.1.0 the kernel takes `signature_verified` as a REQUIRED attested input and never re-verifies, so the vectors pin the policy outcome for each attestation; the raw key/signature material is the caller's own and is no longer part of the tool's declared inputs (the deterministic Ed25519 test keypair retired with the in-kernel verify in v1.1.0). Since v1.2.0 the revocation attestation is an allowlist: only the exact string 'good' accepts, and 'revoked', 'unknown', a case variant, an empty or junk string refuses with REVOCATION_STATUS_NOT_GOOD; cert_not_expired must be the boolean true. golden_hash pinned (see vectors).",
  "vectors": [
    {
      "name": "accept-valid-signature-trusted-chain",
      "policy_parameters": {
        "alg": "Ed25519",
        "signature_verified": true,
        "trust_anchor_match": true,
        "cert_not_expired": true,
        "revocation_status": "good"
      },
      "output_payload": {
        "signature_verified": true,
        "signature_verification": "caller_attested",
        "caveats": [
          "signature verification is caller-attested"
        ],
        "chain_trusted": true,
        "alg": "Ed25519",
        "alg_allowed": true,
        "verdict": "ACCEPT"
      },
      "golden_hash": "7f9cafeeb6344e469b3d71f76694bce19a349a84f6e028ef4f244abdfa312c26"
    },
    {
      "name": "refuse-revoked-cert",
