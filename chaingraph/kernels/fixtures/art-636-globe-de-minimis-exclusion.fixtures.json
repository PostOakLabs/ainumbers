    {
      "name": "revenue-average-exactly-at-threshold-fails-strict-inequality",
      "note": "Art 5.5.1(a) requires the Average GloBE Revenue to be LESS THAN EUR 10 million. Boundary forced exactly at the threshold; the plus/minus 1 ULP neighbours of the same point are exercised by the property floor rather than by a fixture.",
      "independent_oracle": {
        "source": "OECD GloBE Model Rules (Pillar Two), December 2021, Art 5.5.1(a); Commentary para 81",
        "source_digest": "sha256:796d1a16fad360204a76450f5246e038263ef4bc652356f25d367d4b9389e306",
        "derivation": "Revenue years 30,000,000 / 0 / 0 average to exactly 10,000,000, which is not LESS THAN the EUR 10 million threshold, so the revenue condition fails. Income average is 0, which meets its condition. The conditions being cumulative, the exclusion is unavailable.",
        "expect": {
          "average_globe_revenue_eur": 10000000,
          "average_globe_income_eur": 0,
          "revenue_test_met": false,
          "income_test_met": true,
          "de_minimis_available": false,
          "deemed_zero_topup": false,
