{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ainumbers.co/chaingraph/errata/kernel-erratum.schema.json",
  "title": "Kernel erratum entry",
  "description": "One append-only record that a compute module was fixed in place: the affected and fixed digests, one plain sentence, and a pure predicate over policy_parameters that is true when a receipt's inputs fall in the region the fix changed. The witness pairs one affected and one unaffected input vector with the policy_parameters hash and the old and new execution hashes. Existing log entries are keyed by spec_digest and are implicitly kind spec; this schema is kind kernel.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "node_id", "tool_id", "kernel_digest_affected", "kernel_digest_fixed", "kernel_source", "class", "summary", "affected_predicate", "witness", "published_at"],
  "properties": {
    "kind": { "enum": ["kernel"] },
    "id": { "type": "string", "pattern": "^KE-[0-9]{4}-[0-9]{4}$" },
    "node_id": { "type": "string", "pattern": "^art-[0-9]+$" },
    "tool_id": { "type": "string", "pattern": "^art-[0-9]+-[a-z0-9-]+$" },
    "kernel_digest_affected": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "kernel_digest_fixed": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kernel_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_ref", "new_ref"],
      "properties": {
        "old_ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "new_ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "class": { "enum": ["fail-open-missing-input", "fail-open-wrong-type", "wrong-threshold", "missed-clause-branch", "arithmetic", "nondeterminism", "other"] },
    "summary": { "type": "string", "minLength": 10, "maxLength": 300 },
    "corrects": { "type": "string", "pattern": "^KE-[0-9]{4}-[0-9]{4}$" },
    "affected_predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^chaingraph/errata/predicates/KE-[0-9]{4}-[0-9]{4}\\.mjs$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected", "unaffected"],
      "properties": {
        "affected": { "$ref": "#/$defs/vector" },
        "unaffected": { "$ref": "#/$defs/vector" }
      }
    },
    "published_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_parameters", "policy_parameters_hash", "old_execution_hash", "new_execution_hash"],
      "properties": {
        "policy_parameters": { "type": "object" },
        "policy_parameters_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "old_execution_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "new_execution_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
