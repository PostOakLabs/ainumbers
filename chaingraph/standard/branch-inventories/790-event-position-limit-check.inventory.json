    },
    {
      "digest": "sha256:8236a6c92be19ba029be6371c196036ea66a016c4dfd1bfcae97a8a22cab68c5",
      "clause_path": "Kalshi DCM Rulebook v1.29 Rule 4.5 (p.41) -- market maker accountability levels 10x where quoting obligations apply; no position limits on program contracts; CFTC limits always apply"
    },
    {
      "digest": "sha256:e1d424254f7e6ed5f1d8326c6f4181c2d039ee0ef75f91f45e4df6c563b9c09b",
