{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Common Paper AI Addendum v1.0, Cover Page Key Terms",
  "description": "Cover-page variables only. Party identity, signatures, and notice addresses are intentionally EXCLUDED (zero-PII, CONTRACT.md §0) and remain literal placeholder tokens in the assembled output.",
  "type": "object",
  "required": ["train_on_customer_data", "model_improvement", "retention_window", "output_ownership", "subprocessor_ai", "effective_date"],
  "properties": {
    "train_on_customer_data": { "type": "boolean" },
    "training_data": { "type": "string" },
    "training_purposes": { "type": "string" },
    "training_restrictions": { "type": "string" },
    "model_improvement": { "type": "boolean" },
    "improvement_restrictions": { "type": "string" },
    "retention_window": { "type": "string", "minLength": 1 },
    "output_ownership": { "type": "string", "minLength": 1 },
    "subprocessor_ai": { "type": "string", "minLength": 1 },
    "effective_date": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
