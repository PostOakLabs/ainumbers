{
  "@context": {
    "@vocab":  "https://openchain.graph/spec/v0.3#",
    "prov":    "http://www.w3.org/ns/prov#",
    "dcat":    "http://www.w3.org/ns/dcat#",
    "schema":  "https://schema.org/",
    "xsd":     "http://www.w3.org/2001/XMLSchema#",

    "__note": "OpenChainGraph v0.3 JSON-LD context. Supersedes v0.2 (https://openchain.graph/spec/v0.2/context.jsonld) additively — all v0.2 PROV-DM mappings are preserved unchanged. v0.3 adds optional party-identity terms (LEI, keyid/did:key) and references the ISO 20022 semantic-profile overlay. Artifacts may list multiple contexts: [ this, '.../v0.3/iso20022-context.jsonld' ].",

    "tool_id":          { "@id": "prov:wasAttributedTo" },
    "policy_parameters":{ "@id": "prov:used" },
    "output_payload":   { "@id": "prov:wasGeneratedBy" },
    "parent_hashes":    { "@id": "prov:wasDerivedFrom", "@container": "@list" },
    "execution_hash":   { "@id": "prov:hadPrimarySource" },
    "mandate_type":     { "@id": "schema:additionalType" },
    "chain_depth":      { "@id": "schema:position", "@type": "xsd:integer" },

    "publisher":        { "@id": "dcat:publisher" },
    "lei":              { "@id": "schema:leiCode", "@type": "xsd:string" },
    "keyid":            { "@id": "schema:identifier", "@type": "xsd:string" },
    "semantic_profile": { "@id": "schema:additionalType", "@type": "xsd:string" }
  }
}
