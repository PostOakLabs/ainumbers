{
  "tool_id": "art-778-token2022-withheld-fee-reconciler",
  "version": "1.0.0",
  "title": "Token-2022 Withheld-Fee Reconciler",
  "description": "Token-2022 withheld-fee reconciliation across token accounts. Paste the mint's declared TransferFeeConfig fields (accumulated withheld_amount and withdraw_withheld_authority), a list of token accounts each carrying its withheld amount, the caller's declared total, and optionally a harvest or withdraw destination. The node recomputes the per-account withheld sum over mint-matching accounts, reconciles it against the declared total with the signed difference, projects the mint's post-harvest accumulation under the program's checked_add semantics (Overflow past u64 reported as a fact, never wrapped), flags wrong-mint accounts and duplicate addresses, and checks fee-receiver placement: the declared destination's mint against the declared mint, and the declared withdraw authority against the config's. Values only, facts only, nothing on-chain is read.",
  "category": "chaingraph",
  "tags": [
    "token2022",
    "solana",
    "withheld-fees",
    "transfer-fee",
    "payment-reconciliation",
    "harvest",
    "bigint",
    "mcp:reconcile_token2022_withheld"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "mint",
      "transfer_fee_config",
      "accounts",
      "declared_total"
    ],
    "properties": {
      "mint": {
        "type": "string",
        "description": "The declared mint address, pasted. Every account's mint is compared to this by string equality."
      },
      "transfer_fee_config": {
        "type": "object",
        "description": "The mint's TransferFeeConfig fields: withdraw_withheld_authority (string or null) and withheld_amount (u64 decimal string), the accumulated pot.",
        "properties": {
          "withdraw_withheld_authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "withheld_amount": {
            "type": "string"
          }
        },
        "required": [
          "withdraw_withheld_authority",
          "withheld_amount"
        ]
      },
      "accounts": {
        "type": "array",
        "description": "Token accounts, each { address, mint, withheld_amount } with withheld_amount a u64 decimal string. Empty array is valid (sum 0).",
        "items": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "mint": {
              "type": "string"
            },
            "withheld_amount": {
              "type": "string"
            }
          },
          "required": [
            "address",
            "mint",
            "withheld_amount"
          ]
        }
      },
      "declared_total": {
        "type": "string",
        "description": "The caller's declared sum of withheld fees, decimal string (u64), reconciled against the recomputed sum."
      },
      "destination": {
        "type": "object",
        "description": "Optional destination { address, mint, withdraw_authority }, compared with the declared mint and the config's withdraw authority.",
        "properties": {
          "address": {
            "type": "string"
          },
          "mint": {
            "type": "string"
          },
          "withdraw_authority": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "mint",
          "withdraw_authority"
        ]
      }
    }
  },
