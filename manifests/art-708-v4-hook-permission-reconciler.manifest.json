{
  "tool_id": "art-708-v4-hook-permission-reconciler",
  "version": "1.0.0",
  "title": "V4 Hook Permission Reconciler",
  "description": "Decodes a Uniswap v4 hook address's 14 permission bits against a caller-declared callback set, replicates v4-core's isValidHookAddress rule (including the dynamic-fee escape), and reconciles a hooklist dynamicFee declaration with the pool fee.",
  "category": "chaingraph",
  "tags": [
    "uniswap",
    "v4-core",
    "hooks",
    "permission-bits",
    "bitmap-decode",
    "callback-declaration",
    "hooklist",
    "dynamic-fee",
    "compliance-evidence",
    "mcp:reconcile_v4_hook_permissions"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "hook_address",
      "declared_permissions"
    ],
    "properties": {
      "hook_address": {
        "type": "string",
        "description": "0x-prefixed 40-hex-digit Uniswap v4 hook address; checksum not required, normalised to lowercase. Its low 14 bits are the permission bitmap."
      },
      "declared_permissions": {
        "type": "object",
        "description": "All 14 callback booleans, required, never defaulted; a missing key is refused. A Uniswap hooklist entry { hook, flags, properties } also accepted.",
        "properties": {
          "beforeInitialize": {
            "type": "boolean"
          },
          "afterInitialize": {
            "type": "boolean"
          },
          "beforeAddLiquidity": {
            "type": "boolean"
          },
          "afterAddLiquidity": {
            "type": "boolean"
          },
          "beforeRemoveLiquidity": {
            "type": "boolean"
          },
          "afterRemoveLiquidity": {
            "type": "boolean"
          },
          "beforeSwap": {
            "type": "boolean"
          },
          "afterSwap": {
            "type": "boolean"
          },
          "beforeDonate": {
            "type": "boolean"
          },
          "afterDonate": {
            "type": "boolean"
          },
          "beforeSwapReturnDelta": {
            "type": "boolean"
          },
          "afterSwapReturnDelta": {
            "type": "boolean"
          },
          "afterAddLiquidityReturnDelta": {
            "type": "boolean"
          },
          "afterRemoveLiquidityReturnDelta": {
            "type": "boolean"
          }
        }
      },
      "pool_fee": {
        "type": "integer",
        "description": "Optional uint24 pool fee; the fee is dynamic iff pool_fee & 0x800000 (8388608)."
      },
      "declaration_source": {
        "type": "string",
        "description": "Optional free text naming where the declaration comes from, e.g. a registry entry or notice item; emitted unchanged in the output."
      }
    }
  },
