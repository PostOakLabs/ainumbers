{
  "tool_id": "472-pillar-3-disclosure-builder",
  "version": "1.0.0",
  "title": "Pillar 3 Disclosure Builder",
  "description": "Assemble Basel III Pillar 3 disclosure tables per BCBS 309 (March 2017) and BCBS 400 (December 2018). Generates KM1 (key metrics), OV1 (overview of RWAs by risk type), LIQ1 (LCR detail), and LIQ2 (NSFR detail). Consumes outputs from T201 (RWA), T469 (LCR), T470 (NSFR), T471 (leverage ratio). Verify row definitions against EBA ITS (EU) or PRA rules (UK). Tier 1 Policy Mandate JSON + Markdown. Client-side. Works offline. Zero PII.",
  "category": "treasury-strategy",
  "tags": ["pillar-3","bcbs-309","bcbs-400","km1","ov1","liq1","liq2","disclosure","regulatory-reporting","capital","liquidity"],
  "audience": ["risk","treasury","compliance","ir","legal"],
  "input_schema": {
    "type": "object",
    "properties": {
      "bank_name": {"type":"string","description":"Synthetic institution name"},
      "period": {"type":"string","description":"Reporting period (e.g. Q1 2026)"},
      "cet1_ratio": {"type":"number","description":"CET1 ratio % (from T201)"},
      "t1_ratio": {"type":"number","description":"Tier 1 capital ratio %"},
      "tc_ratio": {"type":"number","description":"Total capital ratio %"},
      "rwa": {"type":"number","description":"Total RWA (m, from T201)"},
      "lr_pct": {"type":"number","description":"Leverage ratio % (from T471)"},
      "lcr_pct": {"type":"number","description":"LCR % (from T469)"},
      "nsfr_pct": {"type":"number","description":"NSFR % (from T470)"},
      "t1_cap": {"type":"number","description":"Tier 1 capital (m)"},
      "cet1_cap": {"type":"number","description":"CET1 capital (m)"},
      "tc_cap": {"type":"number","description":"Total capital (m)"},
      "total_exp": {"type":"number","description":"Total exposure measure (m, from T471)"},
      "cr_rwa": {"type":"number","description":"Credit risk RWA (m)"},
      "mr_rwa": {"type":"number","description":"Market risk RWA (m)"},
      "or_rwa": {"type":"number","description":"Operational risk RWA (m)"},
      "hqla_m": {"type":"number","description":"HQLA after haircut (m, from T469)"},
      "gross_out": {"type":"number","description":"Gross outflows (m, from T469)"},
      "net_inf": {"type":"number","description":"Net inflows capped (m, from T469)"},
      "nco": {"type":"number","description":"NCO (m, from T469)"},
      "asf_m": {"type":"number","description":"ASF (m, from T470)"},
      "rsf_m": {"type":"number","description":"RSF (m, from T470)"},
      "nsfr_surp": {"type":"number","description":"NSFR surplus (m)"}
    },
    "required": ["cet1_ratio","t1_ratio","tc_ratio","rwa","lcr_pct","nsfr_pct","lr_pct"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "km1": {"type":"object","description":"KM1 key metrics table"},
      "ov1": {"type":"object","description":"OV1 RWA overview table"},
      "liq1": {"type":"object","description":"LIQ1 LCR detail table"},
      "liq2": {"type":"object","description":"LIQ2 NSFR detail table"}
    }
  },
  "mcp_tool_definition": {
    "name": "pillar_3_disclosure_builder",
    "description": "Assemble Basel III Pillar 3 disclosure tables (KM1, OV1, LIQ1, LIQ2) per BCBS 309/400. Consumes inputs from T201 (RWA), T469 (LCR), T470 (NSFR), T471 (leverage ratio). Final step in the bank-capital-liquidity composer chain. Verify row definitions against EBA ITS (EU) or PRA rules (UK) before use in actual disclosures. Synthetic data only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "bank_name": {"type":"string"},
        "period": {"type":"string"},
        "cet1_ratio": {"type":"number","description":"CET1 ratio %"},
        "t1_ratio": {"type":"number"},
        "tc_ratio": {"type":"number"},
        "rwa": {"type":"number","description":"Total RWA (m)"},
        "lr_pct": {"type":"number","description":"Leverage ratio %"},
        "lcr_pct": {"type":"number","description":"LCR %"},
        "nsfr_pct": {"type":"number","description":"NSFR %"},
        "cr_rwa": {"type":"number"},
        "mr_rwa": {"type":"number"},
        "or_rwa": {"type":"number"},
        "hqla_m": {"type":"number"},
        "gross_out": {"type":"number"},
        "net_inf": {"type":"number"},
        "nco": {"type":"number"},
        "asf_m": {"type":"number"},
        "rsf_m": {"type":"number"}
      },
      "required": ["cet1_ratio","t1_ratio","tc_ratio","rwa","lcr_pct","nsfr_pct","lr_pct"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/472-pillar-3-disclosure-builder.html",
    "function_name": "buildP3",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0",
  "intake": true
}
