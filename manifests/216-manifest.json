{
  "tool_id": "corridor-cost-ranker",
  "version": "1.0.0",
  "title": "Cross-Border B2B Corridor Cost Ranker",
  "description": "Ranks cross-border B2B corridors by total all-in cost: FX margin + correspondent fee + SWIFT message fee + lifting and beneficiary charges. Compares bank wire vs fintech aggregator vs stablecoin. G20/FSB 1% target flag. Outputs AP2 JSON routing policy. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "corridor",
    "cost ranking",
    "FX margin",
    "correspondent fee",
    "B2B",
    "G20",
    "routing",
    "AP2"
  ],
  "audience": [
    "payments-engineer",
    "treasury",
    "operations"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "corridor": {
        "type": "string"
      },
      "amount_usd": {
        "type": "number"
      },
      "payment_method": {
        "type": "string",
        "enum": [
          "all",
          "bank",
          "fintech"
        ]
      },
      "monthly_volume": {
        "type": "integer"
      }
    },
    "required": [
      "corridor",
      "amount_usd"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "recommended_method": {
        "type": "object"
      },
      "all_methods": {
        "type": "array"
      },
      "monthly_saving": {
        "type": "number"
      },
      "g20_compliant": {
        "type": "boolean"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "rank_corridor_costs",
    "description": "Ranks cross-border B2B payment methods by total all-in cost for a given corridor and amount. Compares bank wire, fintech aggregator, and stablecoin. Outputs AP2 JSON routing policy with G20 target compliance flag.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "corridor": {
          "type": "string"
        },
        "amount_usd": {
          "type": "number"
        },
        "monthly_volume": {
          "type": "integer"
        }
      },
      "required": [
        "corridor",
        "amount_usd"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/216-corridor-cost-ranker.html",
    "function_name": "runRanker",
    "timeout_ms": 5000
  },
  "ap2_export": true
}