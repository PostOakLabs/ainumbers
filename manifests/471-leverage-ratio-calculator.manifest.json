{
  "tool_id": "471-leverage-ratio-calculator",
  "version": "1.0.0",
  "title": "Leverage Ratio Calculator",
  "description": "Basel III leverage ratio per BCBS 270 (January 2014) as revised by BCBS 360 (December 2017). Leverage Ratio = Tier 1 Capital ÷ Total Exposure Measure ≥ 3% (G-SIB leverage buffer up to 1.75% additional). Covers on-balance-sheet, derivative (SA-CCR), SFT, and off-balance-sheet exposures. Feeds Pillar 3 KM1 (T472). Tier 1 Policy Mandate JSON + Markdown. Client-side. Works offline. Zero PII.",
  "category": "treasury-strategy",
  "tags": ["leverage-ratio","tier-1","bcbs-270","bcbs-360","basel-iii","pillar-3","km1","g-sib","capital","regulatory"],
  "audience": ["risk","treasury","compliance","capital"],
  "input_schema": {
    "type": "object",
    "properties": {
      "cet1": {"type":"number","description":"Common Equity Tier 1 capital (m)"},
      "at1": {"type":"number","description":"Additional Tier 1 capital (m)"},
      "gsib_bucket": {"type":"number","enum":[0,1,1.5,2,2.5,3.5],"description":"G-SIB surcharge bucket (0 = not G-SIB)"},
      "obs_exp": {"type":"number","description":"On-balance-sheet exposures (m)"},
      "deriv_exp": {"type":"number","description":"Derivative exposures RC+PFE (m)"},
      "sft_exp": {"type":"number","description":"Securities financing transaction exposures (m)"},
      "offbs_exp": {"type":"number","description":"Off-balance-sheet items CCF-adjusted (m)"},
      "other_exp": {"type":"number","description":"Other exposure measure adjustments (m)"}
    },
    "required": ["cet1","obs_exp"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tier1_m": {"type":"number"},
      "total_exposure_m": {"type":"number"},
      "leverage_ratio_pct": {"type":"number"},
      "min_lr_pct": {"type":"number"},
      "compliant": {"type":"boolean"}
    }
  },
  "mcp_tool_definition": {
    "name": "leverage_ratio_calculator",
    "description": "Calculate the Basel III leverage ratio per BCBS 360. LR = Tier 1 / Total Exposure Measure ≥ 3% (G-SIB leverage buffer additional per §12). Total exposure = on-BS + derivative (SA-CCR RC+PFE) + SFT + OBS (CCF-adjusted). Outputs ratio, minimum threshold, compliant flag. Feeds Pillar 3 KM1 row h (T472). Verify against CRR3/EU, PRA, or Fed SLR as applicable. Synthetic data only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cet1": {"type":"number","description":"CET1 capital (m)"},
        "at1": {"type":"number","description":"Additional Tier 1 capital (m); defaults to 0"},
        "gsib_bucket": {"type":"number","enum":[0,1,1.5,2,2.5,3.5],"description":"G-SIB surcharge bucket; 0 = not G-SIB"},
        "obs_exp": {"type":"number","description":"On-balance-sheet gross exposures (m)"},
        "deriv_exp": {"type":"number","description":"Derivative exposure measure (SA-CCR RC+PFE, m)"},
        "sft_exp": {"type":"number","description":"SFT exposure measure (m)"},
        "offbs_exp": {"type":"number","description":"Off-balance-sheet CCF-adjusted exposures (m)"},
        "other_exp": {"type":"number","description":"Other adjustments (m)"}
      },
      "required": ["cet1","obs_exp"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/471-leverage-ratio-calculator.html",
    "function_name": "runLeverageRatio",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0",
  "intake": true
}
