{
  "tool_id": "correspondent-derisking-modeler",
  "version": "1.0.0",
  "title": "Correspondent Banking De-Risking Impact Modeler",
  "description": "Models operational and cost impact of correspondent banking de-risking on a payment corridor. Simulates loss of 1, 2, or all active correspondents. Outputs hop count increase, incremental cost, volume at risk, alternative routing, and corridor vulnerability score. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "de-risking",
    "correspondent banking",
    "BIS CPMI",
    "G20",
    "corridor vulnerability"
  ],
  "audience": [
    "compliance",
    "operations",
    "payments-engineer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "corridor": {
        "type": "string"
      },
      "correspondent_count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "monthly_volume_usd_m": {
        "type": "number"
      },
      "payment_type": {
        "type": "string",
        "enum": [
          "remittance",
          "b2b",
          "ngo"
        ]
      }
    },
    "required": [
      "corridor",
      "correspondent_count",
      "monthly_volume_usd_m"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "scenarios": {
        "type": "array"
      },
      "mitigation_options": {
        "type": "array"
      },
      "corridor_vulnerability": {
        "type": "string"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "model_correspondent_derisking",
    "description": "Models the operational and cost impact of losing correspondent banking relationships on a payment corridor. Use when assessing de-risking exposure or planning contingency routing.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "corridor": {
          "type": "string"
        },
        "correspondent_count": {
          "type": "integer"
        },
        "monthly_volume_usd_m": {
          "type": "number"
        }
      },
      "required": [
        "corridor",
        "correspondent_count",
        "monthly_volume_usd_m"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/220-correspondent-derisking-modeler.html",
    "function_name": "runDerisk",
    "timeout_ms": 5000
  },
  "ap2_export": false
}