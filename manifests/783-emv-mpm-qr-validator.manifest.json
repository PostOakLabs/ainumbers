{
  "tool_id": "783-emv-mpm-qr-validator",
  "version": "1.0.0",
  "title": "EMV MPM QR Payload Validator",
  "description": "Decodes and validates an EMV merchant-presented QR payload against a pluggable national scheme profile: generic EMV MPM, Fiji FJQR, or Brazil Pix BR Code. TLV structure, CRC-16 over the payload including the 6304 literal, static versus dynamic rules, scheme-mandatory tags, and the signed dynamic-payload envelope shape. Merchant-bearing values are never echoed; no URL is ever fetched; no signature is verified.",
  "category": "Cross-Border Payments: CBPR+ / ISO 20022 Conformance",
  "tags": [
    "emv-qr",
    "qr-code",
    "fiji-fjqr",
    "pix-brcode",
    "crc16",
    "scheme-profile",
    "mcp:validate_emv_mpm_qr_payload"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "payload",
      "profile"
    ],
    "properties": {
      "payload": {
        "type": "string",
        "description": "The EMV merchant-presented QR payload string. Synthetic payloads only; merchant-bearing values are never echoed back."
      },
      "profile": {
        "type": "string",
        "enum": [
          "generic",
          "fjqr",
          "pix_brcode"
        ],
        "description": "Scheme profile to validate against: generic EMV MPM, Fiji FJQR (currency FJD 242, static launch scope), or Brazil Pix BR Code (GUI br.gov.bcb.pix, currency BRL 986, country BR, txid mandatory, dynamic location shape and JWS envelope skeleton)."
      },
      "expect": {
        "type": "string",
        "enum": [
          "static",
          "dynamic"
        ],
        "description": "Optional assertion on the derived mode. A mismatch with the payload tag 01 value is reported as a violation."
      },
      "dynamic_envelope": {
        "type": "object",
        "description": "Optional JWS protected-header skeleton for a Pix dynamic payload: alg (prohibited HS-family and none; allowed RS256-or-higher and ES256-or-higher; recommended PS256 or PS512), typ, kid, jku. Shape check only: no signature verification, no key material, the jku URL is never fetched.",
        "properties": {
          "alg": {
            "type": "string"
          },
          "typ": {
            "type": "string"
          },
          "kid": {
            "type": "string"
          },
          "jku": {
            "type": "string",
            "description": "JWK Set URL. https shape checked only, never fetched."
          }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "validate_emv_mpm_qr_payload",
    "description": "Decodes and validates an EMV merchant-presented QR payload against a pluggable national scheme profile: generic EMV MPM, Fiji FJQR, or Brazil Pix BR Code. TLV structure, CRC-16 over the payload including the 6304 literal, static versus dynamic rules, scheme-mandatory tags, and the signed dynamic-payload envelope shape. Merchant-bearing values are never echoed; no URL is ever fetched; no signature is verified.",
    "inputSchema": {
      "type": "object",
      "required": [
        "payload",
        "profile"
      ],
      "properties": {
        "payload": {
          "type": "string",
          "description": "The EMV merchant-presented QR payload string. Synthetic payloads only; merchant-bearing values are never echoed back."
        },
        "profile": {
          "type": "string",
          "enum": [
            "generic",
            "fjqr",
            "pix_brcode"
          ],
          "description": "Scheme profile to validate against: generic EMV MPM, Fiji FJQR, or Brazil Pix BR Code."
        },
        "expect": {
          "type": "string",
