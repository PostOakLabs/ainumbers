{
  "tool_id": "nacha-ach-rule-compliance-checker",
  "version": "1.0.0",
  "title": "NACHA ACH Rule Compliance Checker",
  "description": "Check ACH programme configurations against NACHA Operating Rules §2–§9. March 2026 Fraud Monitoring rules embedded. Outputs compliance status per section, return code reference, Markdown memo, and AP2 JSON compliance mandate.",
  "category": "cat-19",
  "tags": [
    "NACHA",
    "ACH",
    "ODFI",
    "RDFI",
    "return codes",
    "fraud monitoring",
    "data security",
    "compliance",
    "AP2"
  ],
  "audience": [
    "compliance",
    "engineer",
    "payments operations",
    "BSA officer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "org_role": {
        "type": "string",
        "enum": [
          "odfi",
          "rdfi",
          "both",
          "tps",
          "tpsp"
        ]
      },
      "sec_code": {
        "type": "string",
        "enum": [
          "PPD",
          "CCD",
          "WEB",
          "TEL",
          "IAT",
          "CTX",
          "RCK",
          "POP",
          "ARC",
          "BOC",
          "CIE",
          "MTE",
          "POS",
          "TRX"
        ]
      },
      "account_type": {
        "type": "string",
        "enum": [
          "consumer",
          "corporate",
          "both"
        ]
      },
      "monthly_volume": {
        "type": "string",
        "enum": [
          "under1k",
          "1k-10k",
          "10k-100k",
          "100k-1m",
          "over1m"
        ]
      },
      "average_entry_amount": {
        "type": "number",
        "minimum": 0
      },
      "uses_same_day_ach": {
        "type": "string",
        "enum": [
          "no",
          "yes",
          "both"
        ]
      },
      "uses_third_party_sender": {
        "type": "string",
        "enum": [
          "no",
          "yes"
        ]
      },
      "web_debit_account_validation": {
        "type": "string",
        "enum": [
          "na",
          "avs",
          "micro",
          "none"
        ]
      },
      "data_security_encryption": {
        "type": "string",
        "enum": [
          "yes",
          "partial",
          "no"
        ]
      }
    },
    "required": [
      "org_role",
      "sec_code"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "overall_status": {
        "type": "string",
        "enum": [
          "compliant",
          "review_required",
          "non_compliant"
        ]
      },
      "sections_checked": {
        "type": "integer"
      },
      "compliant_count": {
        "type": "integer"
      },
      "review_required_count": {
        "type": "integer"
      },
      "non_compliant_count": {
        "type": "integer"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_nacha_ach_compliance",
    "description": "Checks an ACH programme configuration against NACHA Operating Rules §2–§9 with March 2026 Fraud Monitoring amendments. Returns compliance status per section, findings, and an AP2 JSON mandate. Use when an agent needs to assess NACHA compliance posture, validate SEC code configurations, or generate a compliance mandate for an ACH origination programme.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "org_role": {
          "type": "string"
        },
        "sec_code": {
          "type": "string"
        },
        "monthly_volume": {
          "type": "string"
        },
        "uses_same_day_ach": {
          "type": "string"
        },
        "data_security_encryption": {
          "type": "string"
        }
      },
      "required": [
        "org_role",
        "sec_code"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "https://ainumbers.co/tools/224-nacha-ach-rule-compliance-checker.html",
    "function_name": "runCheck",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
