  "input_schema": {
    "type": "object",
    "required": [
      "protocol_fee",
      "pool_fee",
      "declared_lp_fee_bounds",
      "declared_hook_charge",
      "swaps"
    ],
    "properties": {
      "protocol_fee": {
        "type": "integer",
        "description": "uint24, both directions packed as v4 stores it: low 12 bits zeroForOne, bits 12-23 oneForZero; validated with isValidProtocolFee (each direction <= 1000 pips)."
      },
      "pool_fee": {
        "type": "integer",
        "description": "uint24: static LP fee in pips, or 0x800000 (8388608) for a dynamic-fee pool."
      },
      "declared_lp_fee_bounds": {
        "type": "object",
        "description": "{ min_pips, max_pips }: the LP-fee band the declared story permits (0..1000000)."
      },
      "declared_total_fee_cap_pips": {
        "type": "integer",
        "description": "Optional total cap in pips; the composed swap fee plus the hook-charge rate is checked against it."
      },
      "declared_hook_charge": {
        "type": "object",
        "description": "{ rate_pips, splits: [{ recipient_label, share_bps }] }: the separately declared hook charge; shares are reported as declared, never coerced."
      },
      "swaps": {
        "type": "array",
        "description": "Each swap: { index, zero_for_one, amount_in, emitted_fee_pips, lp_fee_override? (raw uint24 incl. the 0x400000 flag), exact_out? }."
      }
    }
  },
