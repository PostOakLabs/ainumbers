{
  "tool_id": "305-dora-third-party-contract-checker",
  "version": "1.0.0",
  "title": "ICT Third-Party Contract Clause Checker",
  "description": "Validate ICT service agreements against DORA Art. 30 mandatory requirements. Missing clause list, model clause stubs, Policy Mandate JSON. Client-side. Zero PII.",
  "category": "dora-operational-resilience",
  "tags": [],
  "audience": [
    "payments",
    "compliance",
    "finance",
    "engineer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "contractType305": {
        "type": "string",
        "description": "Contract type (ict-service/cloud/outsourcing/sub-outsourcing)"
      },
      "cifTier305": {
        "type": "string",
        "description": "CIF tier of service (critical/important/standard)"
      },
      "ctppFlag305": {
        "type": "string",
        "description": "Provider is designated CTPP (true/false)"
      }
    },
    "additionalProperties": {
      "type": "string",
      "description": "Clause compliance flag (compliant/missing/partial)"
    },
    "required": [
      "contractType305",
      "cifTier305"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "complianceScore": {
        "type": "number"
      },
      "missingClauses": {
        "type": "array"
      },
      "mandatoryAdditions": {
        "type": "array"
      },
      "mandateJson": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "dora_third_party_contract_checker",
