{
  "tool_id": "art-855-murabahah-tawarruq-sequence",
  "version": "1.0.0",
  "title": "Murabahah and Tawarruq Sequence Check",
  "description": "Checks the order of steps and the rules of a murabahah or tawarruq structure against the Bank Negara Malaysia policy documents: eleven fixed checks, each pass, fail or not applicable with its paragraph, order_ok and rules_ok kept separate, and the first failing step. Bank Negara Malaysia profile only; other authorities are not assessed. Not a Shariah ruling.",
  "category": "chaingraph",
  "tags": [
    "islamic-finance",
    "murabahah",
    "tawarruq",
    "sequence-check",
    "mcp:check_murabahah_tawarruq_seq"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "structure": {
        "type": "string",
        "description": "Exactly one of murabahah or tawarruq."
      },
      "steps": {
        "type": "array",
        "description": "One to 64 step records, each with step (ifi_acquires_asset, wad_executed, agent_purchases_asset, sale_contract, possession_transfer, wakalah_contract, onsale_contract, payment_to_seller; each at most once), t (non-negative integer ordinal), evidence_present (boolean) and optional boolean flags agent_role, delivery_restricted, onsale_obligation, promise_to_sell_third_party, promise_to_sell_original_seller, payment_before_contract, embedded_in_sale_contract. Any other field is refused."
      },
      "authority_profile": {
        "type": "string",
        "description": "Optional. Only BNM is pinned; any other value is refused as AUTHORITY_NOT_PINNED."
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_murabahah_tawarruq_seq",
    "description": "Checks the order of steps and the rules of a murabahah or tawarruq structure against the Bank Negara Malaysia policy documents: eleven fixed checks, each pass, fail or not applicable with its paragraph, order_ok and rules_ok kept separate, and the first failing step. Bank Negara Malaysia profile only; other authorities are not assessed. Not a Shariah ruling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "structure": {
          "type": "string",
          "description": "Exactly one of murabahah or tawarruq."
        },
        "steps": {
          "type": "array",
          "description": "One to 64 step records: step name, ordinal t, evidence_present and optional boolean flags."
        },
        "authority_profile": {
          "type": "string",
          "description": "Optional. Only BNM is pinned; any other value is refused."
        }
      }
    }
  },
  "execution": {
