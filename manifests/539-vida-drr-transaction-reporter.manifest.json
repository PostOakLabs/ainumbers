{
  "tool_id": "art-160-vida-drr-transaction-reporter",
  "version": "1.0.0",
  "title": "ViDA DRR Transaction Reporter",
  "description": "Assess whether a B2B transaction falls under ViDA Digital Reporting Requirements (DRR): check intra-EU cross-border B2B scope, calculate 10-day reporting deadline from invoice date, and verify data-element completeness (seller/buyer VAT IDs, transaction value). Returns drr_in_scope, reporting_deadline, and data_elements_ok. Middle node of the vida-digital-reporting-requirements chain. Zero network, zero PII.",
  "category": "chaingraph",
  "tags": ["ViDA", "DRR", "digital reporting requirements", "intra-EU", "B2B", "VAT", "chaingraph", "reporting deadline", "compliance"],
  "audience": ["VAT Manager", "CFO", "ERP Developer", "Tax Counsel", "Finance Controller"],
  "input_schema": {
    "type": "object",
    "properties": {
      "transaction": {
        "type": "object",
        "properties": {
          "supply_type": {"type": "string", "description": "B2B or B2C"},
          "seller_member_state": {"type": "string", "description": "ISO 3166-1 alpha-2 EU member state"},
          "buyer_member_state": {"type": "string", "description": "ISO 3166-1 alpha-2 EU member state"},
          "seller_vat_id": {"type": "string"},
          "buyer_vat_id": {"type": "string"},
          "invoice_date": {"type": "string", "description": "YYYY-MM-DD"},
          "transaction_value": {"type": "number"}
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "drr_in_scope": {"type": "boolean"},
      "intra_eu": {"type": "boolean"},
      "is_b2b": {"type": "boolean"},
      "seller_member_state": {"type": ["string", "null"]},
      "buyer_member_state": {"type": ["string", "null"]},
      "reporting_deadline": {"type": ["string", "null"]},
      "mandatory_from": {"type": "string"},
      "transaction_value": {"type": "number"},
      "data_elements_ok": {"type": "boolean"}
    }
  },
  "mcp_tool_definition": {
    "name": "assess_vida_drr_reporting_obligation",
    "description": "Assess whether a B2B transaction falls under ViDA Digital Reporting Requirements (DRR): check intra-EU cross-border B2B scope, calculate 10-day reporting deadline from invoice date, and verify data-element completeness (seller/buyer VAT IDs, transaction value). Returns drr_in_scope, reporting_deadline, and data_elements_ok. Zero network, zero PII.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "transaction": {
          "type": "object",
          "properties": {
            "supply_type": {"type": "string"},
            "seller_member_state": {"type": "string"},
            "buyer_member_state": {"type": "string"},
            "seller_vat_id": {"type": "string"},
            "buyer_vat_id": {"type": "string"},
            "invoice_date": {"type": "string"},
            "transaction_value": {"type": "number"}
          }
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-160-vida-drr-transaction-reporter.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
