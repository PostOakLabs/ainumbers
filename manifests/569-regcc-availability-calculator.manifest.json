      "deposit_type"
    ],
    "properties": {
      "availability_date": { "type": "string" },
      "business_days_added": { "type": "integer" },
      "deposit_type": { "type": "string" },
      "skipped_dates": { "type": "array", "items": { "type": "string" } },
