    "deposit-operations",
    "retail-banking"
  ],
  "input_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "deposit_date",
      "deposit_type"
    ],
    "properties": {
      "deposit_date": { "type": "string", "description": "Business day of deposit, YYYY-MM-DD" },
      "deposit_type": {
        "type": "string",
        "enum": ["cash_electronic", "local_check", "nonlocal_check", "new_account", "large_deposit_excess", "case_by_case", "emergency_condition"]
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
