        "type": "object",
        "description": "OCG check receipt (policy_parameters, output_payload, execution_hash)"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "calculate_regcc_availability",
    "description": "Look up frozen-to-2030 Regulation CC (12 CFR 229) dollar thresholds and compute a funds-availability date from a deposit date and deposit type using configurable business-day counts. Not a substitute for the current Federal Register notice or 12 CFR 229 Subpart B.",
    "inputSchema": {
      "type": "object",
      "required": [
