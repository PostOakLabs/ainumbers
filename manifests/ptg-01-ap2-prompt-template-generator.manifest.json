  "mcp_tool_definition": {
    "name": "compose_ap2_prompt",
    "description": "Transforms a OpenChainGraph artifact JSON into a structured, regulator-framed prompt for an external LLM. Returns prompt text and Claude.ai deep link. No inference performed — pure template composition.",
    "inputSchema": {
      "type": "object",
      "required": [
        "task",
        "audience"
      ],
      "properties": {
        "artifact_json": {
          "type": "string",
          "description": "OpenChainGraph artifact JSON from any suite tool"
        },
        "task": {
          "type": "string",
          "enum": [
            "board_memo",
            "regulatory_submission",
            "risk_memo",
            "remediation_plan",
            "plain_english_summary",
            "period_comparison",
            "top_3_risks"
          ],
          "description": "Output task type"
        },
        "audience": {
          "type": "string",
          "enum": [
            "board",
            "risk_committee",
            "regulator",
            "quant",
            "ops"
          ],
          "description": "Target audience for the generated prompt"
        },
        "tone": {
          "type": "string",
          "enum": [
            "formal",
            "technical",
            "plain"
          ],
          "default": "formal"
        },
        "include_citations": {
          "type": "boolean",
          "default": true
        }
