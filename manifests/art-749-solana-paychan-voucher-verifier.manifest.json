{
  "tool_id": "art-749-solana-paychan-voucher-verifier",
  "version": "1.0.0",
  "title": "Solana Paychan Voucher Verifier",
  "description": "Values-only check of a Solana payment-channels voucher message against trusted channel terms. The voucher is the 50-byte Ed25519-signed message the payment-channels program reads through the Instructions sysvar: magic bytes 0x56 0x01, a 32-byte channel PDA binding, a u64 little-endian cumulative amount and an i64 little-endian expiry (0 disables). This node recomputes the program validator post-signature check sequence by pure byte inspection and trusted inputs: exact 50-byte layout, magic tag/version, channel_id equals the supplied channel PDA, cumulative amount within the escrowed deposit ceiling, cumulative amount strictly above the settled watermark (at-or-below is a stale voucher), expiry 0 or later than the supplied unix clock, an optional supersession comparison where a second voucher with a lower or equal cumulative amount is superseded by the first, and the settle delta (cumulative minus settled) reported on success. Values are pasted; every channel term is a trusted input computed in BigInt with no floats. Out of scope and stated in every output: the Ed25519 signature is NOT verified here and nothing is read from chain. Sibling of the Tempo MPP voucher verifier art-594.",
  "category": "chaingraph",
  "tags": [
    "solana",
    "payment-channels",
    "voucher",
    "payment-verification",
    "settlement",
    "watermark",
    "bigint",
    "mcp:verify_solana_payment_channel_voucher"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "voucher_hex",
      "channel_pda",
      "deposit_ceiling",
      "settled_watermark",
      "current_time"
    ],
    "properties": {
      "voucher_hex": {
        "type": "string",
        "description": "The 50-byte Ed25519-signed voucher message, hex (optional 0x prefix)."
      },
      "channel_pda": {
        "type": "string",
        "description": "The trusted channel PDA address, base58, exactly 32 bytes."
      },
      "deposit_ceiling": {
        "type": "string",
        "description": "The trusted escrowed deposit, decimal string (u64)."
      },
      "settled_watermark": {
        "type": "string",
        "description": "The trusted current settled amount, decimal string (u64)."
      },
      "current_time": {
        "type": "string",
        "description": "The trusted unix clock in seconds, decimal string (i64)."
      },
      "mint": {
        "type": "string",
        "description": "Optional trusted mint, informational passthrough."
      },
      "authorized_signer": {
        "type": "string",
        "description": "Optional claimed signer pubkey, base58. NOT verified."
      },
      "second_voucher_hex": {
        "type": "string",
        "description": "Optional second 50-byte voucher message, hex, for the supersession check."
      }
    }
  },
