{
  "version": "1.0.0",
  "tool_id": "dora-ict-risk-gap-analyser",
  "tool_number": 300,
  "category": "cat-22",
  "name": "DORA ICT Risk Gap Analyser",
  "description": "Five-pillar DORA maturity assessment. Composite score /100, pillar heatmap, remediation priority table, AP2 JSON and Markdown export. Client-side. Zero PII.",
  "path": "tools/300-dora-ict-risk-gap-analyser.html",
  "tags": [
    "DORA",
    "ICT Risk",
    "Gap Analysis",
    "Maturity",
    "AP2"
  ],
  "ap2_export": true,
  "mcp": {
    "name": "analyse_dora_ict_risk",
    "description": "Run the DORA ICT risk maturity gap analysis and return AP2 JSON results",
    "input_schema": {
      "type": "object",
      "properties": {
        "pillar_scores": {
          "type": "object",
          "description": "Map of DORA pillar name to maturity score (0-4)",
          "properties": {
            "ict_risk_management": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "incident_management": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "resilience_testing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "third_party_risk": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "information_sharing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "bank",
            "payment-institution",
            "e-money-firm",
            "investment-firm",
            "casp"
          ]
        }
      },
      "required": [
        "pillar_scores"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000,
    "entry": "tools/300-dora-ict-risk-gap-analyser.html"
  },
  "regulatory_frameworks": [
    "EU 2022/2554"
  ],
  "jurisdictions": [
    "EU",
    "EEA"
  ],
  "last_reviewed": "2025-05-01"
}
