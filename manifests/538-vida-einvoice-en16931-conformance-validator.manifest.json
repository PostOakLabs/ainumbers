{
  "tool_id": "art-159-vida-einvoice-en16931-conformance-validator",
  "version": "1.0.0",
  "title": "ViDA EN 16931 E-Invoice Conformance Validator",
  "description": "Validate a structured e-invoice against EN 16931-1:2026 mandatory fields for ViDA (EU 2025/516) conformance: invoice number, date, ISO 4217 currency, seller name, buyer name, seller VAT ID, VAT breakdown with valid category code, and total with VAT. Returns conformant/vida_ready verdicts and list of missing fields. Root node of the vida-digital-reporting-requirements chain. Zero network, zero PII.",
  "category": "chaingraph",
  "tags": ["ViDA", "EN 16931", "e-invoice", "structured invoice", "EU 2025/516", "VAT", "chaingraph", "DRR", "compliance"],
  "audience": ["CFO", "VAT Manager", "ERP Developer", "Tax Counsel", "Compliance Officer"],
  "input_schema": {
    "type": "object",
    "properties": {
      "invoice": {
        "type": "object",
        "properties": {
          "invoice_number": {"type": "string"},
          "invoice_date": {"type": "string", "description": "YYYY-MM-DD"},
          "currency_code": {"type": "string", "description": "ISO 4217 3-char"},
          "seller_name": {"type": "string"},
          "buyer_name": {"type": "string"},
          "seller_vat_id": {"type": "string"},
          "syntax_id": {"type": "string", "description": "EN 16931 syntax identifier URI"},
          "vat_breakdown": {"type": "array", "items": {"type": "object", "properties": {"category_code": {"type": "string"}}}},
          "total_with_vat": {"type": "number"}
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "conformant": {"type": "boolean"},
      "vida_ready": {"type": "boolean"},
      "syntax_id_valid": {"type": "boolean"},
      "mandatory_fields_checked": {"type": "number"},
      "missing_fields": {"type": "array", "items": {"type": "string"}},
      "currency_code": {"type": ["string", "null"]},
      "total_with_vat": {"type": "number"}
    }
  },
  "mcp_tool_definition": {
    "name": "validate_vida_einvoice_conformance",
    "description": "Validate a structured e-invoice against EN 16931-1:2026 mandatory fields for ViDA (EU 2025/516) conformance: invoice number, date, ISO 4217 currency, seller name, buyer name, seller VAT ID, VAT breakdown with valid category code, and total with VAT. Returns conformant/vida_ready verdicts and list of missing fields. Zero network, zero PII.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "invoice": {
          "type": "object",
          "properties": {
            "invoice_number": {"type": "string"},
            "invoice_date": {"type": "string", "description": "YYYY-MM-DD"},
            "currency_code": {"type": "string", "description": "ISO 4217 3-char"},
            "seller_name": {"type": "string"},
            "buyer_name": {"type": "string"},
            "seller_vat_id": {"type": "string"},
            "syntax_id": {"type": "string", "description": "EN 16931 syntax identifier URI"},
            "vat_breakdown": {"type": "array", "items": {"type": "object", "properties": {"category_code": {"type": "string"}}}},
            "total_with_vat": {"type": "number"}
          }
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-159-vida-einvoice-en16931-conformance-validator.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
