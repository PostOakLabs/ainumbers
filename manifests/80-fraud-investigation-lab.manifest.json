{
  "tool_id": "fraud-investigation-lab",
  "version": "1.0.0",
  "title": "Payment Fraud Investigation Decision Lab",
  "description": "Five-stage fraud investigation workflow: Intake & Validation → Entity Intelligence → Risk Scoring → Compliance Mapping → Resolution & Reporting. Outputs fraud score, AML rules, EBA typology, SAR narrative, and AP2 investigation mandate.",
  "category": "fraud-risk",
  "tags": [
    "fraud",
    "AML",
    "SAR",
    "NACHA",
    "BSA",
    "investigation",
    "chargeback"
  ],
  "audience": [
    "compliance",
    "ops",
    "fraud analyst"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "fileType": {
        "type": "string",
        "enum": [
          "ACH",
          "ISO20022",
          "FedNow",
          "SWIFT",
          "Card"
        ]
      },
      "amount": {
        "type": "number",
        "description": "Transaction amount USD"
      },
      "originatorName": {
        "type": "string"
      },
      "receiverName": {
        "type": "string"
      },
      "jurisdiction": {
        "type": "string"
      },
      "product": {
        "type": "string"
      },
      "entityType": {
        "type": "string"
      },
      "resolutionAction": {
        "type": "string",
        "enum": [
          "DISPUTE",
          "SAR",
          "BOTH",
          "CLOSE"
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "investigationId": {
        "type": "string"
      },
      "fraudScore": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "riskBand": {
        "type": "string"
      },
      "sarRequired": {
        "type": "boolean"
      },
      "chargebackPackageReady": {
        "type": "boolean"
      },
      "sarNarrativeDraft": {
        "type": "string"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "investigate_payment_fraud",
    "description": "Run a 5-stage fraud investigation on a payment record. Provides fraud scoring, AML rule matching, EBA typology classification, BSA/NACHA compliance mapping, and generates a SAR narrative draft. Use when an agent needs to assess whether a transaction is fraudulent and determine the required regulatory response.",
    "inputSchema": {
      "type": "object",
      "required": [
        "fileType",
        "amount"
      ],
      "properties": {
        "fileType": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "jurisdiction": {
          "type": "string"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/80-fraud-investigation-lab.html",
    "function_name": "exportAP2",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
