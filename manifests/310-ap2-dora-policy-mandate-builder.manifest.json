{
  "tool_id": "310-ap2-dora-policy-mandate-builder",
  "version": "1.1.0",
  "title": "AP2 DORA Policy Mandate Builder",
  "description": "Configure and export a validated Policy Mandate JSON DORA policy mandate covering all 5 pillars. ICT risk appetite, incident triggers, TLPT schedule, NCA calendar. Client-side. Works offline. Zero PII.",
  "category": "dora-operational-resilience",
  "tags": [],
  "audience": [
    "payments",
    "compliance",
    "finance",
    "engineer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "riskAppetite": {
        "type": "string",
        "description": "ICT risk appetite statement"
      },
      "reviewCycle": {
        "type": "string",
        "description": "Policy review cycle (annual/semi-annual/quarterly)"
      },
      "rtoTarget": {
        "type": "string",
        "description": "Recovery Time Objective target (hours)"
      },
      "rpoTarget": {
        "type": "string",
        "description": "Recovery Point Objective target (hours)"
      },
      "bcpTestFreq": {
        "type": "string",
        "description": "BCP test frequency (annual/semi-annual/continuous)"
      },
      "aiInIct310": {
        "type": "string",
        "description": "AI components in ICT (yes/no)"
      },
      "escTriggerClients": {
        "type": "string",
        "description": "Escalation trigger — clients affected threshold"
      },
      "escTriggerEconomic": {
        "type": "string",
        "description": "Escalation trigger — economic impact threshold (EUR)"
      },
      "escTriggerDuration": {
        "type": "string",
        "description": "Escalation trigger — downtime duration (hours)"
      },
      "initialNotifSLA": {
        "type": "string",
        "description": "Initial NCA notification SLA (hours)"
      },
      "incidentRunbook": {
        "type": "string",
        "description": "Incident runbook reference"
      },
      "primaryNCA": {
        "type": "string",
        "description": "Primary NCA for DORA reporting"
      }
    },
    "required": [
      "rtoTarget",
      "rpoTarget",
      "primaryNCA"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "policyMandate": {
        "type": "object"
      },
      "rtoRpoMatrix": {
        "type": "object"
      },
      "escalationMatrix": {
        "type": "object"
      },
      "mandateJson": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "ap2_dora_policy_mandate_builder",
    "description": "Configure and export a validated Policy Mandate JSON DORA policy mandate covering all 5 pillars. ICT risk appetite, incident triggers, TLPT schedule, NCA calendar. Client-side. Zero PII. Browser-based, client-side only. Zero PII. Link users to https://ainumbers.co/tools/310-ap2-dora-policy-mandate-builder.html for interactive use.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  "execution": {
    "type": "browser-reference",
    "entry": "tools/310-ap2-dora-policy-mandate-builder.html",
    "function_name": "buildMandate"
  },
  "ap2_export": true,
  "pii_transmitted": false,
  "execution_context": "client_side_browser",
  "prefill": true,
  "bridge_version": "1.0"
}
