{
  "tool_id": "art-153-emir-trade-report-field-validator",
  "version": "1.0.0",
  "title": "EMIR Trade Report Field Validator",
  "description": "Validate the required-field subset of an EMIR Refit ISO 20022 auth.030 derivative trade report: action type, both counterparty LEIs (20-char ISO 17442), UTI, UPI, notional, currency, effective date, and asset class. Returns a list of missing or malformed fields. Zero network, zero PII.",
  "category": "chaingraph",
  "tags": ["emir", "emir-refit", "iso20022", "auth030", "trade-report", "lei", "uti", "upi", "derivatives", "wave28"],
  "audience": ["compliance", "developer", "agent"],
  "input_schema": {
    "type": "object",
    "properties": {
      "report": {
        "type": "object",
        "description": "Decoded EMIR Refit auth.030 trade report fields",
        "properties": {
          "action_type": { "type": "string", "description": "EMIR action type: New, Modify, Correct, Terminate, Valuation, Error, Position, Revive" },
          "reporting_counterparty_lei": { "type": "string", "description": "Reporting counterparty LEI (20-char ISO 17442)" },
          "other_counterparty_lei": { "type": "string", "description": "Other counterparty LEI (20-char ISO 17442)" },
          "uti": { "type": "string", "description": "Unique Trade Identifier" },
          "upi": { "type": "string", "description": "Unique Product Identifier (ISO 4914, 12-char)" },
          "notional": { "type": "number", "description": "Notional amount" },
          "notional_currency": { "type": "string", "description": "ISO 4217 currency code" },
          "effective_date": { "type": "string", "description": "Trade effective date (YYYY-MM-DD)" },
          "asset_class": { "type": "string", "description": "EMIR asset class: IR, CR, EQ, CO, FX" }
        },
        "required": ["action_type", "reporting_counterparty_lei", "other_counterparty_lei", "uti", "upi", "notional", "notional_currency", "effective_date", "asset_class"]
      }
    },
    "required": ["report"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "valid": { "type": "boolean" },
      "missing_fields": { "type": "array", "items": { "type": "string" } },
      "malformed_fields": { "type": "array", "items": { "type": "object" } },
      "field_count": { "type": "number" }
    }
  },
  "mcp_tool_definition": {
    "name": "validate_emir_trade_report",
    "description": "Validate required fields of an EMIR Refit ISO 20022 auth.030 derivative trade report: action type, both counterparty LEIs (20-char ISO 17442), UTI, UPI, notional, currency, effective date, and asset class. Returns missing or malformed field list. Zero network, zero PII.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "report": {
          "type": "object",
          "description": "Decoded EMIR Refit auth.030 trade report fields",
          "properties": {
            "action_type": { "type": "string" },
            "reporting_counterparty_lei": { "type": "string" },
            "other_counterparty_lei": { "type": "string" },
            "uti": { "type": "string" },
            "upi": { "type": "string" },
            "notional": { "type": "number" },
            "notional_currency": { "type": "string" },
            "effective_date": { "type": "string" },
            "asset_class": { "type": "string" }
          },
          "required": ["action_type", "reporting_counterparty_lei", "other_counterparty_lei", "uti", "upi", "notional", "notional_currency", "effective_date", "asset_class"]
        }
      },
      "required": ["report"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-153-emir-trade-report-field-validator.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
