{
  "version": "1.0.0",
  "tool_id": "dora-third-party-contract-checker",
  "tool_number": 305,
  "category": "cat-22",
  "name": "ICT Third-Party Contract Clause Checker",
  "description": "Validates ICT service agreements against DORA Art. 30 mandatory contractual requirements. 10-clause checklist, compliance % score, model clause language stubs, AP2 JSON mandate. Client-side. Zero PII.",
  "path": "tools/305-dora-third-party-contract-checker.html",
  "tags": [
    "DORA",
    "Third-Party",
    "Contracts",
    "Art. 30",
    "AP2"
  ],
  "ap2_export": true,
  "mcp": {
    "name": "check_dora_contract_clauses",
    "description": "Check an ICT third-party contract against DORA Art. 30 mandatory clause requirements",
    "input_schema": {
      "type": "object",
      "properties": {
        "contract_type": {
          "type": "string",
          "enum": [
            "cloud",
            "saas",
            "data",
            "payment",
            "security",
            "other"
          ]
        },
        "cif_tier": {
          "type": "string",
          "enum": [
            "T1",
            "T2",
            "T3"
          ]
        },
        "ctpp_designated": {
          "type": "boolean"
        },
        "clauses_present": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sla",
              "audit",
              "incident_notif",
              "bc",
              "data_location",
              "exit",
              "subcontracting",
              "accessibility",
              "cooperation",
              "terminate_rights"
            ]
          },
          "description": "List of Art. 30 clause IDs already present in the contract"
        }
      },
      "required": [
        "contract_type",
        "cif_tier",
        "clauses_present"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000,
    "entry": "tools/305-dora-third-party-contract-checker.html"
  },
  "regulatory_frameworks": [
    "EU 2022/2554"
  ],
  "jurisdictions": [
    "EU",
    "EEA"
  ],
  "last_reviewed": "2025-05-01"
}
