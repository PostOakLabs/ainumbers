{
  "tool_id": "512-tokenized-security-lifecycle-validator",
  "version": "1.0.0",
  "title": "Tokenized Security Lifecycle Validator",
  "description": "Validate issuance, corporate actions, and maturity/redemption lifecycle for tokenized securities on Daml/Canton. Checks Daml contract coverage against required lifecycle events by security type. EU DLT Pilot Regime eligibility and prospectus obligation checks.",
  "category": "capital-markets",
  "tags": ["canton","daml","lifecycle","tokenization","issuance","dlt-pilot","corporate-action","securities"],
  "audience": ["issuance","securities-ops","compliance","capital-markets","legal"],
  "mcp_tool_definition": {
    "name": "validate_tokenized_security_lifecycle",
    "description": "Validate Daml contract lifecycle coverage for tokenized securities on Canton. Checks required events (issuance, coupon, corporate action, transfer, redemption, default) by security type. EU DLT Pilot Regime and prospectus requirement checks included.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "security_name": {"type": "string"},
        "security_type": {"type": "string", "enum": ["ust","corporate_bond","equity","fund_unit","govt_bond","structured_note"]},
        "issuance_jurisdiction": {"type": "string", "enum": ["us","eu","uk","sg","hk","other"]},
        "daml_contract_defined": {"type": "boolean"},
        "daml_events_covered": {"type": "array", "items": {"type": "string", "enum": ["issuance","coupon_payment","corporate_action","transfer","maturity_redemption","default_handling"]}},
        "issuance_amount_usd": {"type": "number"},
        "custodian_model": {"type": "string", "enum": ["dtc_custodied","third_party_csd","self_custodied","canton_native"]},
        "prospectus_filed": {"type": "boolean"},
        "isin_assigned": {"type": "boolean"},
        "corporate_actions_expected": {"type": "string", "enum": ["none","coupon_only","coupon_and_redemption","equity_events","complex"]}
      },
      "required": ["security_type","issuance_jurisdiction","daml_events_covered"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/512-tokenized-security-lifecycle-validator.html",
    "function_name": "runSecurityLifecycle",
    "timeout_ms": 5000
  },
  "chaingraph": {
    "chaingraph_version": "0.3.1",
    "semantic_profile": "iso20022:party-identification",
    "dct_conformsTo": "https://ainumbers.co/chaingraph/profiles/iso20022/party-identification.jsonld",
    "@context": [
      "https://ainumbers.co/chaingraph/context.jsonld",
      "https://ainumbers.co/chaingraph/iso20022-context.jsonld"
    ]
  },
  "ap2_export": true,
  "mandate_type": "compliance_mandate",
  "pii_transmitted": false,
  "execution_context": "client_side_browser",
  "prefill": true,
  "bridge_version": "1.0",
  "intake": true
}
