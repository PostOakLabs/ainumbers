{
  "tool_id": "vrp-mandate-sepa-validator",
  "version": "1.0.0",
  "title": "VRP Mandate Builder + SEPA Validator",
  "description": "Builds UK Variable Recurring Payments (VRP) mandates to Open Banking specification and validates SEPA Credit Transfer and Direct Debit parameters including IBAN/BIC, reachability, and mandate structure.",
  "category": "compliance-consent",
  "tags": [
    "VRP",
    "SEPA",
    "IBAN",
    "BIC",
    "mandate",
    "open banking",
    "UK",
    "direct debit"
  ],
  "audience": [
    "engineer",
    "product",
    "compliance"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "mandateType": {
        "type": "string",
        "enum": [
          "sweeping",
          "non-sweeping"
        ]
      },
      "creditorIBAN": {
        "type": "string"
      },
      "creditorBIC": {
        "type": "string"
      },
      "maxAmount": {
        "type": "number"
      },
      "maxAmountPeriod": {
        "type": "string",
        "enum": [
          "Daily",
          "Weekly",
          "Monthly"
        ]
      },
      "periodicLimit": {
        "type": "number"
      },
      "validFromDate": {
        "type": "string",
        "description": "ISO 8601 date"
      },
      "validToDate": {
        "type": "string",
        "description": "ISO 8601 date"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "vrp_mandate_generated": {
        "type": "boolean"
      },
      "sepa_valid": {
        "type": "boolean"
      },
      "iban_valid": {
        "type": "boolean"
      },
      "bic_valid": {
        "type": "boolean"
      },
      "sepa_reachable": {
        "type": "boolean"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "build_vrp_mandate",
    "description": "Build a VRP mandate to UK Open Banking specification and validate SEPA payment parameters. Returns mandate JSON, IBAN/BIC validation results, and SEPA reachability status. Use when an agent needs to set up a recurring payment mandate.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mandateType": {
          "type": "string"
        },
        "creditorIBAN": {
          "type": "string"
        },
        "maxAmount": {
          "type": "number"
        },
        "maxAmountPeriod": {
          "type": "string"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/11-vrp-mandate-sepa-validator.html",
    "function_name": "buildVRPMandate",
    "timeout_ms": 3000
  },
  "ap2_export": true
}
