{
  "tool_id": "ap2-payments-checker",
  "version": "1.0.0",
  "title": "AP2 Agentic Payments Compatibility Checker",
  "description": "Validates a payment payload or manual checklist against the AP2 (Agent-to-Agent Payments Protocol) specification. Scores compatibility, flags schema gaps, and generates a scaffold for non-compliant payloads.",
  "category": "core-infrastructure",
  "tags": [
    "AP2",
    "agentic payments",
    "compatibility",
    "schema",
    "validation",
    "Google A2A"
  ],
  "audience": [
    "engineer",
    "architect",
    "product"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "json",
          "manual"
        ],
        "description": "Input mode"
      },
      "payload": {
        "type": "object",
        "description": "AP2 JSON payload to validate (json mode)"
      },
      "answers": {
        "type": "object",
        "description": "Manual checklist answers (manual mode)",
        "additionalProperties": {
          "type": "string",
          "enum": [
            "yes",
            "partial",
            "no"
          ]
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "compatibility_score": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "band": {
        "type": "string",
        "enum": [
          "AP2-Ready",
          "Partially Compatible",
          "Incompatible",
          "Unknown"
        ]
      },
      "dimensions": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "scaffold_generated": {
        "type": "boolean"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_ap2_compatibility",
    "description": "Validate a payment payload or answer set against the AP2 protocol spec. Returns a compatibility score, band classification, dimension breakdown, and remediation guidance. Use when an agent needs to verify a payment instruction is AP2-compatible before sending to an agentic runtime.",
    "inputSchema": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "json",
            "manual"
          ]
        },
        "payload": {
          "type": "object"
        },
        "answers": {
          "type": "object"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/102-ap2-payments-checker.html",
    "function_name": "exportAP2",
    "timeout_ms": 3000
  },
  "ap2_export": true
}
