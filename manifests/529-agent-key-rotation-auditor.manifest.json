{
  "tool_id": "art-132-agent-key-rotation-auditor",
  "version": "1.0.0",
  "title": "Agent Key Rotation Auditor",
  "description": "Audit Ed25519 key age and rotation posture for Web Bot Auth / Visa TAP / Mastercard Agent Pay. Computes key_age_s from key_created_unix and now_unix, checks next-key staging, emits HEALTHY / ROTATION_STAGED / ACTION_REQUIRED.",
  "category": "chaingraph",
  "tags": ["web-bot-auth", "key-rotation", "ed25519", "visa-tap", "mastercard-agent-pay", "agent-identity", "wave24"],
  "audience": ["compliance", "developer", "agent"],
  "input_schema": {
    "type": "object",
    "properties": {
      "key_created_unix": { "type": "number" },
      "now_unix": { "type": "number" },
      "max_key_age_s": { "type": "number" },
      "next_key_present": { "type": "boolean" },
      "algorithm": { "type": "string" }
    },
    "required": ["key_created_unix", "now_unix"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "key_age_s": { "type": "number" },
      "rotation_due": { "type": "boolean" },
      "next_key_staged": { "type": "boolean" },
      "alg_ok": { "type": "boolean" },
      "verdict": { "type": "string", "enum": ["HEALTHY", "ROTATION_STAGED", "ACTION_REQUIRED"] }
    }
  },
  "mcp_tool_definition": {
    "name": "audit_agent_key_rotation",
    "description": "Audit Ed25519 key age and rotation posture. Computes key_age_s, checks rotation_due and next-key staging. Emits HEALTHY / ROTATION_STAGED / ACTION_REQUIRED.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key_created_unix": { "type": "number" },
        "now_unix": { "type": "number" },
        "max_key_age_s": { "type": "number" },
        "next_key_present": { "type": "boolean" },
        "algorithm": { "type": "string" }
      },
      "required": ["key_created_unix", "now_unix"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-132-agent-key-rotation-auditor.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
