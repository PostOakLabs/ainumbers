{
  "tool_id": "compliance-readiness-assessment",
  "version": "1.0.0",
  "title": "Compliance Readiness Assessment",
  "description": "Maps regulatory requirements across jurisdictions (UK PSD2, EU PSD3, US CFPB 1033, AU CDR, SEPA) against entity type, product type, and self-assessed posture. Scores readiness, highlights critical gaps, and exports an AP2 compliance mandate.",
  "category": "compliance-consent",
  "tags": [
    "compliance",
    "PSD2",
    "PSD3",
    "CFPB 1033",
    "CDR",
    "SEPA",
    "open banking",
    "readiness"
  ],
  "audience": [
    "compliance",
    "legal",
    "engineer"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "jurisdictions",
      "entityType",
      "productType"
    ],
    "properties": {
      "jurisdictions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "e.g. [\"UK\",\"EU\",\"US\",\"AU\"]"
      },
      "entityType": {
        "type": "string",
        "enum": [
          "bank",
          "psp",
          "fintech",
          "tpp",
          "corporate"
        ]
      },
      "productType": {
        "type": "string",
        "enum": [
          "open_banking",
          "payments",
          "lending",
          "data"
        ]
      },
      "posture": {
        "type": "string",
        "enum": [
          "NONE",
          "PARTIAL",
          "SUBSTANTIAL",
          "FULL"
        ],
        "description": "Self-assessed compliance posture"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "readiness_score": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "requirement_count": {
        "type": "number"
      },
      "pass_count": {
        "type": "number"
      },
      "partial_count": {
        "type": "number"
      },
      "fail_count": {
        "type": "number"
      },
      "critical_gaps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "assess_compliance_readiness",
    "description": "Assess regulatory compliance readiness for a payment or open banking entity across multiple jurisdictions. Returns a readiness score, pass/fail breakdown per requirement, and a list of critical gaps requiring immediate remediation. Use when an agent needs to determine compliance status before a product launch or regulatory deadline.",
    "inputSchema": {
      "type": "object",
      "required": [
        "jurisdictions",
        "entityType",
        "productType"
      ],
      "properties": {
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entityType": {
          "type": "string"
        },
        "productType": {
          "type": "string"
        },
        "posture": {
          "type": "string"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "https://ainumbers.co/tools/88-compliance-readiness.html",
    "function_name": "exportAP2",
    "timeout_ms": 3000
  },
  "ap2_export": true
}
