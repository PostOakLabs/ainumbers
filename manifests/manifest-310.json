{
  "version": "1.0.0",
  "tool_id": "ap2-dora-policy-mandate-builder",
  "tool_number": 310,
  "category": "cat-22",
  "name": "AP2 DORA Policy Mandate Builder",
  "description": "Anchor agentic tool. Consolidates all 5 DORA pillars into a validated AP2 JSON policy mandate. Configures ICT risk appetite, incident escalation triggers, third-party review cadence, TLPT scheduling, RoI update frequency, and NCA submission calendar. Outputs AP2 JSON mandate, board policy summary, and agent instruction set. Client-side. Zero PII.",
  "path": "tools/310-ap2-dora-policy-mandate-builder.html",
  "tags": ["DORA", "AP2 Agentic", "Policy Mandate", "Operational Resilience", "Export", "AP2"],
  "ap2_export": true,
  "mcp": {
    "name": "build_dora_ap2_mandate",
    "description": "Build a complete AP2 JSON DORA policy mandate covering all 5 pillars from configuration parameters",
    "input_schema": {
      "type": "object",
      "properties": {
        "risk_appetite": {"type":"string","enum":["low","medium","high"]},
        "rto_hours": {"type":"integer","minimum":1,"maximum":72},
        "rpo_hours": {"type":"integer","minimum":0,"maximum":24},
        "major_trigger_clients": {"type":"integer","minimum":1000},
        "major_trigger_economic_eur": {"type":"number","minimum":500000},
        "major_trigger_duration_hours": {"type":"integer","minimum":4},
        "tlpt_required": {"type":"boolean"},
        "tlpt_next_date": {"type":"string","format":"date"},
        "roi_format": {"type":"string","enum":["xbrl-csv","excel"]},
        "jurisdiction_count": {"type":"integer","minimum":1,"maximum":27},
        "primary_nca": {"type":"string"},
        "board_reporting_frequency": {"type":"string","enum":["monthly","quarterly","semi-annual"]},
        "ai_in_ict": {"type":"boolean"}
      },
      "required": ["risk_appetite","rto_hours","major_trigger_clients","primary_nca"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000
  },
  "regulatory_frameworks": ["EU 2022/2554","Commission Delegated Regulation (EU) 2024/1772","EU Regulation 2025/302","TIBER-EU"],
  "jurisdictions": ["EU","EEA"],
  "last_reviewed": "2025-05-01"
}
