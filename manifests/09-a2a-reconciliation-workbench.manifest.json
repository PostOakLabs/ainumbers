{
  "tool_id": "a2a-reconciliation-workbench",
  "version": "1.1.0",
  "title": "A2A Reconciliation Workbench + Reference Generator",
  "description": "Matches bank statement rows against internal ledger rows using exact and fuzzy matching. Reports matched pairs, unmatched items, net difference, and aging of exceptions. Also generates ISO 20022, NACHA, and SEPA payment references.",
  "category": "core-infrastructure",
  "tags": [
    "reconciliation",
    "A2A",
    "matching",
    "exceptions",
    "ISO 20022",
    "NACHA",
    "SEPA"
  ],
  "audience": [
    "ops",
    "treasury",
    "finance"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "bankRows": {
        "type": "array",
        "description": "Bank statement rows (date, reference, amount)"
      },
      "ledgerRows": {
        "type": "array",
        "description": "Internal ledger rows (date, reference, amount)"
      },
      "tolerance": {
        "type": "number",
        "description": "Amount tolerance for fuzzy match USD"
      },
      "dateTol": {
        "type": "number",
        "description": "Date tolerance in days"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "matched_count": {
        "type": "number"
      },
      "unmatched_bank": {
        "type": "number"
      },
      "unmatched_ledger": {
        "type": "number"
      },
      "net_difference": {
        "type": "number"
      },
      "match_rate_pct": {
        "type": "number"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "reconcile_a2a_payments",
    "description": "Match bank statement entries against internal ledger entries using exact and fuzzy matching. Returns match rate, unmatched counts, net difference, and exception aging. Use when an agent needs to identify reconciliation breaks between bank and ledger records.",
    "inputSchema": {
      "type": "object",
      "required": [
        "bankRows",
        "ledgerRows"
      ],
      "properties": {
        "bankRows": {
          "type": "array"
        },
        "ledgerRows": {
          "type": "array"
        },
        "tolerance": {
          "type": "number"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/09-a2a-reconciliation-workbench.html",
    "function_name": "runReconcile",
    "timeout_ms": 10000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0"
}
