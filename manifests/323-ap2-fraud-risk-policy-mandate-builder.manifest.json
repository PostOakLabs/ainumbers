{
  "tool_id": "ap2-fraud-risk-policy-mandate-builder",
  "version": "1.0.0",
  "title": "AP2 Fraud & Risk Policy Mandate Builder",
  "description": "Builds a validated AP2 agent_guardrail_mandate for autonomous fraud decisioning agents across 4 dimensions: detection thresholds (synthetic ID, ATO cutoffs), APP scam controls (CoP, delay, PSR acknowledgement), loss tolerance (bps budget, CNP/ATO/APP rates), and reporting triggers (SAR threshold, board frequency). Built-in contradiction detection. MCP server deployable. Client-side. Zero PII.",
  "category": "cat-3",
  "tags": [
    "AP2",
    "agentic",
    "fraud-policy",
    "risk-appetite",
    "mandate",
    "MCP",
    "agent_guardrail",
    "zero-pii"
  ],
  "audience": [
    "fraud",
    "compliance",
    "engineer",
    "cfo"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "synth_cutoff": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "ato_cutoff": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "model_version": {
        "type": "string"
      },
      "cop_enforcement": {
        "type": "string",
        "enum": [
          "mandatory",
          "best-efforts",
          "off"
        ]
      },
      "delay_policy": {
        "type": "string",
        "enum": [
          "none",
          "warning",
          "24h-delay"
        ]
      },
      "psr_ack": {
        "type": "boolean"
      },
      "loss_budget_bps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cnp_rate_bps": {
        "type": "integer",
        "minimum": 1
      },
      "ato_rate_bps": {
        "type": "integer",
        "minimum": 1
      },
      "app_rate_bps": {
        "type": "integer",
        "minimum": 1
      },
      "sar_threshold": {
        "type": "integer",
        "minimum": 0
      },
      "escalation_chain": {
        "type": "string"
      },
      "board_freq": {
        "type": "string",
        "enum": [
          "monthly",
          "quarterly",
          "ad-hoc"
        ]
      }
    },
    "required": [
      "synth_cutoff",
      "ato_cutoff",
      "cop_enforcement",
      "delay_policy",
      "psr_ack",
      "loss_budget_bps",
      "cnp_rate_bps",
      "ato_rate_bps",
      "app_rate_bps",
      "sar_threshold",
      "board_freq"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "agent_instructions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "config": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "build_fraud_risk_ap2_mandate",
    "description": "Builds a validated AP2 agent_guardrail_mandate for fraud decisioning agents. Configures 4 dimensions: detection thresholds, APP scam controls, loss tolerance, and SAR reporting triggers. Returns an ordered agent_instructions array deployable via the AINumbers.co MCP server. Validates for policy contradictions before export.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "synth_cutoff": {
          "type": "integer"
        },
        "ato_cutoff": {
          "type": "integer"
        },
        "cop_enforcement": {
          "type": "string"
        },
        "delay_policy": {
          "type": "string"
        },
        "psr_ack": {
          "type": "boolean"
        },
        "loss_budget_bps": {
          "type": "integer"
        },
        "cnp_rate_bps": {
          "type": "integer"
        },
        "ato_rate_bps": {
          "type": "integer"
        },
        "app_rate_bps": {
          "type": "integer"
        },
        "sar_threshold": {
          "type": "integer"
        },
        "board_freq": {
          "type": "string"
        }
      },
      "required": [
        "synth_cutoff",
        "ato_cutoff",
        "cop_enforcement",
        "delay_policy",
        "psr_ack",
        "loss_budget_bps",
        "cnp_rate_bps",
        "ato_rate_bps",
        "app_rate_bps",
        "sar_threshold",
        "board_freq"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/323-ap2-fraud-risk-policy-mandate-builder.html",
    "function_name": "buildFraudRiskAP2Mandate",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
