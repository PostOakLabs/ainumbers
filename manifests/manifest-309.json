{
  "version": "1.0.0",
  "tool_id": "nis2-dora-overlap-mapper",
  "tool_number": 309,
  "category": "cat-22",
  "name": "NIS2 / DORA Overlap & Dual-Compliance Mapper",
  "description": "Maps compliance overlap between DORA and NIS2 for financial entities. 14-control dual-compliance matrix (SHARED/DORA-ONLY/NIS2-ONLY/AI-OVERLAP), deduplication count, AI Act overlap flag, AP2 JSON mandate. Client-side. Zero PII.",
  "path": "tools/309-nis2-dora-overlap-mapper.html",
  "tags": [
    "DORA",
    "NIS2",
    "Dual Compliance",
    "AI Act",
    "Overlap",
    "AP2"
  ],
  "ap2_export": true,
  "mcp": {
    "name": "map_nis2_dora_overlap",
    "description": "Map compliance overlap between DORA and NIS2 for a financial entity and identify deduplication opportunities",
    "input_schema": {
      "type": "object",
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "bank",
            "payment-institution",
            "investment-firm",
            "e-money-firm",
            "casp"
          ]
        },
        "sector": {
          "type": "string",
          "enum": [
            "banking",
            "financial-market",
            "digital-infra",
            "other-financial"
          ]
        },
        "ai_in_ict": {
          "type": "boolean"
        },
        "nis2_essential_entity": {
          "type": "boolean"
        },
        "cross_border": {
          "type": "boolean"
        }
      },
      "required": [
        "entity_type",
        "sector"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000,
    "entry": "tools/309-nis2-dora-overlap-mapper.html"
  },
  "regulatory_frameworks": [
    "EU 2022/2554",
    "EU 2022/2555",
    "EU 2024/1689"
  ],
  "jurisdictions": [
    "EU",
    "EEA"
  ],
  "last_reviewed": "2025-05-01"
}
