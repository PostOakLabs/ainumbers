{
  "tool_id": "genius-act-reserve-optimizer",
  "version": "1.0.0",
  "title": "GENIUS Act Reserve Composition Optimizer",
  "description": "Validates and optimises payment stablecoin reserve composition against GENIUS Act (enacted Jul 2025, effective Jan 2027) requirements. Checks 1:1 backing, UST maturity caps (≤93 days), Fed deposit allocation, asset segregation, and monthly disclosure obligations. Outputs AP2 compliance mandate.",
  "category": "cat-2",
  "tags": [
    "GENIUS Act",
    "stablecoin",
    "reserve composition",
    "PPSI",
    "payment stablecoin",
    "Fed deposit",
    "T-bill",
    "UST",
    "OCC",
    "FDIC",
    "compliance",
    "regulatory",
    "AP2 export"
  ],
  "audience": [
    "compliance",
    "product",
    "treasury"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "issuer_type": {
        "type": "string",
        "description": "Type of payment stablecoin issuer (bank, non-bank, federal)"
      },
      "outstanding_usd": {
        "type": "number",
        "description": "Total stablecoins outstanding in USD"
      },
      "reserves": {
        "type": "object",
        "description": "Reserve allocation by asset class",
        "properties": {
          "cash_pct": {
            "type": "number"
          },
          "fed_deposit_pct": {
            "type": "number"
          },
          "ust_0_30_pct": {
            "type": "number"
          },
          "ust_31_93_pct": {
            "type": "number"
          },
          "ust_over_93_pct": {
            "type": "number"
          },
          "repo_pct": {
            "type": "number"
          },
          "other_pct": {
            "type": "number"
          }
        }
      }
    },
    "required": [
      "issuer_type",
      "outstanding_usd",
      "reserves"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "compliance_score_pct": {
        "type": "number"
      },
      "backing_ratio": {
        "type": "number"
      },
      "ust_maturity_compliant": {
        "type": "boolean"
      },
      "gaps": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "verdict": {
        "type": "string"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "genius_act_reserve_optimizer",
    "description": "Validates payment stablecoin reserve composition against GENIUS Act requirements. Returns compliance score, gap analysis, and AP2 mandate.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "issuer_type": {
          "type": "string"
        },
        "outstanding_usd": {
          "type": "number"
        },
        "reserves": {
          "type": "object"
        }
      },
      "required": [
        "issuer_type",
        "outstanding_usd",
        "reserves"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/328-genius-act-reserve-optimizer.html",
    "function_name": "runAnalysis",
    "timeout_ms": 3000
  },
  "ap2_export": true
}