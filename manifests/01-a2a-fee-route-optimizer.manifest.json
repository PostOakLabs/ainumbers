{
  "tool_id": "a2a-fee-calculator",
  "version": "1.1.0",
  "title": "A2A Fee Calculator + Route Optimizer",
  "description": "Calculates per-transaction and annual costs for A2A rails (FedNow, RTP, Same-Day ACH, Next-Day ACH) versus card, and runs a multi-factor route optimizer across speed, cost, finality, and use-case fit. Exports a route recommendation mandate.",
  "category": "core-infrastructure",
  "tags": [
    "A2A",
    "fee",
    "FedNow",
    "RTP",
    "ACH",
    "routing",
    "cost",
    "interchange"
  ],
  "audience": [
    "treasury",
    "engineer",
    "finance"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "volume",
      "avgTxn",
      "cardRate"
    ],
    "properties": {
      "volume": {
        "type": "number",
        "description": "Monthly transaction volume USD"
      },
      "avgTxn": {
        "type": "number",
        "description": "Average transaction value USD"
      },
      "cardRate": {
        "type": "number",
        "description": "Card interchange rate %"
      },
      "cardFixed": {
        "type": "number",
        "description": "Card fixed fee per transaction USD"
      },
      "urgency": {
        "type": "string",
        "enum": [
          "instant",
          "same-day",
          "next-day",
          "flexible"
        ]
      },
      "useCase": {
        "type": "string"
      },
      "corridor": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "best_rail": {
        "type": "string"
      },
      "best_cost_monthly": {
        "type": "number"
      },
      "best_savings_yr": {
        "type": "number"
      },
      "savings_pct": {
        "type": "number"
      },
      "route_rail": {
        "type": "string"
      },
      "route_confidence": {
        "type": "string"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "calculate_a2a_fee_route",
    "description": "Calculate A2A rail costs vs card and return the optimal route recommendation. Input volume, average transaction, card rate, urgency, and use case. Returns best rail, annual savings, and route confidence. Use when an agent needs to compare payment rail costs for a specific transaction profile.",
    "inputSchema": {
      "type": "object",
      "required": [
        "volume",
        "avgTxn",
        "cardRate"
      ],
      "properties": {
        "volume": {
          "type": "number"
        },
        "avgTxn": {
          "type": "number"
        },
        "cardRate": {
          "type": "number"
        },
        "urgency": {
          "type": "string"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/01-a2a-fee-route-optimizer.html",
    "function_name": "calculate",
    "timeout_ms": 3000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0"
}
