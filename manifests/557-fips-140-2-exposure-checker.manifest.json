{
  "tool_id": "fips-140-2-exposure-checker",
  "version": "1.0.0",
  "title": "FIPS 140-2 Exposure Checker",
  "description": "Flag FIPS 140-2/140-1 validated modules in a pasted certificate inventory against the pinned NIST CMVP Historical-list transition date (2026-09-21) and summarize resulting procurement exposure. Structural check over user-declared data only — not a live CMVP scan or cryptographic audit. Paste-mode. Zero egress. Zero PII.",
  "category": "cat-2",
  "tags": [
    "FIPS 140-2",
    "FIPS 140-3",
    "CMVP",
    "NIST",
    "historical",
    "procurement",
    "exposure",
    "post-quantum",
    "crypto-agility",
    "zero-PII"
  ],
  "audience": [
    "compliance",
    "procurement",
    "security-engineer"
  ],
  "input_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "inventory"
    ],
    "properties": {
      "inventory": {
        "type": "array",
        "description": "Array of {module_name, cert_number, standard} rows (pasted, never fetched)",
        "items": {
          "type": "object",
          "properties": {
            "module_name": { "type": "string" },
            "cert_number": { "type": "string" },
            "standard": { "type": "string" }
          }
        }
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "exposed_count",
      "current_count",
      "findings"
    ],
    "properties": {
      "exposed_count": { "type": "integer" },
      "current_count": { "type": "integer" },
      "unrecognized_count": { "type": "integer" },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "module_name": { "type": "string" },
            "cert_number": { "type": "string" },
            "declared_standard": { "type": ["string", "null"] },
            "status": { "type": "string", "enum": ["exposed", "current", "unrecognized"] }
          }
        }
      },
      "receipt": {
        "type": "object",
        "description": "OCG check receipt (policy_parameters, output_payload, execution_hash)"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_fips140_exposure",
    "description": "Flag FIPS 140-2/140-1 validated modules in a pasted certificate inventory against the pinned NIST CMVP Historical-list transition date and summarize procurement exposure. Structural check over declared data only, not a live CMVP scan.",
    "inputSchema": {
      "type": "object",
      "required": [
        "inventory"
      ],
      "properties": {
        "inventory": {
          "type": "array",
          "description": "Array of {module_name, cert_number, standard} rows"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/557-fips-140-2-exposure-checker.html",
    "function_name": "checkInventory",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "last_reviewed": "2026-07-18",
  "pii_transmitted": false,
  "regulatory_frameworks": [
    "NIST CMVP FIPS 140-2/140-3 transition schedule",
    "FIPS 140-3 (ISO/IEC 19790)"
  ],
  "prefill": false,
  "bridge_version": "1.0"
}
