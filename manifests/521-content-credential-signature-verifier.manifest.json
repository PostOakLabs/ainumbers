{
  "tool_id": "art-124-content-credential-signature-verifier",
  "version": "1.1.0",
  "title": "Content Credential Signature Verifier",
  "description": "Assess a C2PA COSE_Sign1 content-credential signature policy. The caller performs the signature check over the manifest bytes with the declared alg (Ed25519/ES256/ES384/PS256) and attests the outcome via the required signature_verified input; the kernel does not re-verify. Trust posture is caller-supplied: zero network, no OCSP. Emits ACCEPT or REFUSE.",
  "category": "chaingraph",
  "tags": [
    "c2pa",
    "signature",
    "cose",
    "ed25519",
    "content-credentials",
    "eu-ai-act",
    "wave23"
  ],
  "audience": [
    "compliance",
    "developer",
    "agent"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "alg": {
        "type": "string",
        "enum": [
          "Ed25519",
          "ES256",
          "ES384",
          "PS256"
        ]
      },
      "signature_verified": {
        "type": "boolean",
        "description": "result of the caller's signature check over the manifest bytes with the declared alg; the kernel does not re-verify"
      },
      "trust_anchor_match": {
        "type": "boolean"
      },
      "cert_not_expired": {
        "type": "boolean"
      },
      "revocation_status": {
        "type": "string"
      }
    },
    "required": [
      "alg",
      "signature_verified",
      "trust_anchor_match",
      "revocation_status"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "signature_verified": {
        "type": "boolean"
      },
      "signature_verification": {
        "type": "string",
        "enum": [
          "caller_attested"
        ]
      },
      "caveats": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "chain_trusted": {
        "type": "boolean"
      },
      "alg": {
        "type": "string"
      },
      "alg_allowed": {
        "type": "boolean"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "ACCEPT",
          "REFUSE"
        ]
      }
    }
  },
  "mcp_tool_definition": {
    "name": "verify_content_credential_signature",
    "description": "Assess a C2PA COSE_Sign1 content-credential signature policy. The caller performs the signature check over the manifest bytes with the declared alg and attests the outcome via the required signature_verified input; this tool does not re-verify it. Trust anchor, cert-expiry, and revocation status are caller-supplied inputs, not independently checked. Zero network, no state change, nothing issued or registered. Emits ACCEPT or REFUSE.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "enum": [
            "Ed25519",
            "ES256",
            "ES384",
            "PS256"
          ]
        },
        "signature_verified": {
          "type": "boolean",
          "description": "result of the caller's signature check over the manifest bytes with the declared alg; the kernel does not re-verify"
        },
        "trust_anchor_match": {
          "type": "boolean"
        },
        "cert_not_expired": {
          "type": "boolean"
        },
        "revocation_status": {
          "type": "string"
        }
      },
      "required": [
        "alg",
        "signature_verified",
        "trust_anchor_match",
        "revocation_status"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  "execution": {
