    "properties": {
      "alg": { "type": "string", "enum": ["Ed25519", "ES256", "ES384", "PS256"] },
      "signer_public_key_jwk": { "type": "object" },
      "signed_bytes_b64": { "type": "string" },
      "signature_b64": { "type": "string" },
      "trust_anchor_match": { "type": "boolean" },
      "cert_not_expired": { "type": "boolean" },
      "revocation_status": { "type": "string" }
