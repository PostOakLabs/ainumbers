{
  "tool_id": "art-123-c2pa-manifest-validator",
  "version": "1.0.0",
  "title": "C2PA Content Credential Manifest Validator",
  "description": "Validate a decoded C2PA 2.x manifest: claim well-formedness, hard-binding hash assertion, and claim-signature reference. Zero network. Feeds the Content Credential signature verifier.",
  "category": "chaingraph",
  "tags": [
    "c2pa",
    "content-credentials",
    "manifest",
    "provenance",
    "eu-ai-act",
    "wave23"
  ],
  "audience": [
    "compliance",
    "developer",
    "agent"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "claim_generator": {
        "type": "string"
      },
      "claim": {
        "type": "object"
      },
      "assertions": {
        "type": "array"
      },
      "signature": {
        "type": "object"
      }
    },
    "required": [
      "claim_generator",
      "claim",
      "assertions"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "manifest_valid": {
        "type": "boolean"
      },
      "has_hard_binding": {
        "type": "boolean"
      },
      "has_actions": {
        "type": "boolean"
      },
      "assertion_count": {
        "type": "integer"
      },
      "missing_elements": {
        "type": "array"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "validate_c2pa_manifest",
    "description": "Validate a decoded C2PA 2.x manifest structure: claim well-formedness, hard-binding hash assertion, and claim-signature reference. Structural validation only — does not verify the claim signature (see verify_content_credential_signature) or assert authenticity/provenance. Zero network, no state change, nothing issued or registered.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "claim_generator": {
          "type": "string"
        },
        "claim": {
          "type": "object"
        },
        "assertions": {
          "type": "array"
        },
        "signature": {
          "type": "object"
        }
      },
      "required": [
        "claim_generator",
        "claim",
        "assertions"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-123-c2pa-manifest-validator.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true,
  "author": "PostOakLabs",
  "license": "CC-BY-4.0",
  "input_example": {
    "claim_generator": "Adobe Firefly 3.0",
    "claim": {
      "format": "image/jpeg",
      "instanceID": "xmp:iid:0001"
    },
    "assertions": [
      {
        "label": "c2pa.actions"
      },
      {
        "label": "c2pa.hash.data"
      }
    ],
    "signature": {
      "present": true,
      "alg": "ES256"
    }
  },
  "output_example": {
    "manifest_valid": true,
    "has_hard_binding": true,
    "has_actions": true,
    "assertion_count": 2,
    "missing_elements": []
  },
  "example_execution_hash": "f54f13908de686f72f286e249f05811df44961689f0f33c6465e2e387ea0da3c"
}
