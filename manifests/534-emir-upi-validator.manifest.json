    "upi",
    "iso4914",
    "anna-dsb",
    "product-classification",
    "derivatives",
    "wave28"
  ],
  "audience": [
    "compliance",
    "developer",
    "agent"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "upi": {
        "type": "string",
        "description": "Unique Product Identifier (ISO 4914, 12-char alphanumeric)"
      },
      "asset_class": {
        "type": "string",
        "description": "EMIR asset class: IR, CR, EQ, CO, FX"
      },
      "instrument_type": {
        "type": "string",
        "description": "Instrument type (e.g. IRS, CDS, OPT)"
      }
    },
    "required": [
      "upi",
      "asset_class",
      "instrument_type"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "upi_format_valid": {
        "type": "boolean"
      },
      "asset_class_valid": {
        "type": "boolean"
      },
      "instrument_type_present": {
        "type": "boolean"
      },
      "classification_consistent": {
        "type": "boolean"
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
