{
  "tool_id": "art-852-murabahah-ibra-settlement",
  "version": "1.0.0",
  "title": "Murabahah Ibra' Settlement",
  "description": "Computes a deferred-price instalment schedule in integer minor units: per-period profit and principal split, outstanding cost and selling price, and deferred profit. It derives the rebate on early settlement, the variable-rate per-period rebate, and the non-delivery case that also rebates undisbursed principal. Outputs are arithmetic and rule checks against the cited regulator paragraphs, not a fatwa, Shariah certification, legal opinion or regulatory approval.",
  "category": "chaingraph",
  "tags": ["islamic-finance", "murabahah", "ibra", "settlement", "amortization", "mcp:compute_murabahah_ibra_settlement"],
  "input_schema": {
    "type": "object",
    "properties": {
      "authority": { "type": "string", "x_null_distinct": true, "description": "Authority profile. Only the pinned regulator profile is supported; any other value, absent or null, is refused by name." },
      "cost_of_purchase_minor": { "type": "number", "x_null_distinct": true, "description": "Acquisition cost in integer minor units, at least 1. A present null or float is refused." },
      "cpr_bp": { "type": "number", "x_null_distinct": true, "description": "Contracted ceiling profit rate in whole basis points, 0 to 100000." },
      "tenor_months": { "type": "number", "x_null_distinct": true, "description": "Number of monthly instalments, 1 to 360." },
      "instalment_minor": { "type": "number", "x_null_distinct": true, "description": "Level monthly instalment in integer minor units, at least 1." },
      "selling_price_minor": { "type": "number", "x_null_distinct": true, "description": "Contracted selling price used by the schedule, not below the acquisition cost." },
      "selling_price_stated_minor": { "type": "number", "x_null_distinct": true, "description": "Optional stated price. When present it is emitted with the schedule price and the difference as a named residual." },
      "epr_periods": { "type": "array", "x_null_distinct": true, "description": "Optional prevailing-rate periods of from_month, epr_bp and instalment_minor. The first period starts at month 1 and months strictly increase." },
      "settlement_month": { "type": "number", "x_null_distinct": true, "description": "Optional month at which early settlement occurs." },
      "instalment_due_minor": { "type": "number", "x_null_distinct": true, "description": "Optional unpaid instalment at settlement, in minor units." },
      "early_settlement_charges": { "type": "array", "x_null_distinct": true, "description": "Optional recovery costs of cost_type and amount_minor. Permitted types: unrecovered_discount and unrecovered_initial_cost. Lost profit and marketing are refused." },
      "late_payment_minor": { "type": "number", "x_null_distinct": true, "description": "Optional pass-through late-payment amount, shown separately from the rebate." },
      "non_delivery": { "type": "object", "x_null_distinct": true, "description": "Optional non-delivery case: undisbursed_principal_minor and first_sign_month. Requires settlement_month." },
      "conventional_loan": { "type": "object", "x_null_distinct": true, "description": "Optional conventional comparison: principal_minor, annual_rate_bp, tawidh_minor and gharamah_minor." }
    }
  },
  "mcp_tool_definition": {
    "name": "compute_murabahah_ibra_settlement",
    "description": "Computes a deferred-price instalment schedule and the rebate on early settlement in integer minor units, including the variable-rate and non-delivery cases. Arithmetic only, not a ruling.",
    "inputSchema": {
      "type": "object",
      "properties": {
