        "instalment_minor": { "type": "number", "description": "Monthly instalment in minor units." },
        "selling_price_minor": { "type": "number", "description": "Contracted selling price in minor units." },
        "selling_price_stated_minor": { "type": "number", "description": "Optional stated selling price." },
        "epr_periods": { "type": "array", "description": "Optional prevailing-rate periods." },
        "settlement_month": { "type": "number", "description": "Optional early settlement month." },
        "instalment_due_minor": { "type": "number", "description": "Optional unpaid instalment." },
        "early_settlement_charges": { "type": "array", "description": "Optional permitted recovery costs." },
        "late_payment_minor": { "type": "number", "description": "Optional pass-through late charge." },
        "non_delivery": { "type": "object", "description": "Optional non-delivery case." },
        "conventional_loan": { "type": "object", "description": "Optional conventional comparison." }
      }
    },
