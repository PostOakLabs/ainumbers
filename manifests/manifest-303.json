{
  "version": "1.0.0",
  "tool_id": "dora-incident-classification-engine",
  "tool_number": 303,
  "category": "cat-22",
  "name": "DORA Incident Classification & Reporting Timeline Engine",
  "description": "Classifies ICT incidents against all 7 RTS 2024/1772 criteria. Compound Major logic (Condition A + B1/B2). Live 4h/72h/1-month countdown. ITS 2025/302 Annex I notification draft. AP2 JSON mandate. Client-side. Zero PII.",
  "path": "tools/303-dora-incident-classification-engine.html",
  "tags": ["DORA", "Incident Classification", "RTS 2024/1772", "ITS 2025/302", "AP2"],
  "ap2_export": true,
  "mcp": {
    "name": "classify_dora_ict_incident",
    "description": "Classify an ICT-related incident against DORA RTS 2024/1772 criteria and return Major/Significant/Minor result with reporting deadlines",
    "input_schema": {
      "type": "object",
      "properties": {
        "clients_affected": {"type":"integer","minimum":0},
        "total_client_base": {"type":"integer","minimum":1},
        "reputational_impact": {"type":"string","enum":["none","limited","moderate","major"]},
        "duration_hours": {"type":"number","minimum":0},
        "ongoing": {"type":"boolean"},
        "geographic_spread": {"type":"string","enum":["local","national","cross_border","global"]},
        "data_losses": {"type":"string","enum":["none","availability","integrity","confirmed_breach"]},
        "criticality_of_service": {"type":"string","enum":["non_critical","important","critical"]},
        "economic_impact_eur": {"type":"number","minimum":0},
        "classification_time_utc": {"type":"string","format":"date-time"},
        "member_state": {"type":"string"}
      },
      "required": ["clients_affected","total_client_base","criticality_of_service"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000
  },
  "regulatory_frameworks": ["EU 2022/2554","Commission Delegated Regulation (EU) 2024/1772","EU Regulation 2025/302"],
  "jurisdictions": ["EU","EEA"],
  "last_reviewed": "2025-05-01"
}
