{
  "tool_id": "515-collateral-swap-eligibility-validator",
  "version": "1.0.0",
  "title": "Collateral Swap Eligibility Validator",
  "description": "Validate a collateral swap (upgrade/downgrade trade) under GMSLA, GMRA, and SFTR Art 15 collateral reuse rules. Determine HQLA tier impact and regulatory eligibility.",
  "category": "capital-markets",
  "tags": ["collateral-swap","gmsla","gmra","sftr","hqla","upgrade","downgrade","canton","securities-lending"],
