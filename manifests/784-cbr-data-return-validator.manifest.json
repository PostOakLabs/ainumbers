{
  "tool_id": "784-cbr-data-return-validator",
  "version": "1.0.0",
  "title": "CBR Data Return Validator",
  "description": "Validates an aggregate correspondent-banking data return against an illustrative profile-driven template: required fields per profile, correspondent roll-forward, corridor sums against stated totals, period sanity, key-currency single-correspondent watch, concentration flags, and a message-quality readiness roll-up. Aggregate-only: any string leaf outside the enumerations is refused by path with no echo.",
  "category": "chaingraph",
  "tags": [
    "correspondent-banking",
    "de-risking",
    "data-return",
    "payments",
    "mcp:validate_cbr_data_return"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "profile",
      "institution_type",
      "institution_code",
      "period",
      "currencies"
    ],
    "properties": {
      "profile": {
        "type": "string",
        "enum": [
          "generic",
          "pacific"
        ],
        "description": "Template profile: generic uses the global metric set with USD, EUR, GBP as key currencies; pacific requires USD, AUD, NZD reported."
      },
      "institution_type": {
        "type": "string",
        "enum": [
          "bank",
          "mto",
          "other_non_bank"
        ],
        "description": "Reporting institution class."
      },
      "institution_code": {
        "type": "string",
        "pattern": "^FI-[0-9]{3}$",
        "description": "Profile-local pseudonymous institution code, FI-NNN form. No real names or identifiers."
      },
      "period": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "description": "Period start, YYYY-MM-DD."
          },
          "end": {
            "type": "string",
            "description": "Period end, YYYY-MM-DD, on or after start, span at most 400 days."
          }
        }
      },
      "currencies": {
        "type": "array",
        "minItems": 1,
        "description": "Per key currency: opening_correspondents, active_correspondents (closing), opened, terminated_restricted, corridors (country with outbound and inbound counts and values) and optional totals for the cross-check.",
        "items": {
          "type": "object",
          "required": [
            "currency",
            "opening_correspondents",
            "active_correspondents",
            "opened",
            "terminated_restricted",
            "corridors"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "description": "ISO 4217 alpha-3 code."
            },
            "opening_correspondents": {
              "type": "integer",
              "minimum": 0
            },
            "active_correspondents": {
              "type": "integer",
              "minimum": 0
            },
            "opened": {
              "type": "integer",
              "minimum": 0
            },
            "terminated_restricted": {
              "type": "integer",
              "minimum": 0
            },
            "corridors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "country",
                  "outbound_count",
                  "inbound_count",
                  "outbound_value",
                  "inbound_value"
                ],
                "properties": {
                  "country": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 corridor country."
                  },
                  "outbound_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "inbound_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "outbound_value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "inbound_value": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "totals": {
              "type": "object",
              "properties": {
                "outbound_count": {
                  "type": "integer"
                },
                "inbound_count": {
                  "type": "integer"
                },
                "outbound_value": {
                  "type": "number"
                },
                "inbound_value": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "message_quality": {
        "type": "object",
        "description": "Optional aggregate summaries from the address and LEI linters: messages_linted with fully_structured, hybrid and unstructured counts (must sum to messages_linted), and lei_linted with lei_valid.",
        "properties": {
          "messages_linted": {
            "type": "integer",
            "minimum": 0
          },
          "fully_structured": {
            "type": "integer",
            "minimum": 0
          },
          "hybrid": {
            "type": "integer",
            "minimum": 0
          },
          "unstructured": {
            "type": "integer",
            "minimum": 0
          },
          "lei_linted": {
            "type": "integer",
            "minimum": 0
          },
          "lei_valid": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "validate_cbr_data_return",
    "description": "Validates an aggregate correspondent-banking data return against an illustrative profile-driven template: required fields, roll-forward consistency, corridor sums, period sanity, key-currency and concentration flags, readiness roll-up. Aggregate-only: free-text leaves are refused by path with no echo.",
    "inputSchema": {
      "type": "object",
      "required": [
        "profile",
        "institution_type",
        "institution_code",
        "period",
        "currencies"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "generic",
            "pacific"
          ]
        },
        "institution_type": {
          "type": "string",
          "enum": [
            "bank",
            "mto",
            "other_non_bank"
          ]
        },
        "institution_code": {
          "type": "string"
        },
        "period": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "currencies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "message_quality": {
          "type": "object"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/784-cbr-data-return-validator.html",
    "function_name": "runCompute",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "source": "chaingraph/kernels/784-cbr-data-return-validator.kernel.mjs",
  "input_schema_provenance": "Top-level properties are exactly the policy_parameters members the kernel reads: profile, institution_type, institution_code, period, currencies, message_quality.",
  "author": "PostOakLabs",
  "license": "CC-BY-4.0",
