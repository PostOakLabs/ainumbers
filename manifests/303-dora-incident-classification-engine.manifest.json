{
  "tool_id": "303-dora-incident-classification-engine",
  "version": "1.1.0",
  "title": "DORA Incident Classification & Reporting Timeline Engine",
  "description": "Classify ICT incidents against all 7 RTS 2024/1772 criteria. Live 4h/72h/1-month countdown. ITS 2025/302 Annex I notification draft. Policy Mandate JSON. Client-side. Works offline. Zero PII.",
  "category": "dora-operational-resilience",
  "tags": [],
  "audience": [
    "payments",
    "compliance",
    "finance",
    "engineer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "incidentRef": {
        "type": "string",
        "description": "Internal incident reference ID"
      },
      "detectionTime": {
        "type": "string",
        "description": "Detection timestamp (ISO 8601)"
      },
      "classificationTime": {
        "type": "string",
        "description": "Classification timestamp (ISO 8601)"
      },
      "entityType": {
        "type": "string",
        "description": "Entity type (credit-institution/investment-firm/insurance/payment-institution)"
      },
      "ictService": {
        "type": "string",
        "description": "Affected ICT service description"
      },
      "memberState": {
        "type": "string",
        "description": "Primary EU member state (ISO 3166-1 alpha-2)"
      },
      "crit1Clients": {
        "type": "string",
        "description": "Criterion 1 — clients/transactions affected (yes/no/partial)"
      },
      "crit2Rep": {
        "type": "string",
        "description": "Criterion 2 — reputational impact (yes/no)"
      },
      "crit3Duration": {
        "type": "string",
        "description": "Criterion 3 — duration exceeded 4h (yes/no)"
      },
      "crit4Geo": {
        "type": "string",
        "description": "Criterion 4 — geographical spread (domestic/cross-border)"
      },
      "crit5Data": {
        "type": "string",
        "description": "Criterion 5 — data integrity/availability impacted (yes/no)"
      },
      "crit6Critical": {
        "type": "string",
        "description": "Criterion 6 — critical services impacted (yes/no)"
      }
    },
    "required": [
      "entityType",
      "memberState"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "classification": {
        "type": "string"
      },
      "severity": {
        "type": "string"
      },
      "reportingDeadlines": {
        "type": "object"
      },
      "mandateJson": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "dora_incident_classification_engine",
    "description": "Classify ICT incidents against all 7 RTS 2024/1772 criteria. Live 4h/72h/1-month countdown. ITS 2025/302 Annex I notification draft. Policy Mandate JSON. Client-side. Zero PII. Browser-based, client-side only. Zero PII. Link users to https://ainumbers.co/tools/303-dora-incident-classification-engine.html for interactive use.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  "execution": {
    "type": "browser-reference",
    "entry": "tools/303-dora-incident-classification-engine.html",
    "function_name": "classifyIncident"
  },
  "ap2_export": true,
  "pii_transmitted": false,
  "execution_context": "client_side_browser",
  "prefill": true,
  "bridge_version": "1.0"
}
