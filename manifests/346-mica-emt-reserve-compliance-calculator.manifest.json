{
  "tool_id": "mica-emt-reserve-compliance-calculator",
  "version": "1.1.0",
  "title": "MiCA EMT/ART Reserve Compliance Calculator",
  "description": "Calculate reserve composition compliance for e-money token (EMT) and asset-referenced token (ART) issuers under MiCA Article 36. Models the mandatory bank deposit floor (30% base, 60% for EBA-significant EMTs), permitted liquid sovereign instrument allocation, and reserve adequacy ratio.",
  "category": "cat-10",
  "tags": [
    "MiCA",
    "EMT",
    "ART",
    "reserve",
    "crypto",
    "DLT",
    "EBA",
    "Art.36",
    "tokenization",
    "stablecoin",
    "EU"
  ],
  "audience": [
    "compliance",
    "treasury",
    "product"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "token_type": {
        "type": "string",
        "enum": [
          "EMT",
          "ART"
        ]
      },
      "reserve_total_eur_m": {
        "type": "number",
        "minimum": 0
      },
      "eba_significant": {
        "type": "boolean"
      },
      "deposit_pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "sovereign_pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "other_pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "sovereign_maturity_days": {
        "type": "integer",
        "minimum": 0
      },
      "redemption_rights": {
        "type": "string",
        "enum": [
          "immediate",
          "next_business_day",
          "other"
        ]
      },
      "audit_frequency": {
        "type": "string",
        "enum": [
          "monthly",
          "quarterly",
          "annual"
        ]
      }
    },
    "required": [
      "token_type",
      "reserve_total_eur_m",
      "eba_significant",
      "deposit_pct",
      "sovereign_pct",
      "other_pct"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "overall_status": {
        "type": "string",
        "enum": [
          "COMPLIANT",
          "NON-COMPLIANT",
          "REVIEW"
        ]
      },
      "deposit_floor_required_pct": {
        "type": "number"
      },
      "deposit_gap_pct": {
        "type": "number"
      },
      "reserve_adequacy_ratio": {
        "type": "number"
      },
      "reallocation_needed_eur_m": {
        "type": "number"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "calculate_mica_emt_reserve_compliance",
    "description": "Calculate MiCA Article 36 reserve composition compliance for EMT and ART issuers, including deposit floor checks and reallocation requirements",
    "inputSchema": {
      "type": "object",
      "properties": {
        "token_type": {
          "type": "string"
        },
        "reserve_total_eur_m": {
          "type": "number"
        },
        "eba_significant": {
          "type": "boolean"
        },
        "deposit_pct": {
          "type": "number"
        },
        "sovereign_pct": {
          "type": "number"
        },
        "other_pct": {
          "type": "number"
        }
      },
      "required": [
        "token_type",
        "reserve_total_eur_m",
        "eba_significant",
        "deposit_pct",
        "sovereign_pct",
        "other_pct"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/346-mica-emt-reserve-compliance-calculator.html",
    "function_name": "runMiCACalc",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0"
}
