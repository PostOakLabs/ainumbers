{
  "tool_id": "realtime-ops-dashboard",
  "version": "1.0.0",
  "title": "Real-Time Ops Dashboard Template",
  "description": "Configurable mock A2A payment operations dashboard with live SLA tracking for FedNow, RTP, ACH, and SEPA Instant. Simulates TPM, latency, and failure rate metrics with configurable alert thresholds. Exports threshold configuration as an AP2 mandate.",
  "category": "ops-monitoring",
  "tags": [
    "ops",
    "dashboard",
    "SLA",
    "FedNow",
    "RTP",
    "ACH",
    "SEPA",
    "monitoring",
    "thresholds"
  ],
  "audience": [
    "ops",
    "engineer",
    "SRE"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "failRate_warn": {
        "type": "number",
        "description": "Failure rate warn threshold %"
      },
      "failRate_crit": {
        "type": "number",
        "description": "Failure rate critical threshold %"
      },
      "latency_warn_ms": {
        "type": "number",
        "description": "Latency warn threshold ms"
      },
      "latency_crit_ms": {
        "type": "number",
        "description": "Latency critical threshold ms"
      },
      "rail": {
        "type": "string",
        "enum": [
          "FedNow",
          "RTP",
          "ACH",
          "SEPA_Instant",
          "ALL"
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "current_tpm": {
        "type": "number"
      },
      "current_latency_ms": {
        "type": "number"
      },
      "current_fail_rate": {
        "type": "number"
      },
      "alert_status": {
        "type": "string",
        "enum": [
          "OK",
          "WARN",
          "CRIT"
        ]
      },
      "threshold_config": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "export_ops_threshold_config",
    "description": "Export the current ops dashboard alert threshold configuration as an AP2 mandate. Returns current metric values and the configured warn/critical thresholds for TPM, latency, and failure rate. Use when an agent needs to capture or apply ops monitoring configuration.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "failRate_warn": {
          "type": "number"
        },
        "failRate_crit": {
          "type": "number"
        },
        "latency_warn_ms": {
          "type": "number"
        },
        "latency_crit_ms": {
          "type": "number"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/14-realtime-ops-dashboard.html",
    "function_name": "exportAP2",
    "timeout_ms": 3000
  },
  "ap2_export": true
}
