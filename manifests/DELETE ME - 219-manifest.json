{
  "tool_id": "pacs008-cross-border-generator",
  "version": "1.0.0",
  "title": "pacs.008 Cross-Border Payload Generator & UETR Simulator",
  "description": "Generates ISO 20022 pacs.008.001.12 FIToFICstmrCdtTrf with RFC 4122 UUID v4 UETR, SR2026 schema validation, CBPR+ requirements check, and MT103 field mapping. Outputs downloadable pacs.008 XML and AP2 JSON payment instruction stub. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "ISO 20022",
    "pacs.008",
    "UETR",
    "CBPR+",
    "SR2026",
    "MT103",
    "SWIFT",
    "AP2"
  ],
  "audience": [
    "payments-engineer",
    "operations"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "amount": {
        "type": "number"
      },
      "currency": {
        "type": "string"
      },
      "purpose": {
        "type": "string"
      },
      "debtor_name": {
        "type": "string"
      },
      "debtor_iban": {
        "type": "string"
      },
      "debtor_bic": {
        "type": "string"
      },
      "creditor_name": {
        "type": "string"
      },
      "creditor_iban": {
        "type": "string"
      },
      "creditor_bic": {
        "type": "string"
      },
      "cbpr_validation": {
        "type": "string",
        "enum": [
          "yes",
          "no"
        ]
      }
    },
    "required": [
      "amount",
      "currency",
      "debtor_bic",
      "creditor_bic"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "uetr": {
        "type": "string"
      },
      "pacs008_xml": {
        "type": "string"
      },
      "mt103_mapping": {
        "type": "string"
      },
      "validation_results": {
        "type": "array"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "generate_pacs008_payload",
    "description": "Generates a CBPR+-compliant ISO 20022 pacs.008.001.12 payment message with UUID v4 UETR, SR2026 schema validation, and MT103 field mapping. Use when constructing cross-border SWIFT payment instructions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "debtor_bic": {
          "type": "string"
        },
        "creditor_bic": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "debtor_bic",
        "creditor_bic"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/219-pacs008-cross-border-generator.html",
    "function_name": "generatePacs008",
    "timeout_ms": 5000
  },
  "ap2_export": true
}