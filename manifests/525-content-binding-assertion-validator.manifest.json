{
  "tool_id": "art-128-content-binding-assertion-validator",
  "version": "1.0.0",
  "title": "Content Binding Assertion Validator",
  "description": "Validate hard-binding (tamper-evident asset hash match) vs soft-binding (watermark survives re-encode). Emits TAMPER_EVIDENT / SOFT_BINDING_ONLY / UNBOUND verdict. Terminal stage.",
  "category": "chaingraph",
  "tags": ["c2pa", "binding", "tamper-evident", "hash", "watermark", "content-credentials", "wave23"],
  "audience": ["compliance", "developer", "agent"],
  "input_schema": {
    "type": "object",
    "properties": {
      "binding_type": { "type": "string", "enum": ["hard", "soft", "both"] },
      "asset_bytes_hash": { "type": "string" },
      "claimed_hard_binding_hash": { "type": "string" },
      "soft_binding_identifier_present": { "type": "boolean" }
    },
    "required": ["binding_type"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "binding_type": { "type": ["string", "null"] },
      "hard_binding_matches": { "type": "boolean" },
      "tamper_evident": { "type": "boolean" },
      "soft_binding_present": { "type": "boolean" },
      "verdict": { "type": "string", "enum": ["TAMPER_EVIDENT", "SOFT_BINDING_ONLY", "UNBOUND"] }
    }
  },
  "mcp_tool_definition": {
    "name": "validate_content_binding_assertion",
    "description": "Validate hard-binding (tamper-evident asset hash match) vs soft-binding (watermark survives re-encode). Emits TAMPER_EVIDENT / SOFT_BINDING_ONLY / UNBOUND verdict. Terminal stage.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "binding_type": { "type": "string", "enum": ["hard", "soft", "both"] },
        "asset_bytes_hash": { "type": "string" },
        "claimed_hard_binding_hash": { "type": "string" },
        "soft_binding_identifier_present": { "type": "boolean" }
      },
      "required": ["binding_type"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-128-content-binding-assertion-validator.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
