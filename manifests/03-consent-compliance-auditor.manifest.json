{
  "tool_id": "consent-compliance-auditor",
  "version": "1.0.0",
  "title": "Consent Simulator + Compliance Auditor",
  "description": "Simulates an open banking consent flow and audits it against PSD2, UK PSD, CFPB 1033, and AU CDR rules. Flags scope violations, over-collection, renewal gaps, and generates a signed JWT receipt.",
  "category": "compliance-consent",
  "tags": [
    "consent",
    "PSD2",
    "open banking",
    "CFPB 1033",
    "CDR",
    "JWT",
    "compliance"
  ],
  "audience": [
    "compliance",
    "engineer",
    "product"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "scopes",
      "regime"
    ],
    "properties": {
      "scopes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "regime": {
        "type": "string",
        "enum": [
          "psd2",
          "uk",
          "us",
          "au"
        ]
      },
      "duration": {
        "type": "number",
        "description": "Consent duration in days"
      },
      "renewal": {
        "type": "string",
        "enum": [
          "auto",
          "explicit",
          "none"
        ]
      },
      "appName": {
        "type": "string"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "overall_score": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "pass_count": {
        "type": "number"
      },
      "warn_count": {
        "type": "number"
      },
      "fail_count": {
        "type": "number"
      },
      "jwt_generated": {
        "type": "boolean"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "audit_consent_compliance",
    "description": "Audit an open banking consent configuration against a specified regulatory regime. Returns compliance score, pass/warn/fail breakdown per rule, and a JWT receipt. Use when an agent needs to validate that a consent scope and duration configuration is regulatory-compliant.",
    "inputSchema": {
      "type": "object",
      "required": [
        "scopes",
        "regime"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regime": {
          "type": "string",
          "enum": [
            "psd2",
            "uk",
            "us",
            "au"
          ]
        },
        "duration": {
          "type": "number"
        },
        "renewal": {
          "type": "string"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/03-consent-compliance-auditor.html",
    "function_name": "runAudit",
    "timeout_ms": 3000
  },
  "ap2_export": true
}
