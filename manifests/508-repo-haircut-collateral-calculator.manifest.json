{
  "tool_id": "508-repo-haircut-collateral-calculator",
  "version": "1.0.0",
  "title": "On-Chain Repo Haircut & Collateral Mobility Calculator",
  "description": "Compute repo haircut, initial margin, and variation margin. Compare Canton 24/7 atomic valuation vs legacy weekend gap. Basel CRE22 comprehensive approach + d349 SFT minimum haircut floors + GMRA bilateral threshold.",
  "category": "capital-markets",
  "tags": [
    "canton",
    "repo",
    "haircut",
    "gmra",
    "sftr",
    "collateral",
    "sft",
    "basel",
    "247"
  ],
  "audience": [
    "repo-trader",
    "collateral-desk",
    "treasury",
    "capital-markets"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "collateral_type": {
        "type": "string",
        "enum": [
          "ust_10y",
          "ust_30y",
          "agency_mbs",
          "ig_corp_bond",
          "gilt_10y",
          "eu_sovereign"
        ],
        "default": "ust_10y",
        "description": "Collateral class (case-insensitive). Unrecognised values fall back to a 4.0 percent base haircut."
      },
      "notional_usd": {
        "type": "number",
        "description": "Repo notional in US dollars. A missing or non-numeric value is treated as 0, which yields zero margin."
      },
      "tenor": {
        "type": "string",
        "enum": [
          "overnight",
          "1w",
          "1m",
          "3m",
          "6m",
          "open_term"
        ],
        "default": "overnight",
        "description": "Repo tenor (case-insensitive). 6m and open_term add a roll-risk adjustment."
      },
      "counterparty_type": {
        "type": "string",
        "default": "bank",
        "description": "Counterparty type (case-insensitive). hedge_fund adds a counterparty surcharge; any other value, for example bank, adds none."
      },
      "canton247": {
        "type": "boolean",
        "description": "True to value on Canton 24/7 atomic settlement (no weekend-gap adjustment) when computing initial margin."
      },
      "cross_border": {
        "type": "boolean",
        "description": "True to add the cross-border adjustment."
      },
      "concentration_pct": {
        "type": "number",
        "description": "Collateral concentration in percent. Above 20 adds a concentration adjustment."
      }
    },
    "required": [
      "notional_usd"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "base_haircut_pct": {
        "type": "number"
      },
      "total_haircut_pct": {
        "type": "number"
      },
      "sft_floor_applied": {
        "type": "boolean"
      },
      "initial_margin": {
        "type": "number"
      },
      "vm_threshold": {
        "type": "number"
      },
      "canton_haircut_pct": {
        "type": "number"
      },
      "legacy_haircut_pct": {
        "type": "number"
      },
      "weekend_saving_pct": {
        "type": "number"
      },
      "flags": {
        "type": "array"
      }
    }
  },
