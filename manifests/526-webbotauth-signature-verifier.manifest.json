{
  "tool_id": "art-129-webbotauth-signature-verifier",
  "version": "1.0.0",
  "title": "Web Bot Auth Signature Verifier (RFC 9421)",
  "description": "Verify an RFC 9421 HTTP Message Signature for IETF Web Bot Auth (Ed25519). Reconstructs the signature base from covered components and @signature-params, verifies via crypto.subtle. Zero network, caller-supplied key. Emits ACCEPT or REFUSE.",
  "category": "chaingraph",
  "tags": ["rfc9421", "web-bot-auth", "ed25519", "http-message-signatures", "agent-identity", "wave24"],
  "audience": ["compliance", "developer", "agent"],
  "input_schema": {
    "type": "object",
    "properties": {
      "covered_components": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "value": { "type": "string" } }, "required": ["name", "value"] } },
      "signature_params": { "type": "string" },
      "signature_b64": { "type": "string" },
      "public_key_jwk": { "type": "object" },
      "alg": { "type": "string" },
      "expected_tag": { "type": "string" },
      "created": { "type": "number" },
      "now_unix": { "type": "number" },
      "max_age_s": { "type": "number" }
    },
    "required": ["covered_components", "signature_params", "signature_b64", "public_key_jwk", "alg"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "signature_cryptographically_valid": { "type": "boolean" },
      "alg_ok": { "type": "boolean" },
      "tag_ok": { "type": "boolean" },
      "fresh": { "type": ["boolean", "null"] },
      "verdict": { "type": "string", "enum": ["ACCEPT", "REFUSE"] }
    }
  },
  "mcp_tool_definition": {
    "name": "verify_webbotauth_signature",
    "description": "Verify an RFC 9421 HTTP Message Signature for IETF Web Bot Auth (Ed25519). Reconstructs signature base from covered_components + signature_params, verifies via crypto.subtle. Zero network. Emits ACCEPT or REFUSE.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "covered_components": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "value": { "type": "string" } }, "required": ["name", "value"] } },
        "signature_params": { "type": "string" },
        "signature_b64": { "type": "string" },
        "public_key_jwk": { "type": "object" },
        "alg": { "type": "string" },
        "expected_tag": { "type": "string" },
        "created": { "type": "number" },
        "now_unix": { "type": "number" },
        "max_age_s": { "type": "number" }
      },
      "required": ["covered_components", "signature_params", "signature_b64", "public_key_jwk", "alg"]
    }
  },
  "execution": {
