{
  "tool_id": "art-131-signature-agent-card-validator",
  "version": "1.0.0",
  "title": "Signature Agent Card Validator",
  "description": "Validate a Signature Agent Card (Cloudflare × Bedrock AgentCore registry format): required fields (name, operator, expected_request_rate, keys) present and all card key IDs resolve against a directory JWKS. Emits TRUSTED or UNTRUSTED.",
  "category": "chaingraph",
  "tags": ["web-bot-auth", "agent-card", "agent-identity", "cloudflare", "bedrock-agentcore", "wave24"],
  "audience": ["compliance", "developer", "agent"],
  "input_schema": {
    "type": "object",
    "properties": {
      "card": { "type": "object" },
      "directory_keyids": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["card", "directory_keyids"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "fields_ok": { "type": "boolean" },
      "keys_in_directory": { "type": "boolean" },
      "verdict": { "type": "string", "enum": ["TRUSTED", "UNTRUSTED"] },
      "missing_fields": { "type": "array", "items": { "type": "string" } },
      "unresolved_key_ids": { "type": "array", "items": { "type": "string" } }
    }
  },
  "mcp_tool_definition": {
    "name": "validate_signature_agent_card",
    "description": "Validate a Signature Agent Card: required fields + all card key IDs resolve against directory_keyids. Emits TRUSTED or UNTRUSTED.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "card": { "type": "object" },
        "directory_keyids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["card", "directory_keyids"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-131-signature-agent-card-validator.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
