{
  "tool_id": "art-793-government-stablecoin-acceptance",
  "version": "1.0.0",
  "title": "Government Stablecoin Acceptance Audit",
  "description": "Assesses a government acceptor's aggregate stablecoin receipt ledger against its written acceptance policy — eligible tokens, conversion window, unconverted holding cap, refund rule and custody — and reconciles tokens received, converted and credited in fiat line by line, reporting policy conformance, reconciliation breaks, peak unconverted exposure and an overall verdict. Aggregate per-day-per-token totals in integer minor units only; no payer data is accepted. Every policy parameter is caller-declared.",
  "category": "chaingraph",
  "tags": [
    "stablecoins",
    "government-finance",
    "reconciliation",
    "acceptance-policy",
    "mcp:assess_gov_stablecoin_accept"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "policy",
      "receipts"
    ],
    "properties": {
      "profile": {
        "type": "string",
        "description": "Policy profile. Only \"generic\" ships; every policy parameter is caller-declared."
      },
      "policy": {
        "type": "object",
        "description": "The written acceptance policy being audited against. Caller-declared.",
        "properties": {
          "eligible_tokens": {
            "type": "array",
            "description": "Eligible tokens: [{token_code, issuer_regime, reserve_attestation_ref?}]. Required, non-empty."
          },
          "conversion_window_hours": {
            "type": "integer",
            "description": "Maximum hours from receipt to conversion. Required, non-negative."
          },
          "max_unconverted_value": {
            "type": "integer",
            "description": "Maximum unconverted carrying value in minor units. Required, non-negative."
          },
          "refund_rule": {
            "type": "string",
            "description": "in_kind or fiat. Required."
          },
          "custody": {
            "type": "string",
            "description": "self or custodian. Required."
          },
          "fiat_tolerance_value": {
            "type": "integer",
            "description": "Fiat-credit tolerance in minor units. Optional, default 0."
          }
        }
      },
      "receipts": {
        "type": "array",
        "description": "Aggregate receipt rows, one per token per day, in non-decreasing day order per token: {token_code, day?, received_value, converted_value, fiat_credited_value, refunds_value, max_hours_to_conversion, conversion_rate_variance_bp}. Minor units."
      }
    }
  },
  "mcp_tool_definition": {
    "name": "assess_gov_stablecoin_accept",
    "description": "Assesses a government acceptor's aggregate stablecoin receipt ledger against its written acceptance policy and reconciles tokens received, converted and credited in fiat, with exposure while held. Aggregate-only inputs; no payer data.",
    "inputSchema": {
      "type": "object",
      "required": [
        "policy",
        "receipts"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "policy": {
          "type": "object"
        },
        "receipts": {
          "type": "array"
        }
      }
    }
  },
  "execution": {
