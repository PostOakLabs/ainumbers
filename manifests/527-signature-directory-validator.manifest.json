{
  "tool_id": "art-130-signature-directory-validator",
  "version": "1.0.0",
  "title": "HTTP Signatures Directory Validator",
  "description": "Validate a /.well-known/http-message-signatures-directory JWKS: path correctness, all keys OKP+Ed25519, and keyid resolution. Emits VALID or INVALID.",
  "category": "chaingraph",
  "tags": ["rfc9421", "web-bot-auth", "jwks", "well-known", "http-message-signatures", "agent-identity", "wave24"],
  "audience": ["compliance", "developer", "agent"],
  "input_schema": {
    "type": "object",
    "properties": {
      "well_known_path": { "type": "string" },
      "keyid": { "type": "string" },
      "directory_jwks": { "type": "object" }
    },
    "required": ["well_known_path", "keyid", "directory_jwks"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "path_ok": { "type": "boolean" },
      "all_keys_ok": { "type": "boolean" },
      "keyid_resolved": { "type": "boolean" },
      "verdict": { "type": "string", "enum": ["VALID", "INVALID"] },
      "errors": { "type": "array", "items": { "type": "string" } }
    }
  },
  "mcp_tool_definition": {
    "name": "validate_signature_directory",
    "description": "Validate a /.well-known/http-message-signatures-directory JWKS: path, all keys OKP+Ed25519, keyid resolution. Emits VALID or INVALID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "well_known_path": { "type": "string" },
        "keyid": { "type": "string" },
        "directory_jwks": { "type": "object" }
      },
      "required": ["well_known_path", "keyid", "directory_jwks"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-130-signature-directory-validator.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
