  "tags": [
    "c2pa",
    "provenance",
    "ingredient-tree",
    "content-credentials",
    "wave23"
  ],
  "audience": [
    "compliance",
    "developer",
    "agent"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "active_manifest_hash": {
        "type": "string"
      },
      "ingredients": {
        "type": "array"
      }
    },
    "required": [
      "active_manifest_hash",
      "ingredients"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tree_intact": {
        "type": "boolean"
      },
      "depth": {
        "type": "integer"
      },
      "edges": {
        "type": "array"
      },
      "broken_edges": {
        "type": "array"
      },
      "root_ok": {
        "type": "boolean"
      }
    }
  },
