{
  "tool_id": "art-125-provenance-ingredient-tree-resolver",
  "version": "1.0.0",
  "title": "Provenance Ingredient Tree Resolver",
  "description": "Walk the c2pa.ingredient parent-of tree; confirm each ingredient hashed_uri binding and nested manifest hash chains back to the active manifest; flag broken provenance edges. Emits intact/broken verdict.",
