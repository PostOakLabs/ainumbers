{
  "tool_id": "art-125-provenance-ingredient-tree-resolver",
  "version": "1.0.0",
  "title": "Provenance Ingredient Tree Resolver",
  "description": "Walk the c2pa.ingredient parent-of tree; confirm each ingredient hashed_uri binding and nested manifest hash chains back to the active manifest; flag broken provenance edges. Emits intact/broken verdict.",
  "category": "chaingraph",
  "tags": ["c2pa", "provenance", "ingredient-tree", "content-credentials", "wave23"],
  "audience": ["compliance", "developer", "agent"],
  "input_schema": {
    "type": "object",
    "properties": {
      "active_manifest_hash": { "type": "string" },
      "ingredients": { "type": "array" }
    },
    "required": ["active_manifest_hash", "ingredients"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tree_intact": { "type": "boolean" },
      "depth": { "type": "integer" },
      "edges": { "type": "array" },
      "broken_edges": { "type": "array" },
      "root_ok": { "type": "boolean" }
    }
  },
  "mcp_tool_definition": {
    "name": "resolve_provenance_ingredient_tree",
    "description": "Walk the c2pa.ingredient parent-of tree and confirm hashed_uri bindings and nested manifest hashes chain back to the active manifest. Emits intact/broken verdict.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "active_manifest_hash": { "type": "string" },
        "ingredients": { "type": "array" }
      },
      "required": ["active_manifest_hash", "ingredients"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/art-125-provenance-ingredient-tree-resolver.html",
    "function_name": "run",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "chaingraph": true
}
