{
  "tool_id": "business-loan-readiness-checker",
  "version": "1.0.0",
  "title": "Business Loan Readiness Checker",
  "description": "Scores SME loan readiness against underwriting criteria for four lender types: high street bank, challenger bank, fintech/alternative lender, and government-backed scheme. Provides gap analysis and readiness score per lender category. Client-side. Zero PII.",
  "category": "cat-20",
  "tags": ["SME", "loan readiness", "lender criteria", "gap analysis", "credit", "export"],
  "audience": ["SME owner", "finance director", "broker", "credit analyst"],
  "input_schema": {
    "type": "object",
    "required": ["currency", "revenue", "tradingMonths", "dscr", "creditHistory", "assetCoverage", "profitability", "loanPurpose"],
    "properties": {
      "currency":       { "type": "string", "enum": ["GBP","USD","EUR"] },
      "revenue":        { "type": "number", "minimum": 0, "description": "Annual revenue in selected currency" },
      "tradingMonths":  { "type": "integer", "minimum": 0, "description": "Months of trading history" },
      "dscr":           { "type": "number", "minimum": 0, "description": "Debt Service Coverage Ratio" },
      "creditHistory":  { "type": "string", "enum": ["clean","minor","ccj","significant","default"] },
      "assetCoverage":  { "type": "string", "enum": ["strong","moderate","light","none"] },
      "profitability":  { "type": "string", "enum": ["growing","stable","declining","loss"] },
      "loanPurpose":    { "type": "string", "enum": ["working_capital","equipment","expansion","property","acquisition","refinance"] }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "lenderScores": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "lender":  { "type": "string" },
            "score":   { "type": "number", "minimum": 0, "maximum": 100 },
            "verdict": { "type": "string", "enum": ["Ready","Likely","Unlikely","Not eligible"] },
            "gaps":    { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_business_loan_readiness",
    "description": "Score an SME's readiness for a business loan against four lender type criteria (high street bank, challenger bank, fintech, government-backed). Returns readiness score and gap analysis per lender type. Use before recommending a specific loan product or lender route.",
    "inputSchema": {
      "type": "object",
      "required": ["currency", "revenue", "tradingMonths", "dscr", "creditHistory", "assetCoverage", "profitability"],
      "properties": {
        "currency":      { "type": "string", "enum": ["GBP","USD","EUR"] },
        "revenue":       { "type": "number", "minimum": 0 },
        "tradingMonths": { "type": "integer", "minimum": 0 },
        "dscr":          { "type": "number", "minimum": 0 },
        "creditHistory": { "type": "string", "enum": ["clean","minor","ccj","significant","default"] },
        "assetCoverage": { "type": "string", "enum": ["strong","moderate","light","none"] },
        "profitability": { "type": "string", "enum": ["growing","stable","declining","loss"] }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/241-business-loan-readiness-checker.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": false
}
