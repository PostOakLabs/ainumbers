  "category": "cat-1",
  "tags": [
    "SEPA",
    "instant payments",
    "IPR",
    "NCA",
    "annual report",
    "VOP",
    "fee parity",
    "2024/886",
    "April 2026"
  ],
  "audience": [
    "compliance",
    "ops",
    "product"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "psp_type": {
        "type": "string"
      },
      "sct_sent": {
        "type": "number"
      },
      "sct_inst_sent": {
        "type": "number"
      },
      "vop_performed": {
        "type": "number"
      },
      "sct_fee": {
        "type": "number"
      },
      "sct_inst_fee": {
        "type": "number"
      }
    },
    "required": [
