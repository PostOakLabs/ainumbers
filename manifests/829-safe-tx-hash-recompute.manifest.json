{
  "tool_id": "829-safe-tx-hash-recompute",
  "version": "1.0.0",
  "title": "Safe Transaction Hash Recompute",
  "description": "Recomputes the domain hash, message hash and safeTxHash of a Safe transaction (versions 1.3.0, 1.4.1, 1.5.0) from pasted fields and decodes known calls from a fixed selector table. Flags delegatecall, admin calls, approvals and multiSend. Does not simulate execution and cannot tell you the destination contract is safe. Zero network.",
  "category": "chaingraph",
  "tags": [
    "safe",
    "multisig",
    "eip-712",
    "transaction-hash",
    "mcp:recompute_safe_tx_hash"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "version",
      "chainId",
      "safe",
      "to",
      "value",
      "operation",
      "safeTxGas",
      "baseGas",
      "gasPrice",
      "gasToken",
      "refundReceiver",
      "nonce"
    ],
    "properties": {
      "version": {
        "type": "string",
        "enum": [
          "1.3.0",
          "1.4.1",
          "1.5.0"
        ],
        "description": "Safe contract version (the VERSION constant). Versions before 1.3.0 are refused."
      },
      "chainId": {
        "type": "string",
        "description": "Chain id the Safe is deployed on (uint256, decimal or 0x-hex)."
      },
      "safe": {
        "type": "string",
        "description": "Address of the Safe that will execute the transaction (the EIP-712 verifyingContract), 20-byte hex."
      },
      "to": {
        "type": "string",
        "description": "Destination address, 20-byte hex."
      },
      "value": {
        "type": "string",
        "description": "Ether value in wei (uint256)."
      },
      "data": {
        "type": "string",
        "description": "Call data as hex (0x-prefixed or bare). Empty or 0x for a plain ether transfer. Up to 32768 bytes."
      },
      "operation": {
        "type": "string",
        "enum": [
          "0",
          "1"
        ],
        "description": "0 = call, 1 = delegatecall."
      },
      "safeTxGas": {
        "type": "string",
        "description": "safeTxGas (uint256)."
      },
      "baseGas": {
        "type": "string",
        "description": "baseGas (uint256)."
      },
      "gasPrice": {
        "type": "string",
        "description": "gasPrice (uint256)."
      },
      "gasToken": {
        "type": "string",
        "description": "gasToken address; the zero address for ether."
      },
      "refundReceiver": {
        "type": "string",
        "description": "refundReceiver address; the zero address for tx.origin."
      },
      "nonce": {
        "type": "string",
        "description": "Safe nonce (uint256)."
      }
    }
  },
