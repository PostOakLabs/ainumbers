  "mcp_tool_definition": {
    "name": "calculate_naic_rbc_ratio",
    "description": "Calculate a simplified NAIC Risk-Based Capital (RBC) ratio for a US P&C insurer. Computes asset risk charges (R0 affiliates 10%, R1 fixed income weighted rate, R2 equity 15%, R3 credit 5–10%) and underwriting risk charges (R4 reserves, R5 premium by line of business), applies the covariance square-root aggregation RBC_after_cov = R0 + sqrt(R1^2+R2^2+R3^2+R4^2+R5^2), derives Authorized Control Level RBC = RBC_after_cov/2, and returns the RBC ratio against the NAIC action levels (CAL 200%, RAL 150%, ACL 100%, MCL 70%). Simplified standard formula — indicative.",
    "inputSchema": {
      "type": "object",
      "required": [
        "surplus",
        "admittedDebt",
        "r1Base",
        "r1Rate",
        "r4Base",
        "r5Base",
        "lineSelect"
      ],
      "properties": {
        "surplus": {
          "type": "number"
        },
