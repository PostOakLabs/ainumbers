{
  "tool_id": "514-tokenized-fund-collateral-validator",
  "version": "1.0.0",
  "title": "Tokenized Fund Collateral Validator",
  "description": "Validate tokenized MMF / CNAV / LVNAV / VNAV fund shares as collateral. Applies SEC Rule 2a-7 (post-Oct 2024 amendments), EU MMFR (Regulation (EU) 2017/1131), and Basel LCR HQLA exclusion rules. Supports Canton Benji (FOBXX) and other on-chain platforms.",
  "category": "capital-markets",
  "tags": ["mmf","fund","collateral","sec-2a7","eu-mmfr","hqla","canton","lvnav","cnav","benji"],
  "audience": ["collateral-desk","treasury","risk","operations"],
  "mcp_tool_definition": {
    "name": "validate_fund_collateral",
    "description": "Validate tokenized MMF / CNAV / LVNAV / VNAV fund shares as collateral. Applies SEC Rule 2a-7, EU MMFR, and Basel LCR HQLA exclusion rules. Outputs eligibility determination, compliance flags, and pacs.008 payload.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "fund_name": {"type": "string"},
        "fund_type": {"type": "string", "enum": ["sec_govt_mmf","sec_retail_prime_mmf","sec_inst_prime_mmf","eu_cnav","eu_lvnav","eu_vnav","other_govt_fund"]},
        "nav_per_share": {"type": "number"},
        "units_held": {"type": "number"},
        "currency": {"type": "string", "enum": ["USD","EUR","GBP"]},
        "platform": {"type": "string", "enum": ["canton_benji","canton_other","other_dlt","traditional"]},
        "redemption_window": {"type": "string", "enum": ["instant","same_day","t1","t2_plus"]},
        "collateral_use": {"type": "string", "enum": ["repo_collateral","im_derivative","vm_derivative","lender_collateral","other"]},
        "wla_pct": {"type": "number"},
        "dla_pct": {"type": "number"}
      },
      "required": ["fund_type","nav_per_share","units_held","currency","collateral_use"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/514-tokenized-fund-collateral-validator.html",
    "function_name": "runFundCollateral",
    "timeout_ms": 3000
  },
  "ap2_export": true,
  "mandate_type": "collateral_mandate",
  "semantic_profile": "iso20022:pacs.008-subset",
  "dct_conformsTo": "https://ainumbers.co/chaingraph/profiles/iso20022/pacs008-subset.jsonld",
  "pii_transmitted": false,
  "execution_context": "client_side_browser",
  "prefill": true,
  "bridge_version": "1.0",
  "intake": true,
  "chaingraph_version": "0.3.1"
}
