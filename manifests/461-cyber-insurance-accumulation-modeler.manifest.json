      },
      "aggLimit": {
        "type": "number",
        "minimum": 0,
        "description": "Aggregate policy limit, total portfolio ($M)"
      },
      "mixRansomNum": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "description": "Ransomware/extortion trigger share (%)"
