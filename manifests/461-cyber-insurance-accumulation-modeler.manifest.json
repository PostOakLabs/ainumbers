        "description": "Primary industry sector"
      },
      "avgLimit": {
        "type": "number",
        "minimum": 0,
        "description": "Average policy limit ($M)"
      },
      "avgRetention": {
        "type": "number",
        "minimum": 0,
        "description": "Average attachment/retention ($M)"
      },
      "avgPremium": {
        "type": "number",
        "minimum": 0,
