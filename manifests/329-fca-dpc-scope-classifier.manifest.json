{
  "tool_id": "fca-dpc-scope-classifier",
  "version": "1.1.0",
  "title": "FCA DPC Scope & Authorisation Classifier",
  "description": "Determines whether a BNPL/DPC lender falls within the FCA regulatory perimeter under PS26/1 (effective 15 July 2026), TPR eligibility, and which authorisation pathway applies.",
  "category": "cat-2",
  "tags": [
    "FCA",
    "BNPL",
    "DPC",
    "PS26/1",
    "TPR",
    "authorisation",
    "CCA",
    "July 2026",
    "UK"
  ],
  "audience": [
    "compliance",
    "legal",
    "product"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "lender_type": {
        "type": "string",
        "enum": [
          "third_party",
          "merchant_own",
          "platform",
          "credit_broker"
        ]
      },
      "credit_product": {
        "type": "string"
      },
      "repayment_instalments": {
        "type": "string"
      },
      "repayment_months": {
        "type": "string"
      },
      "interest_charged": {
        "type": "string"
      },
      "merchant_relationship": {
        "type": "string"
      },
      "current_auth": {
        "type": "string"
      },
      "tpr_notified": {
        "type": "string"
      },
      "volume_gbp": {
        "type": "string"
      },
      "consumer_facing": {
        "type": "string"
      }
    },
    "required": [
      "lender_type",
      "credit_product",
      "repayment_instalments",
      "repayment_months",
      "interest_charged",
      "current_auth"
    ]
  },
  "output_schema": {
    "type": "object"
  },
  "mcp_tool_definition": {
    "name": "fca_dpc_scope_classifier",
    "description": "Classifies BNPL/DPC products under FCA PS26/1 regulatory perimeter. Returns in-scope determination, TPR eligibility, and authorisation pathway.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "lender_type": {
          "type": "string",
          "description": "Type of lender entity"
        },
        "repayment_instalments": {
          "type": "string",
          "description": "Number of instalments"
        },
        "repayment_months": {
          "type": "string",
          "description": "Repayment term in months"
        },
        "interest_charged": {
          "type": "string",
          "description": "Whether interest or charges apply"
        },
        "current_auth": {
          "type": "string",
          "description": "Current FCA authorisation status"
        }
      },
      "required": [
        "lender_type",
        "repayment_instalments",
        "repayment_months",
        "interest_charged"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/329-fca-dpc-scope-classifier.html",
    "function_name": "runClassifier",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0"
}
