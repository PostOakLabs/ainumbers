{
  "tool_id": "a2a-rail-command-center",
  "version": "1.1.0",
  "title": "A2A Rail Optimization Command Center",
  "description": "Five-stage A2A rail evaluation: rail recommendation → fee modelling → liquidity impact → compliance mapping → NPV/IRR business case. Produces an Nygard ADR implementation memo and AP2 rail mandate.",
  "category": "core-infrastructure",
  "tags": [
    "A2A",
    "rail",
    "FedNow",
    "RTP",
    "ACH",
    "SEPA",
    "optimization",
    "NPV",
    "IRR"
  ],
  "audience": [
    "treasury",
    "engineer",
    "finance"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "annualVolume": {
        "type": "number",
        "description": "Annual payment volume USD"
      },
      "avgTransaction": {
        "type": "number"
      },
      "currentRail": {
        "type": "string"
      },
      "primaryDriver": {
        "type": "string",
        "enum": [
          "cost",
          "speed",
          "compliance",
          "liquidity"
        ]
      },
      "jurisdiction": {
        "type": "string"
      },
      "implementationBudget": {
        "type": "number"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "recommended_rail": {
        "type": "string"
      },
      "selected_rail": {
        "type": "string"
      },
      "annual_saving": {
        "type": "number"
      },
      "net_liquidity_benefit": {
        "type": "number"
      },
      "npv": {
        "type": "number"
      },
      "irr": {
        "type": "number"
      },
      "payback_months": {
        "type": "number"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "optimize_a2a_rail",
    "description": "Evaluate and select the optimal A2A payment rail for a given volume, corridor, and business driver. Calculates fee savings, liquidity impact, compliance requirements, and NPV/IRR for the migration business case. Use when an agent needs to recommend or justify an A2A rail migration decision.",
    "inputSchema": {
      "type": "object",
      "required": [
        "annualVolume",
        "currentRail"
      ],
      "properties": {
        "annualVolume": {
          "type": "number"
        },
        "currentRail": {
          "type": "string"
        },
        "primaryDriver": {
          "type": "string"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/82-a2a-rail-command-center.html",
    "function_name": "exportAP2",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0"
}
