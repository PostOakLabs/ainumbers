{
  "tool_id": "785-qr-golive-readiness",
  "version": "1.0.0",
  "title": "QR Go-Live Readiness Assessor",
  "description": "Assesses a QR payment scheme's pilot, production, or cross-border go-live readiness through weighted blocking and advisory gates: participant certification, UAT completion, configuration sign-off, operating procedures, incident and support cover, communications, and cross-border link agreements, plus a Level One principles checklist (advisory only). Any blocking gate not met is NO_GO; a uat_summary with an open severity-1 defect or passed below mandatory fails the UAT gate; otherwise the weighted basis-point score sets GO at or above 9750 or GO_WITH_CONDITIONS below it. Weights override must stay within 0 to 5000 bp and sum to 10000 bp. Refusals: invalid phase, empty or unknown gates, invalid status, out-of-bounds weights, malformed uat_summary or principles. Synthetic inputs only; names no real participant or scheme operator.",
  "category": "chaingraph",
  "tags": [
    "qr",
    "instant-payments",
    "go-live",
    "readiness",
    "scheme",
    "mcp:assess_qr_golive_readiness"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "phase",
      "gates"
    ],
    "properties": {
      "phase": {
        "type": "string",
        "enum": [
          "pilot",
          "production",
          "cross_border"
        ],
        "description": "The go-live phase being assessed. Required."
      },
      "gates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "gate_id": {
              "type": "string",
              "enum": [
                "participant_certification",
                "uat_completion",
                "config_signoff",
                "operating_procedures",
                "support_cover",
                "communications",
                "link_agreements"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "met",
                "partially_met",
                "not_met",
                "not_applicable"
              ]
            },
            "evidence_ref": {
              "type": "string"
            }
          }
        },
        "description": "The submitted gate statuses. A gate absent from the array counts as not_met. Required."
      },
      "uat_summary": {
        "type": "object",
        "properties": {
          "mandatory_cases": {
            "type": "number"
          },
          "passed": {
            "type": "number"
          },
          "open_sev1": {
            "type": "number"
          }
        },
        "description": "Optional UAT exit-criteria summary; open_sev1 above 0 or passed below mandatory_cases fails the UAT gate."
      },
      "principles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "principle_id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "met",
                "partially_met",
                "not_met",
                "not_applicable"
              ]
            }
          }
        },
        "description": "Optional Level One principles checklist. Advisory only."
      },
      "weights": {
        "type": "object",
        "description": "Optional weight override in basis points, each within 0 to 5000 and summing to 10000 across applicable gates."
      }
    }
  },
  "mcp_tool_definition": {
    "name": "assess_qr_golive_readiness",
