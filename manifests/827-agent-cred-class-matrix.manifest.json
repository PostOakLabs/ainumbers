{
  "tool_id": "827-agent-cred-class-matrix",
  "version": "1.0.0",
  "title": "Agent Cred Class Matrix",
  "description": "Maps five agent payment credential classes (shared payment token, network agentic token, API-key card proxy, x402 EIP-3009 permit, wallet delegated session key) across scope, expiry, replay protection, revocability and what the agent can learn. Scope, expiry and replay cells chain to sibling verdicts from closed per-column sets; revocability and learn are declared facts from closed vocabularies; columns no cited source settles are marked unpinned and flagged for review.",
  "category": "chaingraph",
  "tags": [
    "agent-payments",
    "agent-credentials",
    "x402",
    "erc-7715",
    "mcp:compute_agent_cred_matrix"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "rail_verdict": {
        "type": "object",
        "properties": {
          "any_accepted": { "type": "boolean", "description": "Must equal the OR of the rail acceptances; a contradiction is refused as RAIL_VERDICT_INVALID." },
          "rails": {
            "type": "object",
            "properties": {
              "mastercard_agent_pay": { "type": "object", "properties": { "accepted": { "type": "boolean" }, "gaps": { "type": "array", "items": { "type": "string" } } } },
              "visa_tap": { "type": "object", "properties": { "accepted": { "type": "boolean" }, "gaps": { "type": "array", "items": { "type": "string" } } } },
              "web_bot_auth": { "type": "object", "properties": { "accepted": { "type": "boolean" }, "gaps": { "type": "array", "items": { "type": "string" } } } }
            },
            "description": "Payment rail trust crosswalk output shape (art-133)."
          }
        },
        "description": "Art-133 rail verdict consumed for the rail acceptance summary."
      },
      "classes": {
        "type": "object",
        "description": "Declare only the classes the deployment uses. Chained classes carry chain_sources with one sibling id per column from the closed per-column set; local classes carry local_facts from the closed vocabulary.",
        "properties": {
          "shared_payment_token": {
            "type": "object",
            "properties": {
              "chain_sources": {
                "type": "object",
                "properties": {
                  "scope": { "type": "string", "enum": ["acp-checkout-shared-payment-token-linter"] },
                  "expiry": { "type": "string", "enum": ["acp-checkout-shared-payment-token-linter"] },
                  "replay_protection": { "type": "string", "enum": ["acp-checkout-shared-payment-token-linter"] }
                }
              }
            }
          },
          "network_agent_token": {
            "type": "object",
            "properties": {
              "chain_sources": {
                "type": "object",
                "properties": {
                  "scope": { "type": "string", "enum": ["visa-vic-agent-token-scope-builder", "mastercard-agentic-token-builder"] },
                  "expiry": { "type": "string", "enum": ["visa-vic-agent-token-scope-builder", "mastercard-agentic-token-builder"] },
                  "replay_protection": { "type": "string", "enum": ["visa-vic-agent-token-scope-builder", "mastercard-agentic-token-builder"] }
                }
              }
            }
          },
          "x402_permit": {
            "type": "object",
            "properties": {
              "chain_sources": {
                "type": "object",
                "properties": {
                  "scope": { "type": "string", "enum": ["art-385-agent-token-scope-checker"] },
                  "expiry": { "type": "string", "enum": ["art-703-mandate-authorization-gate", "art-699-x402-permit2-evidence-recomputer"] },
                  "replay_protection": { "type": "string", "enum": ["art-699-x402-permit2-evidence-recomputer"] }
                }
              }
            }
          },
          "api_key_card_proxy": {
            "type": "object",
            "properties": {
              "local_facts": {
                "type": "object",
                "properties": {
                  "scope": { "type": "string", "enum": ["container_scoped_token_use", "tenant_wide_proxy_invoke"] },
                  "expiry": { "type": "string", "enum": ["unpinned_in_cited_sources"] },
                  "replay_protection": { "type": "string", "enum": ["fail_closed_single_forward"] }
                }
              }
            }
          },
          "wallet_session_key": {
            "type": "object",
            "properties": {
              "local_facts": {
                "type": "object",
                "properties": {
                  "scope": { "type": "string", "enum": ["counterparty_and_chain_scoped_grant"] },
                  "expiry": { "type": "string", "enum": ["expiry_rule_unix_timestamp"] },
                  "replay_protection": { "type": "string", "enum": ["unpinned_in_cited_sources"] }
                }
              }
            }
          }
        }
      },
      "revocation": {
        "type": "object",
        "description": "Per declared class: mechanism from the closed set plus time_bound boolean.",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "mechanism": { "type": "string", "enum": ["authoritative_party_revoke_call", "expiry_rule_only", "account_validation_state", "module_uninstall", "declared_not_revocable", "unknown_or_undeclared"] },
            "time_bound": { "type": "boolean" }
          }
        }
      },
      "learn": {
        "type": "object",
        "description": "Per declared class: five booleans describing what the agent can learn.",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "opaque_credential": { "type": "boolean" },
            "learns_identity": { "type": "boolean" },
            "learns_action": { "type": "boolean" },
            "publicly_visible": { "type": "boolean" },
            "credential_persisted_or_logged": { "type": "boolean" }
          }
        }
      }
    },
    "description": "Rail verdict, per-class declarations, and per-class revocation and learn facts."
  },
  "mcp_tool_definition": {
    "name": "compute_agent_cred_matrix",
    "description": "Builds the agent credential class matrix: one row per credential class across scope, expiry, replay protection, revocability and what the agent can learn, chaining to sibling verdicts and flagging every refusal or unpinned column for review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "rail_verdict": { "type": "object" },
        "classes": { "type": "object" },
        "revocation": { "type": "object" },
        "learn": { "type": "object" }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "chaingraph/827-agent-cred-class-matrix.html",
    "function_name": "runCompute",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "source": "chaingraph/kernels/827-agent-cred-class-matrix.kernel.mjs",
  "input_schema_provenance": "Top-level properties are exactly the policy_parameters members the kernel reads: rail_verdict, classes, revocation, learn. The enum values are the kernel's closed CHAIN_SOURCES, LOCAL_FACT_ENUMS and REVOCATION_MECHANISMS sets verbatim.",
  "author": "PostOakLabs",
  "license": "CC-BY-4.0",
  "input_example": {
    "rail_verdict": {
      "any_accepted": true,
      "rails": {
        "mastercard_agent_pay": { "accepted": false, "gaps": ["testnet-only-integration"] },
        "visa_tap": { "accepted": true, "gaps": [] },
        "web_bot_auth": { "accepted": false, "gaps": [] }
      }
    },
    "classes": {
      "shared_payment_token": { "chain_sources": { "scope": "acp-checkout-shared-payment-token-linter", "expiry": "acp-checkout-shared-payment-token-linter", "replay_protection": "acp-checkout-shared-payment-token-linter" } },
      "network_agent_token": { "chain_sources": { "scope": "visa-vic-agent-token-scope-builder", "expiry": "mastercard-agentic-token-builder", "replay_protection": "mastercard-agentic-token-builder" } },
      "x402_permit": { "chain_sources": { "scope": "art-385-agent-token-scope-checker", "expiry": "art-703-mandate-authorization-gate", "replay_protection": "art-699-x402-permit2-evidence-recomputer" } },
      "api_key_card_proxy": { "local_facts": { "scope": "container_scoped_token_use", "expiry": "unpinned_in_cited_sources", "replay_protection": "fail_closed_single_forward" } },
      "wallet_session_key": { "local_facts": { "scope": "counterparty_and_chain_scoped_grant", "expiry": "expiry_rule_unix_timestamp", "replay_protection": "unpinned_in_cited_sources" } }
    },
    "revocation": {
      "shared_payment_token": { "mechanism": "declared_not_revocable", "time_bound": true },
      "network_agent_token": { "mechanism": "authoritative_party_revoke_call", "time_bound": true },
      "x402_permit": { "mechanism": "authoritative_party_revoke_call", "time_bound": true },
      "api_key_card_proxy": { "mechanism": "authoritative_party_revoke_call", "time_bound": false },
      "wallet_session_key": { "mechanism": "authoritative_party_revoke_call", "time_bound": true }
    },
    "learn": {
      "shared_payment_token": { "opaque_credential": false, "learns_identity": false, "learns_action": true, "publicly_visible": false, "credential_persisted_or_logged": false },
      "network_agent_token": { "opaque_credential": false, "learns_identity": false, "learns_action": true, "publicly_visible": false, "credential_persisted_or_logged": false },
      "x402_permit": { "opaque_credential": false, "learns_identity": true, "learns_action": true, "publicly_visible": true, "credential_persisted_or_logged": false },
      "api_key_card_proxy": { "opaque_credential": false, "learns_identity": false, "learns_action": true, "publicly_visible": true, "credential_persisted_or_logged": false },
      "wallet_session_key": { "opaque_credential": true, "learns_identity": false, "learns_action": true, "publicly_visible": false, "credential_persisted_or_logged": false }
    }
  },
