{
  "tool_id": "basel-rwa-calculator",
  "version": "4.0.0",
  "title": "Basel III/IV RWA Credit Risk Calculator",
  "description": "Calculates Risk-Weighted Assets under the Basel III/CRR3 Standardised Approach. Covers all major exposure classes with full CRR3/Basel IV risk weight table. Produces capital requirement calculations and an AP2 risk parameter mandate.",
  "category": "treasury-strategy",
  "tags": [
    "Basel III",
    "Basel IV",
    "CRR3",
    "RWA",
    "credit risk",
    "capital",
    "SA",
    "regulatory capital"
  ],
  "audience": [
    "risk",
    "treasury",
    "compliance",
    "CFO"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "framework",
      "exposures"
    ],
    "properties": {
      "framework": {
        "type": "string",
        "enum": [
          "crr3",
          "b3"
        ],
        "description": "CRR3/Basel IV or Basel III SA"
      },
      "exposures": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "exposure_class": {
              "type": "string"
            },
            "rating": {
              "type": "string"
            },
            "ead": {
              "type": "number",
              "description": "Exposure At Default USD"
            }
          }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "total_ead": {
        "type": "number"
      },
      "total_rwa": {
        "type": "number"
      },
      "capital_req": {
        "type": "number",
        "description": "8% minimum capital requirement"
      },
      "tier1_min": {
        "type": "number"
      },
      "cet1_min": {
        "type": "number"
      },
      "avg_rw_pct": {
        "type": "number"
      },
      "output_floor": {
        "type": "number",
        "description": "72.5% output floor (CRR3)"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "calculate_basel_rwa",
    "description": "Calculate Risk-Weighted Assets and minimum capital requirements for a portfolio of exposures under Basel III SA or CRR3/Basel IV. Returns total RWA, capital requirement, and per-exposure breakdown. Use when an agent needs to compute regulatory capital for credit risk reporting.",
    "inputSchema": {
      "type": "object",
      "required": [
        "framework",
        "exposures"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "enum": [
            "crr3",
            "b3"
          ]
        },
        "exposures": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/201-basel-rwa-calculator.html",
    "function_name": "runRWA",
    "timeout_ms": 3000
  },
  "ap2_export": true
}
