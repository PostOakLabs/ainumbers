{
  "tool_id": "fca-consumer-duty-board-report-builder",
  "version": "1.1.0",
  "title": "FCA Consumer Duty Annual Board Report Builder",
  "description": "Build a structured annual Consumer Duty board report meeting FCA PS22/9 requirements. Deadline: July 31 2026. Encodes FCA April 2026 observations on good practice.",
  "category": "cat-2",
  "tags": [
    "FCA",
    "Consumer Duty",
    "PS22/9",
    "board report",
    "four outcomes",
    "regulatory compliance",
    "UK",
    "2026"
  ],
  "audience": [
    "compliance",
    "board",
    "governance",
    "risk"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "firm_type": {
        "type": "string"
      },
      "retail_customer_count": {
        "type": "integer",
        "minimum": 0
      },
      "reporting_period_end": {
        "type": "string"
      },
      "products_services_scope": {
        "type": "string"
      },
      "outcomes": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "board_approved": {
        "type": "boolean"
      },
      "board_challenge_minuted": {
        "type": "boolean"
      },
      "remediation_actions_identified": {
        "type": "boolean"
      }
    },
    "required": [
      "firm_type",
      "outcomes"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "duty_score": {
        "type": "number"
      },
      "risk_rating": {
        "type": "string"
      },
      "report_text": {
        "type": "string"
      },
      "fca_observations_triggered": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "build_fca_consumer_duty_board_report",
    "description": "Build a structured FCA Consumer Duty annual board report and score overall duty compliance",
    "inputSchema": {
      "type": "object",
      "properties": {
        "firm_type": {
          "type": "string"
        },
        "retail_customer_count": {
          "type": "integer"
        },
        "outcomes": {
          "type": "array"
        }
      },
      "required": [
        "firm_type",
        "outcomes"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/347-fca-consumer-duty-board-report-builder.html",
    "function_name": "buildReport",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "prefill": true,
  "bridge_version": "1.0"
}
