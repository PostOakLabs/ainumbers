              "fatf_category": {"type": "string", "enum": ["fatf_member_compliant","fatf_member_monitored","fatf_grey_list","fatf_black_list","non_fatf_member"]},
              "pep": {"type": "boolean"},
              "adverse_media": {"type": "boolean"},
