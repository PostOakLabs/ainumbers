      "your_cost_basis_usd": { "type": ["number", "null"] },
      "liquidation_preference_usd": { "type": ["number", "null"] },
      "layers": {
        "type": ["array", "null"],
        "items": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
