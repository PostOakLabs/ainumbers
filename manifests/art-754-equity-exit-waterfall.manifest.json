{
  "tool_id": "art-754-equity-exit-waterfall",
  "version": "1.0.0",
  "title": "Equity Exit Waterfall Modeler",
  "description": "Equity exit proceeds after a liquidation-preference waterfall for startup employees and founders: the preference stack layer by layer, non-participating conversion or capped participation, the common pool, your gross and net proceeds after option strike, taxable gain per IRC §1001 and the break-even exit valuation. Port of Apex #141 (al_id AL-148). Port of ApexLogics tool 141-equity-exit-waterfall (https://apexlogics.org/tools/141-equity-exit-waterfall/ fetched 2026-10-06, AL-148), tasking APEXPORT-141 (GRADES PASS-PENDING-XV 2026-10-07, Builder-verifies-at-land 18/18 vectors re-executed 2026-10-21), landed by APEX-PORT-141-LAND-1.",
  "category": "chaingraph",
  "tags": [
    "equity",
    "waterfall",
    "liquidation-preference",
    "startup",
    "exit",
    "stock-options",
    "mcp:calc_equity_exit_waterfall"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "exit_valuation_usd",
      "total_preferred_invested_usd",
      "preferred_ownership_pct",
      "liquidation_preference_multiple",
      "participation_type",
      "participation_cap_multiple",
      "your_role",
      "your_ownership_pct",
      "your_option_strike_total_usd",
      "your_cost_basis_usd"
    ],
    "properties": {
      "exit_valuation_usd": {
        "type": "number",
        "description": "Total exit valuation in USD. Must be positive; a value <= 0 is refused with REFUSED_NON_POSITIVE_EXIT."
      },
      "total_preferred_invested_usd": {
        "type": "number",
        "description": "Aggregate liquidation preference amount (total preferred invested) in USD."
      },
      "preferred_ownership_pct": {
        "type": "number",
        "description": "Preferred ownership percentage (fully-diluted), 0-100. Apex control reads 0-100 and divides by 100."
      },
      "liquidation_preference_multiple": {
        "type": "number",
        "description": "Liquidation preference multiple (e.g., 1, 1.5, 2, 3)."
      },
      "participation_type": {
        "type": "string",
        "enum": [
          "non",
          "full",
          "capped"
        ],
        "description": "Participation type: 'non' (non-participating, converts when pro-rata strictly exceeds the preference), 'full' (full participating), or 'capped' (capped participating)."
      },
      "participation_cap_multiple": {
        "type": "number",
        "description": "Participation cap as multiple of invested (e.g., 3 means 3x invested). Used only for capped participation."
      },
      "your_role": {
        "type": "string",
        "enum": [
          "common",
          "founder",
          "employee",
          "preferred"
        ],
        "description": "Your role: 'common', 'founder', 'employee', or 'preferred'. Preferred role takes its share of preferred total; break-even exit is 0 for preferred (Apex behavior, DIFFERS-04)."
      },
      "your_ownership_pct": {
        "type": "number",
        "description": "Your ownership percentage (fully-diluted), 0-100."
      },
      "your_option_strike_total_usd": {
        "type": "number",
        "description": "Total option exercise cost in USD. Enter 0 for RSAs or vested stock. Net proceeds are floored at 0 after strike."
      },
      "your_cost_basis_usd": {
        "type": "number",
        "description": "Your cost basis for tax gain calculation in USD. Taxable gain = max(0, net proceeds - cost basis) per IRC §1001."
      }
    }
  },
