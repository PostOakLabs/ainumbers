        },
        "your_role": {
          "type": "string",
          "description": "Your role: 'common', 'founder', 'employee', or 'preferred'.",
          "enum": ["common", "founder", "employee", "preferred"]
        },
        "your_ownership_pct": {
          "type": "number",
          "description": "Your ownership percentage (fully-diluted), 0-100."
        },
        "your_option_strike_total_usd": {
          "type": "number",
          "description": "Total option exercise cost in USD. Enter 0 for RSAs or vested stock."
        },
        "your_cost_basis_usd": {
          "type": "number",
          "description": "Your cost basis for tax gain calculation in USD."
        }
      }
    },
    "annotations": {
      "readOnlyHint": true
    }
  },
  "outputSchema": {
