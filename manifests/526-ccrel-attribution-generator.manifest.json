{
  "tool_id": "526-ccrel-attribution-generator",
  "version": "1.0.0",
  "title": "ccREL Attribution Generator",
  "description": "Generates Creative Commons attribution notices in three formats: TASL (Title, Author, Source, License) plain text, ccREL JSON-LD structured data, and ccREL RDFa HTML snippet. Supports all CC 4.0 and CC0 license variants. Runs entirely client-side with no network calls.",
  "category": "cat-11",
  "tags": ["creative commons","ccrel","attribution","license","json-ld","rdfa","tasl","cc0","cc-by","nft","tokenization","ip licensing","open license"],
  "audience": ["creator","engineer","legal","product"],
  "input_schema": {
    "type": "object",
    "required": ["title","creator","source_url","license"],
    "properties": {
      "title": { "type": "string", "description": "Title of the work" },
      "creator": { "type": "string", "description": "Name of the creator or rights holder" },
      "source_url": { "type": "string", "description": "URL where the original work can be found" },
      "license": {
        "type": "string",
        "enum": ["CC0-1.0","CC-BY-4.0","CC-BY-SA-4.0","CC-BY-ND-4.0","CC-BY-NC-4.0","CC-BY-NC-SA-4.0","CC-BY-NC-ND-4.0"],
        "description": "Creative Commons license identifier"
      },
      "work_url": { "type": "string", "description": "Optional canonical URL for the work itself (if different from source)" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "tasl": { "type": "string", "description": "TASL attribution line (plain text)" },
      "json_ld": { "type": "string", "description": "ccREL JSON-LD block (application/ld+json)" },
      "rdfa": { "type": "string", "description": "ccREL RDFa HTML snippet" }
    }
  },
  "mcp_tool_definition": {
    "name": "generate_ccrel_attribution",
    "description": "Generates Creative Commons attribution notices in TASL plain text, ccREL JSON-LD, and ccREL RDFa formats for a given work. Supports all CC 4.0 and CC0 license variants. No network calls.",
    "inputSchema": {
      "type": "object",
      "required": ["title","creator","source_url","license"],
      "properties": {
        "title": { "type": "string" },
        "creator": { "type": "string" },
        "source_url": { "type": "string" },
        "license": { "type": "string", "enum": ["CC0-1.0","CC-BY-4.0","CC-BY-SA-4.0","CC-BY-ND-4.0","CC-BY-NC-4.0","CC-BY-NC-SA-4.0","CC-BY-NC-ND-4.0"] },
        "work_url": { "type": "string" }
      }
    }
  },
  "execution": {
    "type": "browser-reference",
    "entry": "tools/526-ccrel-attribution-generator.html",
    "function_name": "generateAttribution"
  },
  "ap2_export": false,
  "pii_transmitted": false,
  "execution_context": "client_side_browser"
}
