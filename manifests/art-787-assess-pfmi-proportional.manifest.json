        "type": "boolean",
        "description": "Adds the linked fast payment system governance module (CPMI Oct 2024, section 4); operator role only."
      },
      "ratings": {
        "type": "array",
        "description": "Per-principle (operator) or per-responsibility (authority) entries { id, rating, evidence_ref?, target_date? }. Rating is observed, broadly_observed, partly_observed, not_observed or not_applicable."
      }
    }
  },
