{
  "tool_id": "art-704-ai-token-spend",
  "version": "1.0.0",
  "title": "AI Token Spend",
  "description": "Monthly AI token spend estimator and cross-model comparator: per-model monthly cost, cost per request, the component breakdown, and a cheapest-first ranking, priced from a dated price table by an as_of date. Integer USD micros per million tokens with an overflow-safe floor-split cost formula. Refuses ambiguous price entries, missing component prices and cap overruns with named reasons. Prices are an input, never kernel constants: the default is the dated 2026-10-04 provider-page snapshot.",
  "category": "chaingraph",
  "tags": [
    "compliance_mandate",
    "ai-spend",
    "token-pricing",
    "llm-cost",
    "budgeting",
    "price-table",
    "dated-snapshot",
    "integer-minor-units",
    "mcp:estimate_ai_token_spend"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "as_of",
      "usage",
      "price_table",
      "compare"
    ],
    "properties": {
      "as_of": {
        "type": "string",
        "description": "Pricing date, a real calendar date as YYYY-MM-DD. The node reads no clock; an entry applies when effective_from <= as_of <= effective_through."
      },
      "usage": {
        "type": "object",
        "description": "Requests per month, input and output tokens per request, cached-input and batch/long-context shares in bp, cache-write tokens with a 5m or 1h TTL."
      },
      "price_table": {
        "type": "object",
        "description": "Dated snapshot: snapshot_verified_on, currency USD, unit usd_micros_per_million_tokens, and models[] with tier, effective dates and micros prices."
      },
      "compare": {
        "type": "array",
        "description": "Model names to price and rank, cheapest first; ties break by the model string."
      }
    }
  },
