{
  "tool_id": "art-593-webbotauth-nonce-replay-check",
  "version": "1.0.0",
  "title": "Web Bot Auth Nonce & Replay-Window Checker",
  "description": "Check a Visa TAP-shaped nonce for format (minimum entropy, base64url), freshness against the created/expires window (capped at TAP's 8-minute spread), and an optional caller-supplied seen-nonce record. Zero network, caller-supplied inputs only. Emits ACCEPT or REFUSE. Replay prevention depends on the caller supplying an accurate seen-nonce record from its own storage — this verifier is stateless and cannot detect replay on its own.",
  "category": "chaingraph",
  "tags": [
    "visa-tap",
    "rfc9421",
    "web-bot-auth",
    "nonce",
    "replay-defense",
    "agent-identity"
  ],
  "audience": [
    "compliance",
    "developer",
    "agent"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "nonce": {
        "type": "string"
      },
      "created": {
        "type": "number"
      },
      "expires": {
        "type": "number"
      },
      "now_unix": {
        "type": "number"
      },
      "max_age_s": {
        "type": "number"
      },
      "seen_nonces": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "nonce_already_used": {
        "type": "boolean"
      }
    },
    "required": [
      "nonce",
      "created",
      "expires",
      "now_unix"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "format_ok": {
        "type": "boolean"
      },
      "spread_ok": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "fresh": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "already_used": {
        "type": "boolean"
      },
      "nonce_valid": {
        "type": "boolean"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "ACCEPT",
          "REFUSE"
        ]
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_webbotauth_nonce_replay",
    "description": "Check a Visa TAP-shaped nonce for format, freshness against an 8-minute created/expires window, and an optional caller-supplied seen-nonce record. Stateless — replay prevention depends on the caller's own storage.",
    "inputSchema": {
      "type": "object",
