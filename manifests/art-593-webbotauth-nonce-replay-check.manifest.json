          "type": "number"
        },
        "now_unix": {
          "type": "number"
        },
        "max_age_s": {
          "type": "number"
        },
        "seen_nonces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nonce_already_used": {
          "type": "boolean"
        }
      },
      "required": [
        "nonce",
        "created",
        "expires",
        "now_unix"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
