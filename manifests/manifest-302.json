{
  "version": "1.0.0",
  "tool_id": "dora-cif-identifier",
  "tool_number": 302,
  "category": "cat-22",
  "name": "DORA CIF Function Identifier & Classifier",
  "description": "T1/T2/T3 three-tier critical ICT function classification engine. RTO assessment, TLPT scope flagging, AP2 JSON and Markdown export. Client-side. Zero PII.",
  "path": "tools/302-dora-cif-identifier.html",
  "tags": [
    "DORA",
    "CIF",
    "Critical Functions",
    "Classification",
    "AP2"
  ],
  "ap2_export": true,
  "mcp": {
    "name": "classify_dora_cif",
    "description": "Classify ICT functions into DORA CIF tiers (T1/T2/T3) and assess TLPT scope",
    "input_schema": {
      "type": "object",
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "function_name": {
                "type": "string"
              },
              "client_facing": {
                "type": "boolean"
              },
              "rto_hours": {
                "type": "number"
              },
              "revenue_dependent": {
                "type": "boolean"
              },
              "substitutability": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        }
      },
      "required": [
        "functions"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000,
    "entry": "tools/302-dora-cif-identifier.html"
  },
  "regulatory_frameworks": [
    "EU 2022/2554"
  ],
  "jurisdictions": [
    "EU",
    "EEA"
  ],
  "last_reviewed": "2025-05-01"
}
