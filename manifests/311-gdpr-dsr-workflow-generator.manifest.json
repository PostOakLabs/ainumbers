    "compliance",
    "zero-PII",
    "export",
    "AP2"
  ],
  "audience": [
    "compliance",
    "legal",
    "dpo",
    "operations"
  ],
  "input_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "jurisdiction",
      "request_type",
      "data_category",
      "requestor_type",
      "org_type"
    ],
    "properties": {
      "jurisdiction": {
        "type": "string",
        "enum": [
          "eu-gdpr",
          "uk-gdpr",
          "both",
          "ccpa"
        ]
      },
      "request_type": {
        "type": "string",
        "enum": [
          "access",
          "erasure",
          "portability",
          "rectification",
          "objection",
          "restriction",
          "automated"
        ]
      },
      "data_category": {
        "type": "string",
        "enum": [
          "payment",
          "transaction",
          "biometric",
          "special",
          "standard"
        ]
      },
      "requestor_type": {
        "type": "string",
        "enum": [
          "consumer",
          "employee",
          "representative"
        ]
      },
      "org_type": {
        "type": "string",
        "enum": [
          "controller",
          "processor",
          "joint"
        ]
      },
      "request_date": {
        "type": "string",
        "format": "date",
