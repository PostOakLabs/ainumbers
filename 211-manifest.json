{
  "tool_id": "fx-hedging-instrument-comparison",
  "version": "1.0.0",
  "title": "FX Hedging Instrument Comparison",
  "description": "Compares FX hedging instruments: deliverable forward, NDF, vanilla FX option, participating forward, zero-cost collar. Outputs payoff diagrams, premium cost, hedge effectiveness, option Greeks (Garman-Kohlhagen), and AP2 JSON hedging policy. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "FX hedge",
    "forward",
    "NDF",
    "option",
    "collar",
    "Greeks",
    "AP2",
    "export"
  ],
  "audience": [
    "treasury",
    "payments-engineer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "instrument": {
        "type": "string",
        "enum": [
          "forward",
          "ndf",
          "option",
          "participating",
          "collar"
        ]
      },
      "notional": {
        "type": "number"
      },
      "spot": {
        "type": "number"
      },
      "tenor_months": {
        "type": "integer"
      },
      "strike": {
        "type": "number"
      },
      "implied_vol_pct": {
        "type": "number"
      },
      "rate_base_pct": {
        "type": "number"
      },
      "rate_quote_pct": {
        "type": "number"
      }
    },
    "required": [
      "instrument",
      "notional",
      "spot",
      "tenor_months"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "instruments": {
        "type": "array"
      },
      "selected_instrument": {
        "type": "object"
      },
      "greeks": {
        "type": "object"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "compare_fx_hedging_instruments",
    "description": "Compares FX hedging instruments by payoff, premium, effectiveness, and Greeks using Garman-Kohlhagen model. Use when selecting hedging strategy for a currency exposure. Outputs AP2 JSON hedging policy.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "instrument": {
          "type": "string"
        },
        "notional": {
          "type": "number"
        },
        "spot": {
          "type": "number"
        },
        "tenor_months": {
          "type": "integer"
        },
        "strike": {
          "type": "number"
        }
      },
      "required": [
        "instrument",
        "notional",
        "spot",
        "tenor_months"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/211-fx-hedging-instrument-comparison.html",
    "function_name": "runComparison",
    "timeout_ms": 5000
  },
  "ap2_export": true
}