{
  "tool_id": "pay-by-bank-prototyper",
  "version": "1.0.0",
  "title": "Pay-by-Bank Checkout Prototyper + Conversion Insights",
  "description": "Interactive checkout flow prototyper for pay-by-bank implementations. Configures bank selection, consent, confirmation, and success screens with conversion scoring, drop-off funnel analysis, and UX insight recommendations.",
  "category": "ops-monitoring",
  "tags": [
    "pay-by-bank",
    "checkout",
    "UX",
    "conversion",
    "open banking",
    "A2A"
  ],
  "audience": [
    "product",
    "engineer",
    "designer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "brandName": {
        "type": "string"
      },
      "accentColor": {
        "type": "string"
      },
      "bankCount": {
        "type": "number",
        "description": "Number of banks in selector"
      },
      "showLogos": {
        "type": "boolean"
      },
      "consentStyle": {
        "type": "string",
        "enum": [
          "inline",
          "modal",
          "redirect"
        ]
      },
      "cta": {
        "type": "string",
        "description": "Primary CTA button label"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "conversion_score": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "friction_points": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "recommendations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "prototype_pay_by_bank_checkout",
    "description": "Generate a pay-by-bank checkout configuration with conversion score, friction point analysis, and UX recommendations. Use when an agent needs to evaluate or configure a bank payment checkout flow.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "brandName": {
          "type": "string"
        },
        "consentStyle": {
          "type": "string"
        },
        "bankCount": {
          "type": "number"
        }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/08-pay-by-bank-prototyper.html",
    "function_name": "renderAll",
    "timeout_ms": 3000
  },
  "ap2_export": true
}