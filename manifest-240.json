{
  "tool_id": "working-capital-gap-calculator",
  "version": "1.0.0",
  "title": "Working Capital Gap Calculator",
  "description": "Calculates the Cash Conversion Cycle (CCC = AR Days + Inventory Days − AP Days) and derives the working capital funding gap. Outputs sector-adjusted risk tier, ±20% revenue sensitivity, and ranked financing recommendations. Client-side. Zero PII.",
  "category": "cat-20",
  "tags": ["working capital", "CCC", "cash conversion cycle", "SME", "financing", "AP2", "export"],
  "audience": ["finance director", "CFO", "SME owner", "treasury analyst"],
  "input_schema": {
    "type": "object",
    "required": ["currency", "sector", "annualRevenue", "arDays", "inventoryDays", "apDays"],
    "properties": {
      "currency":      { "type": "string", "enum": ["GBP","USD","EUR"] },
      "sector":        { "type": "string", "description": "Industry sector for benchmark comparison" },
      "annualRevenue": { "type": "number", "minimum": 0 },
      "arDays":        { "type": "number", "minimum": 0, "description": "Average accounts receivable days outstanding" },
      "inventoryDays": { "type": "number", "minimum": 0, "description": "Average inventory holding days" },
      "apDays":        { "type": "number", "minimum": 0, "description": "Average accounts payable days" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ccc":                { "type": "number", "description": "Cash Conversion Cycle in days" },
      "workingCapitalGap":  { "type": "number", "description": "Funding gap in selected currency" },
      "riskTier":           { "type": "string", "enum": ["Low","Moderate","Elevated","High"] },
      "sensitivityMinus20": { "type": "number" },
      "sensitivityPlus20":  { "type": "number" },
      "financingOptions":   { "type": "array", "items": { "type": "string" } }
    }
  },
  "mcp_tool_definition": {
    "name": "calculate_working_capital_gap",
    "description": "Calculate the Cash Conversion Cycle and working capital funding gap for an SME. Returns CCC in days, currency-denominated gap, sector-adjusted risk tier, revenue sensitivity scenarios, and ranked financing instrument recommendations. Use as the anchor diagnostic before recommending invoice finance, RBF, or overdraft products.",
    "inputSchema": {
      "type": "object",
      "required": ["currency", "sector", "annualRevenue", "arDays", "inventoryDays", "apDays"],
      "properties": {
        "currency":      { "type": "string", "enum": ["GBP","USD","EUR"] },
        "sector":        { "type": "string" },
        "annualRevenue": { "type": "number", "minimum": 0 },
        "arDays":        { "type": "number", "minimum": 0 },
        "inventoryDays": { "type": "number", "minimum": 0 },
        "apDays":        { "type": "number", "minimum": 0 }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/240-working-capital-gap-calculator.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
