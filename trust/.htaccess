# TRUST-PAGE-CUT-1: index.html and pa-coexistence.html were deleted from this
# directory. With no DirectoryIndex left, Apache would serve an autoindex file
# listing at /trust/ — turn that off and point the removed URLs at the technical
# doc that survives, so old links land somewhere useful instead of a 404.
Options -Indexes

RedirectMatch 301 ^/trust/(index\.html)?$ /trust/network-behavior.html
RedirectMatch 301 ^/trust/pa-coexistence\.html$ /trust/network-behavior.html
