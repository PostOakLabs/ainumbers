{
  "tool_id": "invoice-finance-eligibility",
  "version": "1.0.0",
  "title": "Invoice Finance Eligibility Assessor",
  "description": "Assesses SME eligibility for invoice discounting, factoring, and selective invoice finance based on debtor concentration, invoice value, payment terms, and debtor creditworthiness. Returns maximum funding availability, advance rate, and fee cost model. Client-side. Zero PII.",
  "category": "cat-20",
  "tags": ["invoice finance", "factoring", "invoice discounting", "SME", "debtor concentration", "export"],
  "audience": ["SME owner", "finance director", "CFO", "broker"],
  "input_schema": {
    "type": "object",
    "required": ["currency", "monthlyInvoices", "annualTurnover", "paymentTerms", "debtorConc", "disputeRate", "debtorType", "tradingYears"],
    "properties": {
      "currency":        { "type": "string", "enum": ["GBP","USD","EUR"] },
      "monthlyInvoices": { "type": "number", "minimum": 0, "description": "Average monthly B2B invoice value outstanding" },
      "annualTurnover":  { "type": "number", "minimum": 0 },
      "paymentTerms":    { "type": "integer", "enum": [30,45,60,90,120], "description": "Average payment terms in days" },
      "debtorConc":      { "type": "number", "minimum": 0, "maximum": 100, "description": "Largest single debtor as % of turnover" },
      "disputeRate":     { "type": "number", "minimum": 0, "maximum": 50, "description": "Invoice dispute rate %" },
      "debtorType":      { "type": "string", "enum": ["large_corp","mid_market","sme_mix","public_sector"] },
      "tradingYears":    { "type": "string", "enum": ["lt1","1to2","2plus"] }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "maxFunding":        { "type": "number", "description": "Maximum funding availability in selected currency" },
      "eligibleBook":      { "type": "number", "description": "Eligible invoice book after concentration adjustment" },
      "advanceRatePct":    { "type": "number" },
      "serviceFee":        { "type": "number", "description": "Service fee % of invoice value" },
      "discountRate":      { "type": "number", "description": "Discount rate % over base rate p.a." },
      "annualFeeEst":      { "type": "number" },
      "productEligibility": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "product":    { "type": "string" },
            "eligible":   { "type": "boolean" },
            "conditional":{ "type": "boolean" }
          }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "assess_invoice_finance_eligibility",
    "description": "Assess an SME's eligibility for invoice discounting, factoring, and selective invoice finance. Returns maximum funding availability, advance rate, fee model, and per-product eligibility status. Use when an SME has a working capital gap and B2B invoice receivables that could be financed.",
    "inputSchema": {
      "type": "object",
      "required": ["currency", "monthlyInvoices", "annualTurnover", "paymentTerms", "debtorConc", "disputeRate", "debtorType", "tradingYears"],
      "properties": {
        "currency":        { "type": "string", "enum": ["GBP","USD","EUR"] },
        "monthlyInvoices": { "type": "number", "minimum": 0 },
        "annualTurnover":  { "type": "number", "minimum": 0 },
        "paymentTerms":    { "type": "integer", "enum": [30,45,60,90,120] },
        "debtorConc":      { "type": "number", "minimum": 0, "maximum": 100 },
        "disputeRate":     { "type": "number", "minimum": 0, "maximum": 50 },
        "debtorType":      { "type": "string", "enum": ["large_corp","mid_market","sme_mix","public_sector"] },
        "tradingYears":    { "type": "string", "enum": ["lt1","1to2","2plus"] }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/242-invoice-finance-eligibility.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": false
}
