{
  "tool_id": "swift-gpi-rail-comparator",
  "version": "1.0.0",
  "title": "SWIFT gpi / SEPA Instant / FedNow / PIX Rail Comparator",
  "description": "Compares 10 international and domestic real-time payment rails by cost, speed, finality, and G20/FSB target compliance. Outputs cost-speed-finality matrix, recommended rail, and AP2 JSON routing policy. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "SWIFT gpi",
    "SEPA Instant",
    "FedNow",
    "PIX",
    "UPI",
    "rail comparison",
    "G20",
    "routing",
    "AP2"
  ],
  "audience": [
    "payments-engineer",
    "operations",
    "treasury"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "origin_region": {
        "type": "string"
      },
      "destination_region": {
        "type": "string"
      },
      "payment_type": {
        "type": "string",
        "enum": [
          "retail",
          "b2b",
          "highvalue",
          "remittance"
        ]
      },
      "urgency": {
        "type": "string",
        "enum": [
          "instant",
          "same_day",
          "next_day",
          "standard"
        ]
      }
    },
    "required": [
      "origin_region",
      "destination_region",
      "payment_type"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "recommended_rail": {
        "type": "object"
      },
      "scored_rails": {
        "type": "array"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "compare_payment_rails",
    "description": "Compares cross-border and domestic payment rails by cost, speed, finality, and G20/FSB compliance for a given corridor and payment type. Use when selecting the optimal rail for routing. Outputs AP2 JSON routing policy.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "origin_region": {
          "type": "string"
        },
        "destination_region": {
          "type": "string"
        },
        "payment_type": {
          "type": "string"
        },
        "urgency": {
          "type": "string"
        }
      },
      "required": [
        "origin_region",
        "destination_region",
        "payment_type"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/212-swift-gpi-rail-comparator.html",
    "function_name": "runComparison",
    "timeout_ms": 5000
  },
  "ap2_export": true
}