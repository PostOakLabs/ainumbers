{
  "tool_id": "visa-mc-interchange-qualification-tester",
  "version": "1.0.0",
  "title": "Visa/MC Interchange Qualification Tester",
  "description": "Simulates interchange category qualification for Visa and Mastercard US domestic transactions. Covers Visa CPS/Standard/EIRF and MC Merit I/III/Enhanced Best. Outputs qualified tier, estimated rate, optimisation checks, and AP2 JSON interchange policy.",
  "category": "cat-19",
  "tags": [
    "interchange",
    "Visa",
    "Mastercard",
    "qualification",
    "CPS",
    "Merit I",
    "downgrade",
    "CNP",
    "EMV",
    "AP2"
  ],
  "audience": [
    "payments engineer",
    "acquirer",
    "merchant",
    "treasury analyst"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "card_brand": {
        "type": "string",
        "enum": [
          "visa",
          "mc"
        ]
      },
      "card_type": {
        "type": "string",
        "enum": [
          "consumer-credit",
          "consumer-rewards",
          "consumer-debit",
          "prepaid",
          "commercial-credit",
          "purchasing"
        ]
      },
      "merchant_category": {
        "type": "string"
      },
      "transaction_amount_usd": {
        "type": "number",
        "minimum": 0.01
      },
      "channel": {
        "type": "string",
        "enum": [
          "cp-swipe",
          "cp-chip",
          "cp-tap",
          "cp-keyed",
          "cnp-ecomm",
          "cnp-moto"
        ]
      },
      "avs_result": {
        "type": "string",
        "enum": [
          "full-match",
          "partial-match",
          "no-match",
          "not-performed",
          "na"
        ]
      },
      "cvv_provided": {
        "type": "string",
        "enum": [
          "yes",
          "no",
          "na"
        ]
      },
      "same_day_batch": {
        "type": "string",
        "enum": [
          "yes",
          "no"
        ]
      },
      "auth_amount_match": {
        "type": "string",
        "enum": [
          "yes",
          "tip",
          "no"
        ]
      },
      "tds_used": {
        "type": "string",
        "enum": [
          "na",
          "yes",
          "attempt",
          "no"
        ]
      }
    },
    "required": [
      "card_brand",
      "transaction_amount_usd",
      "channel"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "qualified_tier": {
        "type": "string"
      },
      "interchange_rate_pct": {
        "type": "number"
      },
      "interchange_cents": {
        "type": "number"
      },
      "estimated_interchange_cost_usd": {
        "type": "number"
      },
      "effective_rate_pct": {
        "type": "number"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "test_interchange_qualification",
    "description": "Determines the Visa or Mastercard interchange qualification tier for a transaction based on card type, channel, AVS/CVV results, settlement timing, and 3DS status. Returns estimated interchange cost and optimisation recommendations. Use when an agent needs to model interchange costs, identify downgrades, or generate an interchange policy mandate.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "card_brand": {
          "type": "string"
        },
        "card_type": {
          "type": "string"
        },
        "transaction_amount_usd": {
          "type": "number"
        },
        "channel": {
          "type": "string"
        },
        "avs_result": {
          "type": "string"
        },
        "same_day_batch": {
          "type": "string"
        }
      },
      "required": [
        "card_brand",
        "transaction_amount_usd",
        "channel"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/225-visa-mc-interchange-qualification-tester.html",
    "function_name": "runTest",
    "timeout_ms": 5000
  },
  "ap2_export": true
}