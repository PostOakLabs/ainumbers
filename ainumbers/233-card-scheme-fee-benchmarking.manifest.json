{
  "tool_id": "card-scheme-fee-benchmarking",
  "version": "1.0.0",
  "title": "Card Scheme Fee Benchmarking Tool",
  "description": "Benchmarks indicative Visa and Mastercard scheme fees (assessment, NABU, data service, and CNP surcharge fees) by card type and region (US, EU, UK, APAC). Outputs per-component fee breakdown, Visa/MC comparison, annual estimate, optimisation opportunities, and AP2 JSON fee policy.",
  "category": "cat-19",
  "tags": [
    "scheme fees",
    "Visa",
    "Mastercard",
    "assessment fee",
    "NABU",
    "benchmarking",
    "interchange",
    "optimisation",
    "AP2"
  ],
  "audience": [
    "treasury analyst",
    "payments engineer",
    "acquirer",
    "CFO",
    "merchant"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "region": {
        "type": "string",
        "enum": [
          "us",
          "eu",
          "uk",
          "apac"
        ]
      },
      "card_type": {
        "type": "string",
        "enum": [
          "consumer-credit",
          "consumer-debit",
          "rewards",
          "commercial",
          "mixed"
        ]
      },
      "monthly_volume": {
        "type": "integer",
        "minimum": 1
      },
      "average_ticket": {
        "type": "number",
        "minimum": 0.01
      },
      "visa_split_pct": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "channel_type": {
        "type": "string",
        "enum": [
          "cp",
          "cnp",
          "mixed"
        ]
      }
    },
    "required": [
      "region",
      "card_type",
      "monthly_volume",
      "average_ticket"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "visa_monthly_fees": {
        "type": "number"
      },
      "mc_monthly_fees": {
        "type": "number"
      },
      "blended_monthly_fees": {
        "type": "number"
      },
      "annual_scheme_fees": {
        "type": "number"
      },
      "visa_effective_rate_bps": {
        "type": "number"
      },
      "mc_effective_rate_bps": {
        "type": "number"
      },
      "blended_effective_rate_bps": {
        "type": "number"
      },
      "fees_as_pct_of_revenue": {
        "type": "number"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "benchmark_card_scheme_fees",
    "description": "Benchmarks Visa and Mastercard acquirer scheme fees for a given card type and region (US, EU, UK, APAC). Returns per-component fee breakdown, blended monthly and annual estimates, and optimisation recommendations. Use when an agent needs to model scheme fee cost of acceptance, compare Visa vs MC scheme fees, or generate a scheme fee policy mandate.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string"
        },
        "card_type": {
          "type": "string"
        },
        "monthly_volume": {
          "type": "integer"
        },
        "average_ticket": {
          "type": "number"
        },
        "channel_type": {
          "type": "string"
        }
      },
      "required": [
        "region",
        "card_type",
        "monthly_volume",
        "average_ticket"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/233-card-scheme-fee-benchmarking.html",
    "function_name": "runBenchmark",
    "timeout_ms": 5000
  },
  "ap2_export": true
}