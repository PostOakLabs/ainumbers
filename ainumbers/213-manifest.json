{
  "tool_id": "currency-risk-exposure-heatmap",
  "version": "1.0.0",
  "title": "Currency Risk Exposure Heatmap",
  "description": "Models subsidiary-level FX exposure across a multi-entity corporate structure. Inputs intercompany receivables/payables by currency for up to four entities. Identifies natural hedges, calculates net FX exposure per entity and currency. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "FX exposure",
    "subsidiary",
    "natural hedge",
    "multi-entity",
    "currency risk"
  ],
  "audience": [
    "treasury",
    "compliance"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "entities": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "functional_ccy": {
              "type": "string"
            },
            "positions": {
              "type": "object"
            }
          }
        }
      }
    },
    "required": [
      "entities"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "total_gross_exposure": {
        "type": "number"
      },
      "total_net_exposure": {
        "type": "number"
      },
      "natural_hedge_ratio_pct": {
        "type": "number"
      },
      "net_by_currency": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "map_fx_exposure",
    "description": "Maps FX exposure across a multi-entity corporate structure, identifying natural hedges and calculating net exposure per currency. Use when assessing group-level FX risk before hedging.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "array"
        }
      },
      "required": [
        "entities"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/213-currency-risk-exposure-heatmap.html",
    "function_name": "runHeatmap",
    "timeout_ms": 5000
  },
  "ap2_export": false
}