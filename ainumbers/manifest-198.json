{
  "tool_id": "pd-lgd-ead-modeller",
  "version": "4.0.0",
  "title": "PD / LGD / EAD Modeller",
  "description": "Calculate Probability of Default, Loss Given Default, and Exposure at Default using TTC or PIT methodology. IFRS 9 and CECL aligned: 12-month vs lifetime ECL, Stage 1/2/3 classification, and macro overlay. Client-side. Zero PII.",
  "category": "cat-17",
  "tags": ["IFRS 9", "CECL", "PD", "LGD", "EAD", "ECL", "Basel III", "AP2", "export"],
  "audience": ["credit-analyst", "risk-officer", "finance"],
  "input_schema": {
    "type": "object",
    "properties": {
      "pd_method": { "type": "string", "enum": ["ttc","pit"] },
      "internal_rating": { "type": "string", "description": "Required if pd_method=ttc. S&P-equivalent rating band." },
      "macro_overlay": { "type": "number", "description": "Fractional PD uplift for TTC method e.g. 0.35 = 35%." },
      "pd_direct_pct": { "type": "number", "description": "Required if pd_method=pit. Point-in-time 1-year PD (%)." },
      "asset_class": { "type": "string", "enum": ["corporate","revolving","mortgage","trade","sme"] },
      "lgd_method": { "type": "string", "enum": ["haircut","market"] },
      "collateral_value": { "type": "number" },
      "collateral_haircut": { "type": "number", "description": "Haircut fraction e.g. 0.40 = 40%" },
      "recovery_cost_pct": { "type": "number" },
      "market_lgd_pct": { "type": "number", "description": "Required if lgd_method=market" },
      "ead_type": { "type": "string", "enum": ["drawn","committed"] },
      "drawn_amount": { "type": "number" },
      "undrawn_amount": { "type": "number" },
      "ccf_pct": { "type": "number", "description": "Credit Conversion Factor (%)" },
      "maturity_years": { "type": "number" },
      "ecl_horizon": { "type": "string", "enum": ["12m","lifetime"] }
    },
    "required": ["pd_method","asset_class","lgd_method","ead_type","drawn_amount","maturity_years","ecl_horizon"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "pd_1yr_pct": { "type": "number" },
      "pd_lifetime_pct": { "type": "number" },
      "lgd_pct": { "type": "number" },
      "ead": { "type": "number" },
      "ecl_12m": { "type": "number" },
      "ecl_lifetime": { "type": "number" },
      "ifrs9_stage": { "type": "integer", "enum": [1,2,3] },
      "ap2_mandate": { "type": "object" }
    }
  },
  "mcp_tool_definition": {
    "name": "model_pd_lgd_ead",
    "description": "Calculates PD, LGD, and EAD for credit risk modelling under IFRS 9 and CECL. Supports TTC (rating-based with macro overlay) and PIT (direct input) PD methods, haircut-based or market LGD, and drawn or committed EAD with CCF. Returns 12-month ECL, lifetime ECL, and IFRS 9 stage classification. Use after calculate_credit_risk_rating to obtain IFRS 9 parameters for a rated counterparty.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pd_method": { "type": "string", "enum": ["ttc","pit"] },
        "internal_rating": { "type": "string" },
        "pd_direct_pct": { "type": "number" },
        "lgd_method": { "type": "string", "enum": ["haircut","market"] },
        "drawn_amount": { "type": "number" },
        "maturity_years": { "type": "number" },
        "ecl_horizon": { "type": "string", "enum": ["12m","lifetime"] }
      },
      "required": ["pd_method","lgd_method","drawn_amount","maturity_years","ecl_horizon"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/198-pd-lgd-ead-modeller.html",
    "function_name": "runModel",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
