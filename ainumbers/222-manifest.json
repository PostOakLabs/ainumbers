{
  "tool_id": "fatf-travel-rule-checker",
  "version": "1.0.0",
  "title": "FATF Travel Rule Cross-Border Threshold Checker",
  "description": "Determines Travel Rule data obligations for cross-border wire or virtual asset transfers by jurisdiction pair. Covers US FinCEN (31 CFR 1010.410), EU TFR 2023/1113, UK MLR 2017, SG MAS PSN02, AU AUSTRAC, UAE CBUAE, CH FINMA, FATF R.16 baseline. Outputs compliance checklist, field matrix, and AP2 JSON Travel Rule payload stub. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "FATF R.16",
    "Travel Rule",
    "FinCEN",
    "EU TFR",
    "AML",
    "VASP",
    "compliance",
    "AP2"
  ],
  "audience": [
    "compliance",
    "payments-engineer",
    "operations"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "origin_jurisdiction": {
        "type": "string",
        "enum": [
          "US",
          "EU",
          "UK",
          "SG",
          "AU",
          "UAE",
          "CH",
          "FATF"
        ]
      },
      "destination_jurisdiction": {
        "type": "string",
        "enum": [
          "US",
          "EU",
          "UK",
          "SG",
          "AU",
          "UAE",
          "CH",
          "FATF",
          "NON_FATF"
        ]
      },
      "transfer_amount_usd": {
        "type": "number"
      },
      "asset_type": {
        "type": "string",
        "enum": [
          "wire",
          "vasp",
          "stablecoin",
          "emi"
        ]
      }
    },
    "required": [
      "origin_jurisdiction",
      "destination_jurisdiction",
      "transfer_amount_usd",
      "asset_type"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "travel_rule_triggered": {
        "type": "boolean"
      },
      "effective_threshold_usd": {
        "type": "number"
      },
      "mandatory_fields": {
        "type": "array"
      },
      "conditional_fields": {
        "type": "array"
      },
      "edd_required": {
        "type": "boolean"
      },
      "ap2_mandate": {
        "type": "object"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_travel_rule_obligations",
    "description": "Determines FATF Travel Rule data obligations for a cross-border wire or virtual asset transfer by origin/destination jurisdiction pair and amount. Covers FinCEN, EU TFR, UK MLR, MAS, AUSTRAC, FINMA, and FATF baseline. Outputs AP2 JSON Travel Rule payload stub.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "origin_jurisdiction": {
          "type": "string"
        },
        "destination_jurisdiction": {
          "type": "string"
        },
        "transfer_amount_usd": {
          "type": "number"
        },
        "asset_type": {
          "type": "string"
        }
      },
      "required": [
        "origin_jurisdiction",
        "destination_jurisdiction",
        "transfer_amount_usd",
        "asset_type"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/222-fatf-travel-rule-checker.html",
    "function_name": "runTravelRule",
    "timeout_ms": 5000
  },
  "ap2_export": true
}