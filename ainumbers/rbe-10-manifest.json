{
  "tool_id": "rbe-10-velocity-rule-simulator",
  "version": "1.0.0",
  "title": "Transaction Velocity Rule Simulator & Explainability Workbench",
  "description": "Author multi-dimensional AML/fraud velocity rules and calibrate them against a seeded synthetic transaction stream with configurable time-of-day patterns. Generates confusion matrices, deterministic rule contribution attribution (not SHAP/LIME — closed-form arithmetic), FATF typology mapping, threshold sensitivity curves, and EBA GL/2021/05 pre-deployment audit trails. AP2 JSON export. Client-side. Zero PII.",
  "category": "ai",
  "tags": ["velocity-rules", "AML", "fraud", "EBA-GL-2021-05", "FATF", "FinCEN-SAR", "explainability", "synthetic-stream", "AP2", "export", "Zero-PII"],
  "audience": ["aml-officer", "fraud-analyst", "model-governance", "compliance", "risk-engineer"],
  "last_reviewed": "2025-04-01",
  "input_schema": {
    "type": "object",
    "required": ["rules"],
    "properties": {
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "dimensions", "outcome"],
          "properties": {
            "name": { "type": "string" },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dimension": { "type": "string", "enum": ["tx_count", "tx_amount", "time_window", "merchant_type", "geography", "device_proxy", "currency"] },
                  "operator": { "type": "string", "enum": [">", ">=", "<", "<=", "=", "!="] },
                  "threshold": {},
                  "weight": { "type": "number", "minimum": 0.1, "maximum": 1.0 }
                }
              }
            },
            "outcome": { "type": "string", "enum": ["flag", "block", "escalate", "pass"] }
          }
        }
      },
      "stream_length": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 1000 },
      "sar_injection_rate": { "type": "number", "minimum": 0.01, "maximum": 0.20, "default": 0.05 },
      "random_seed": { "type": "integer", "default": 42, "description": "Seed for mulberry32 PRNG — same seed always produces identical stream" },
      "amount_mean": { "type": "number", "default": 850 },
      "amount_std_dev": { "type": "number", "default": 600 },
      "merchant_mix": {
        "type": "object",
        "properties": {
          "retail_pct": { "type": "number" },
          "msb_pct": { "type": "number" },
          "crypto_pct": { "type": "number" },
          "gambling_pct": { "type": "number" },
          "cross_border_pct": { "type": "number" }
        }
      },
      "time_distribution": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string", "enum": ["uniform", "business_hours", "night_shift", "custom"] },
          "hour_weights": { "type": "array", "items": { "type": "number" }, "minItems": 24, "maxItems": 24 }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "rule_library": { "type": "array" },
      "conflicts": { "type": "array" },
      "stream_config": { "type": "object" },
      "fatf_typology_mapping": { "type": "array" },
      "suite_metrics": {
        "type": "object",
        "properties": {
          "aggregate_false_positive_rate": { "type": "number" },
          "aggregate_recall": { "type": "number" }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "simulate_velocity_rules",
    "description": "Author and calibrate multi-dimensional AML/fraud transaction velocity monitoring rules against a seeded synthetic transaction stream. Produces confusion matrices (TP/FP/TN/FN), deterministic rule contribution attribution (closed-form arithmetic, not ML), conflict detection, threshold sensitivity curves, FATF ML typology mapping, and a pre-deployment audit trail structured per EBA GL/2021/05. Use when a compliance or fraud team needs to calibrate and document velocity rules before production deployment.",
    "inputSchema": {
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": { "type": "array", "items": { "type": "object" } },
        "stream_length": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "sar_injection_rate": { "type": "number", "minimum": 0, "maximum": 0.20 },
        "random_seed": { "type": "integer" }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/rbe-10-velocity-rule-simulator.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "mandate_type": "velocity_rule_mandate",
  "deterministic": true,
  "pii_transmitted": false,
  "execution_context": "client_side_browser",
  "prng_algorithm": "mulberry32",
  "prng_seeded": true,
  "regulatory_citations": [
    "EBA Guidelines on Internal Governance (EBA/GL/2021/05) — pre-deployment documentation",
    "FATF Recommendation 10 — Transaction Monitoring obligations",
    "FATF Recommendation 11 — Record Keeping",
    "FinCEN SAR Filing Requirements (31 CFR §1020.320)",
    "PSD2 Article 96 — payment security incident reporting",
    "6AMLD — criminal law measures against money laundering"
  ],
  "cross_links": [
    "rbe-12-scheme-compliance-simulator",
    "rbe-04-agent-guardrail-builder",
    "rbe-11-dora-incident-classifier"
  ]
}
