{
  "tool_id": "government-funding-grant-mapper",
  "version": "1.0.0",
  "title": "Government Funding & Grant Eligibility Mapper",
  "description": "Maps SME eligibility for government funding schemes across the US, UK, and EU including SBIR/STTR, Innovate UK Smart Grants, Growth Guarantee Scheme, EIC Accelerator, Horizon Europe, R&D Tax Credits, and SEIS/EIS. Eligibility scoring, funding ranges, and application complexity ratings. Last Reviewed: 9 May 2026. Client-side. Zero PII.",
  "category": "cat-20",
  "tags": ["grants", "government funding", "SBIR", "STTR", "Innovate UK", "Horizon Europe", "SME", "export"],
  "audience": ["SME owner", "startup founder", "grant manager", "finance director"],
  "input_schema": {
    "type": "object",
    "required": ["jurisdiction", "businessType", "sector", "headcount", "annualRevenue"],
    "properties": {
      "jurisdiction":   { "type": "string", "enum": ["us","uk","eu"] },
      "businessType":   { "type": "string", "enum": ["startup","scaleup","established","social","university"] },
      "sector":         { "type": "string", "enum": ["deeptech","cleantech","health","digital","manufacturing","creative","agri","defence","general"] },
      "headcount":      { "type": "string", "enum": ["sole","micro","small","medium"] },
      "annualRevenue":  { "type": "string", "enum": ["pre","lt250k","250kto1m","1mto5m","5mplus"] },
      "currency":       { "type": "string", "enum": ["GBP","USD","EUR"] }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "strongMatches":  { "type": "integer" },
      "partialMatches": { "type": "integer" },
      "schemes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name":        { "type": "string" },
            "eligible":    { "type": "boolean" },
            "partial":     { "type": "boolean" },
            "amountLabel": { "type": "string" },
            "complexity":  { "type": "integer", "minimum": 1, "maximum": 5 },
            "gaps":        { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "map_government_funding_grants",
    "description": "Map an SME's eligibility for government funding schemes in the US, UK, or EU. Returns strong and partial matches from a database of 10 schemes including SBIR/STTR, Innovate UK, EIC Accelerator, Horizon Europe, Growth Guarantee Scheme, R&D Tax Credits, and SEIS/EIS. Includes funding amount ranges, complexity ratings, and gap analysis. Data last reviewed 9 May 2026 — always verify with the relevant funding body before applying.",
    "inputSchema": {
      "type": "object",
      "required": ["jurisdiction", "businessType", "sector", "headcount", "annualRevenue"],
      "properties": {
        "jurisdiction":  { "type": "string", "enum": ["us","uk","eu"] },
        "businessType":  { "type": "string", "enum": ["startup","scaleup","established","social","university"] },
        "sector":        { "type": "string" },
        "headcount":     { "type": "string", "enum": ["sole","micro","small","medium"] },
        "annualRevenue": { "type": "string", "enum": ["pre","lt250k","250kto1m","1mto5m","5mplus"] }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/245-government-funding-grant-mapper.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": false,
  "last_reviewed": "2026-05-09",
  "staleness_risk": "high"
}
