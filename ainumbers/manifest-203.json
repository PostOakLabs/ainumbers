{
  "tool_id": "raroc-loan-pricing-model",
  "version": "4.0.0",
  "title": "RAROC Loan Pricing Model",
  "description": "Model risk-adjusted return on capital for loan and facility pricing. Inputs: loan amount, margin, fees, cost of funds, expected loss (from T198), capital allocation (from T201), and operating cost. Outputs RAROC vs hurdle rate verdict, economic profit/loss, minimum margin calculation, and AP2 JSON loan pricing record. Client-side. Zero PII.",
  "category": "cat-17",
  "tags": ["RAROC", "Loan Pricing", "Economic Profit", "ICAAP", "Capital Allocation", "AP2", "export"],
  "audience": ["relationship-manager", "credit-analyst", "capital-management"],
  "input_schema": {
    "type": "object",
    "properties": {
      "loan_amount": { "type": "number" },
      "maturity_years": { "type": "number" },
      "all_in_margin_bps": { "type": "number", "description": "All-in margin over reference rate (bps)" },
      "cost_of_funds_bps": { "type": "number", "description": "Bank internal funding cost over reference rate (bps)" },
      "upfront_fee_pct": { "type": "number", "description": "Upfront fee as % of facility" },
      "annual_fee_pct": { "type": "number", "description": "Annual agency/commitment fee as % of facility" },
      "expected_loss_annual": { "type": "number", "description": "Annual expected loss ($) — from T198" },
      "rwa": { "type": "number", "description": "Risk-Weighted Assets ($) — from T201" },
      "cet1_ratio_pct": { "type": "number", "description": "CET1 capital ratio held against this RWA (%)" },
      "opex_ratio_pct": { "type": "number", "description": "Operating cost as % of loan p.a." },
      "hurdle_rate_pct": { "type": "number", "description": "Target RAROC hurdle rate (%)" },
      "cost_of_equity_pct": { "type": "number", "description": "CAPM cost of equity for Economic Profit (%)" }
    },
    "required": ["loan_amount","maturity_years","all_in_margin_bps","cost_of_funds_bps","upfront_fee_pct","annual_fee_pct","expected_loss_annual","rwa","cet1_ratio_pct","opex_ratio_pct","hurdle_rate_pct","cost_of_equity_pct"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "nii": { "type": "number", "description": "Annual Net Interest Income ($)" },
      "fee_income_annualised": { "type": "number" },
      "rani": { "type": "number", "description": "Risk-Adjusted Net Income ($)" },
      "economic_capital": { "type": "number" },
      "raroc_pct": { "type": "number" },
      "hurdle_rate_pct": { "type": "number" },
      "raroc_vs_hurdle_pct": { "type": "number" },
      "economic_profit": { "type": "number" },
      "minimum_margin_bps": { "type": "number" },
      "deal_verdict": { "type": "string", "enum": ["approved","rejected"] },
      "ap2_mandate": { "type": "object" }
    }
  },
  "mcp_tool_definition": {
    "name": "model_raroc_loan_pricing",
    "description": "Computes RAROC, economic profit, and minimum margin for a loan or credit facility. Takes margin, fees, cost of funds, expected loss (from model_pd_lgd_ead), and RWA (from calculate_basel_rwa) as inputs. Returns a deal verdict (approved/rejected vs hurdle), P&L waterfall, and the minimum bps margin required to meet the hurdle. Use as the final step in the Cat-17 credit workflow before deal approval.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "loan_amount": { "type": "number" },
        "maturity_years": { "type": "number" },
        "all_in_margin_bps": { "type": "number" },
        "cost_of_funds_bps": { "type": "number" },
        "upfront_fee_pct": { "type": "number" },
        "annual_fee_pct": { "type": "number" },
        "expected_loss_annual": { "type": "number" },
        "rwa": { "type": "number" },
        "cet1_ratio_pct": { "type": "number" },
        "opex_ratio_pct": { "type": "number" },
        "hurdle_rate_pct": { "type": "number" },
        "cost_of_equity_pct": { "type": "number" }
      },
      "required": ["loan_amount","maturity_years","all_in_margin_bps","cost_of_funds_bps","upfront_fee_pct","annual_fee_pct","expected_loss_annual","rwa","cet1_ratio_pct","opex_ratio_pct","hurdle_rate_pct","cost_of_equity_pct"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/203-raroc-loan-pricing-model.html",
    "function_name": "runRAROC",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
