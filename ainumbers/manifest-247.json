{
  "tool_id": "lending-covenant-monitoring",
  "version": "1.0.0",
  "title": "Lending Covenant & Facility Monitoring Dashboard",
  "description": "Monitors six SME lending facility covenants (DSCR, net leverage, minimum cash, current ratio, interest cover, capex limit) against user-defined thresholds. Produces RAG compliance status, headroom percentages, breach alerts with LMA-referenced remediation obligations, and a Markdown monitoring memo. Client-side. Zero PII.",
  "category": "cat-20",
  "tags": ["covenant monitoring", "DSCR", "leverage ratio", "SME lending", "compliance", "RAG", "export"],
  "audience": ["finance director", "CFO", "credit analyst", "lender", "portfolio manager"],
  "input_schema": {
    "type": "object",
    "required": ["currency", "covenants"],
    "properties": {
      "currency": { "type": "string", "enum": ["GBP","USD","EUR"] },
      "period":   { "type": "string", "description": "Review period label e.g. Q2 2026" },
      "covenants": {
        "type": "object",
        "properties": {
          "dscr":  { "type": "object", "properties": { "threshold": { "type": "number" }, "actual": { "type": "number" } } },
          "leverage": { "type": "object", "properties": { "threshold": { "type": "number" }, "actual": { "type": "number" } } },
          "minCash":  { "type": "object", "properties": { "threshold": { "type": "number" }, "actual": { "type": "number" } } },
          "currentRatio": { "type": "object", "properties": { "threshold": { "type": "number" }, "actual": { "type": "number" } } },
          "interestCover": { "type": "object", "properties": { "threshold": { "type": "number" }, "actual": { "type": "number" } } },
          "capex": { "type": "object", "properties": { "threshold": { "type": "number" }, "actual": { "type": "number" } } }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "overallStatus": { "type": "string", "enum": ["ALL_COMPLIANT","WATCH","BREACH"] },
      "breachCount":   { "type": "integer" },
      "amberCount":    { "type": "integer" },
      "covenantResults": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id":          { "type": "string" },
            "label":       { "type": "string" },
            "threshold":   { "type": "number" },
            "actual":      { "type": "number" },
            "headroomPct": { "type": "number" },
            "rag":         { "type": "string", "enum": ["rag-green","rag-amber","rag-red"] },
            "breach":      { "type": "boolean" }
          }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "monitor_lending_covenants",
    "description": "Monitor SME lending facility covenants against thresholds. Evaluates DSCR, net leverage (Net Debt/EBITDA), minimum cash balance, current ratio, interest cover, and annual capex limit. Returns RAG status, headroom percentage, breach alerts, and remediation obligations per the LMA standard. Use for periodic covenant compliance reporting or when a financial metric changes materially.",
    "inputSchema": {
      "type": "object",
      "required": ["currency", "covenants"],
      "properties": {
        "currency":  { "type": "string", "enum": ["GBP","USD","EUR"] },
        "period":    { "type": "string" },
        "covenants": { "type": "object" }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/247-lending-covenant-monitoring.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": false
}
