  "version": "1.0.0",
  "tool_id": "dora-ict-concentration-risk-modeller",
  "tool_number": 306,
  "category": "cat-22",
  "name": "ICT Concentration Risk Modeller",
  "description": "Models ICT concentration risk across a provider portfolio. HHI index, SPOF flags (dependency ≥40% + substitutability ≤2), 19 CTPP provider detection, diversification recommendations, AP2 JSON mandate. Client-side. Zero PII.",
  "path": "tools/306-dora-ict-concentration-risk-modeller.html",
  "tags": ["DORA", "Concentration Risk", "CTPP", "HHI", "SPOF", "AP2"],
  "ap2_export": true,
  "mcp": {
    "name": "model_dora_concentration_risk",
    "description": "Model ICT provider concentration risk and return HHI index, SPOF flags, and CTPP exposure",
    "input_schema": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type":"string"},
              "service_type": {"type":"string","enum":["cloud","saas","data","payment","security"]},
              "cif_tier": {"type":"string","enum":["T1","T2","T3"]},
              "dependency_pct": {"type":"number","minimum":0,"maximum":100},
              "substitutability": {"type":"integer","minimum":1,"maximum":5},
              "geographic_concentration": {"type":"string","enum":["eea","us","multi","global"]}
            },
            "required":["name","dependency_pct","cif_tier"]
          }
        }
      },
      "required": ["providers"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000
  },
  "regulatory_frameworks": ["EU 2022/2554"],
  "jurisdictions": ["EU","EEA"],
  "last_reviewed": "2025-05-01"
