{
  "tool_id": "open-finance-credit-signal-mapper",
  "version": "1.0.0",
  "title": "Open Finance Credit Signal Mapper",
  "description": "Models how CFPB 1033, PSD3, UK Open Banking, and AU CDR transaction data could improve SME underwriting accuracy. Scores signal quality across up to six data categories and estimates credit decision improvement. Modelling tool only — no real data processed. Client-side. Zero PII.",
  "category": "cat-20",
  "tags": ["open banking", "CFPB 1033", "PSD3", "credit signals", "underwriting", "open finance", "AP2", "export"],
  "audience": ["credit analyst", "compliance officer", "fintech engineer", "regulatory affairs"],
  "input_schema": {
    "type": "object",
    "required": ["jurisdiction", "currentApproach", "dataMonths", "smeSector", "selectedSignalIds"],
    "properties": {
      "jurisdiction":       { "type": "string", "enum": ["uk","us","eu","au"], "description": "Regulatory jurisdiction" },
      "currentApproach":    { "type": "string", "enum": ["trad","supplemented","hybrid","advanced"], "description": "Current underwriting approach" },
      "dataMonths":         { "type": "integer", "enum": [3,6,12,24], "description": "Months of historical transaction data available" },
      "smeSector":          { "type": "string", "enum": ["retail","services","manufacturing","hospitality","construction"] },
      "selectedSignalIds":  { "type": "array", "items": { "type": "string", "enum": ["sig_income","sig_cashflow","sig_merchant","sig_savings","sig_credit_behav","sig_seasonal"] } }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "signalScore":          { "type": "number", "minimum": 0, "maximum": 100 },
      "tier":                 { "type": "string", "enum": ["High Quality","Moderate Quality","Limited Quality","Low Quality"] },
      "accuracyImpPct":       { "type": "number", "description": "Estimated credit decision accuracy improvement %" },
      "fpReductionPct":       { "type": "number", "description": "Estimated false positive reduction %" },
      "complianceScore":      { "type": "number", "minimum": 0, "maximum": 100 },
      "regulatoryStatus":     { "type": "string" },
      "signalResults":        { "type": "array", "items": { "type": "object" } }
    }
  },
  "mcp_tool_definition": {
    "name": "map_open_finance_credit_signals",
    "description": "Model the credit signal quality and underwriting improvement potential of open banking data under CFPB 1033, PSD3, UK Open Banking, or AU CDR. Returns signal quality score, estimated accuracy improvement, false positive reduction, and compliance posture. MODELLING TOOL ONLY — does not process real account data. Use for regulatory readiness planning and open data credit policy design.",
    "inputSchema": {
      "type": "object",
      "required": ["jurisdiction", "currentApproach", "dataMonths", "smeSector", "selectedSignalIds"],
      "properties": {
        "jurisdiction":      { "type": "string", "enum": ["uk","us","eu","au"] },
        "currentApproach":   { "type": "string", "enum": ["trad","supplemented","hybrid","advanced"] },
        "dataMonths":        { "type": "integer", "enum": [3,6,12,24] },
        "smeSector":         { "type": "string" },
        "selectedSignalIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/243-open-finance-credit-signal-mapper.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
