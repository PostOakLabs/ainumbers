{
  "tool_id": "sme-credit-risk-scoring",
  "version": "1.0.0",
  "title": "SME Credit Risk Scoring Engine",
  "description": "Six-dimension rule-based SME credit scoring across revenue, business age, DSCR, payment behaviour, sector risk, and adverse events. Produces a composite score, internal rating mapped to S&P equivalents, and lending recommendations. Client-side. Zero PII.",
  "category": "cat-20",
  "tags": ["SME", "credit risk", "DSCR", "scoring", "lending", "AP2", "export"],
  "audience": ["credit analyst", "finance director", "SME owner", "lender"],
  "input_schema": {
    "type": "object",
    "required": ["currency", "sector", "revenue", "businessAge", "dscr", "paymentBehaviour", "adverseEvents"],
    "properties": {
      "currency":          { "type": "string", "enum": ["GBP","USD","EUR"], "description": "Reporting currency" },
      "sector":            { "type": "string", "description": "Industry sector of the SME" },
      "revenue":           { "type": "number", "minimum": 0, "description": "Annual revenue in selected currency" },
      "businessAge":       { "type": "number", "minimum": 0, "description": "Business age in months" },
      "dscr":              { "type": "number", "minimum": 0, "description": "Debt Service Coverage Ratio (NOI / Debt Service)" },
      "paymentBehaviour":  { "type": "string", "enum": ["excellent","good","fair","poor","default"], "description": "Historical payment behaviour classification" },
      "adverseEvents":     { "type": "string", "enum": ["none","minor","ccj","significant","insolvency"], "description": "Adverse credit events on record" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "compositeScore":    { "type": "number", "minimum": 0, "maximum": 100 },
      "rating":            { "type": "string", "description": "Internal rating: Prime / Strong / Satisfactory / Weak / Speculative / Distressed" },
      "spEquivalent":      { "type": "string", "description": "Approximate S&P equivalent rating band" },
      "dimensionScores":   { "type": "object", "description": "Score breakdown per dimension" },
      "lendingRecommendations": { "type": "array", "items": { "type": "string" } }
    }
  },
  "mcp_tool_definition": {
    "name": "score_sme_credit_risk",
    "description": "Run a six-dimension rule-based credit risk score for an SME. Returns composite score (0–100), internal rating tier, approximate S&P equivalent, per-dimension breakdown, and lending product recommendations. Use when an agent needs to assess SME creditworthiness before recommending a financing product.",
    "inputSchema": {
      "type": "object",
      "required": ["currency", "sector", "revenue", "businessAge", "dscr", "paymentBehaviour", "adverseEvents"],
      "properties": {
        "currency":         { "type": "string", "enum": ["GBP","USD","EUR"] },
        "sector":           { "type": "string" },
        "revenue":          { "type": "number", "minimum": 0 },
        "businessAge":      { "type": "number", "minimum": 0 },
        "dscr":             { "type": "number", "minimum": 0 },
        "paymentBehaviour": { "type": "string", "enum": ["excellent","good","fair","poor","default"] },
        "adverseEvents":    { "type": "string", "enum": ["none","minor","ccj","significant","insolvency"] }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/239-sme-credit-risk-scoring.html",
    "function_name": "runAnalysis",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
