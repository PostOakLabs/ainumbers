{
  "tool_id": "credit-stress-testing-workbench",
  "version": "4.0.0",
  "title": "Credit Stress Testing Workbench",
  "description": "Apply macro stress scenarios — GDP shock, interest rate move, sector downturn, FX shock — to counterparty credit metrics. Outputs a four-scenario comparison table, credit metric migration across rating notches, Markdown stress memo, and AP2 JSON stress scenario record. Client-side. Zero PII.",
  "category": "cat-17",
  "tags": ["Stress Test", "Scenario Analysis", "Rating Migration", "ICAAP", "DFAST", "EBA", "ECL", "AP2", "export"],
  "audience": ["risk-officer", "credit-analyst", "capital-management"],
  "input_schema": {
    "type": "object",
    "properties": {
      "base_rating": { "type": "string", "description": "Current S&P-equivalent rating e.g. BBB" },
      "sector": { "type": "string", "enum": ["general","tech","healthcare","utilities","realestate","energy","retail","financial"] },
      "base_pd_pct": { "type": "number", "description": "Base 1-year PD (%)" },
      "base_ead": { "type": "number" },
      "base_lgd_pct": { "type": "number" },
      "base_rwa": { "type": "number" },
      "scenarios": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "scenario_id": { "type": "string", "enum": ["mild","moderate","severe","custom"] },
            "name": { "type": "string" },
            "gdp_shock_pct": { "type": "number" },
            "rate_move_bps": { "type": "number" },
            "sector_shock_pct": { "type": "number" },
            "fx_shock_pct": { "type": "number" }
          },
          "required": ["scenario_id"]
        },
        "minItems": 1
      }
    },
    "required": ["base_rating","sector","base_pd_pct","base_ead","base_lgd_pct","base_rwa","scenarios"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "base": { "type": "object" },
      "stressed_scenarios": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "scenario_id": { "type": "string" },
            "stressed_rating": { "type": "string" },
            "notch_change": { "type": "integer" },
            "stressed_pd_pct": { "type": "number" },
            "stressed_ecl": { "type": "number" },
            "stressed_rwa": { "type": "number" },
            "stressed_capital": { "type": "number" },
            "ig_breach": { "type": "boolean" }
          }
        }
      },
      "ap2_mandate": { "type": "object" }
    }
  },
  "mcp_tool_definition": {
    "name": "run_credit_stress_test",
    "description": "Applies macro stress scenarios to counterparty credit metrics using a sector-calibrated score-degradation model. For each scenario (mild/moderate/severe/custom), computes stressed rating, PD, ECL, RWA, and capital. Flags investment-grade breaches. Use for ICAAP stress documentation, DFAST submissions, and pre-deal scenario analysis. Input base metrics from calculate_credit_risk_rating and model_pd_lgd_ead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "base_rating": { "type": "string" },
        "sector": { "type": "string" },
        "base_pd_pct": { "type": "number" },
        "base_ead": { "type": "number" },
        "base_lgd_pct": { "type": "number" },
        "base_rwa": { "type": "number" },
        "scenarios": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["base_rating","sector","base_pd_pct","base_ead","base_lgd_pct","base_rwa","scenarios"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/202-credit-stress-testing-workbench.html",
    "function_name": "runStress",
    "timeout_ms": 5000
  },
  "ap2_export": true
}
