{
  "tool_id": "ibor-transition-reference-checker",
  "version": "1.0.0",
  "title": "IBOR Transition Reference Checker",
  "description": "Calculates RFR equivalent for any legacy IBOR rate using ISDA 2020 fallback spread adjustments. Covers SOFR (ARRC), \u20acSTR (ECB), SONIA (BoE), TONA (BoJ), SARON (SNB). Outputs replacement rate, spread in bps, and fallback language reference. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "IBOR",
    "SOFR",
    "SONIA",
    "\u20acSTR",
    "TONA",
    "SARON",
    "ISDA fallback",
    "RFR transition"
  ],
  "audience": [
    "treasury",
    "compliance",
    "engineer"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "ibor_type": {
        "type": "string",
        "enum": [
          "LIBOR_USD",
          "LIBOR_GBP",
          "LIBOR_EUR",
          "LIBOR_JPY",
          "LIBOR_CHF",
          "EURIBOR"
        ]
      },
      "tenor": {
        "type": "string",
        "enum": [
          "1W",
          "1M",
          "3M",
          "6M",
          "12M"
        ]
      },
      "methodology": {
        "type": "string",
        "enum": [
          "isda",
          "arrc",
          "bmr"
        ]
      },
      "contract_rate_pct": {
        "type": "number"
      }
    },
    "required": [
      "ibor_type",
      "tenor"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "rfr_name": {
        "type": "string"
      },
      "spread_adjustment_bps": {
        "type": "number"
      },
      "rfr_equivalent_rate_pct": {
        "type": "number"
      },
      "fallback_reference": {
        "type": "string"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "check_ibor_rfr_transition",
    "description": "Calculates the RFR-equivalent rate for a legacy IBOR rate using ISDA 2020 fallback spread adjustments. Use when amending legacy IBOR-referencing contracts or assessing RFR transition impact.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ibor_type": {
          "type": "string"
        },
        "tenor": {
          "type": "string"
        },
        "contract_rate_pct": {
          "type": "number"
        }
      },
      "required": [
        "ibor_type",
        "tenor"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/214-ibor-transition-reference-checker.html",
    "function_name": "runIBOR",
    "timeout_ms": 5000
  },
  "ap2_export": false
}