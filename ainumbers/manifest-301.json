{
  "version": "1.0.0",
  "tool_id": "dora-roi-structure-builder",
  "tool_number": 301,
  "category": "cat-22",
  "name": "DORA Register of Information Structure Builder",
  "description": "Dynamic provider entry form with 24 ESA data quality checks. CIF T1/T2/T3 classification, xBRL-CSV export and AP2 JSON mandate. Client-side. Zero PII.",
  "path": "tools/301-dora-roi-structure-builder.html",
  "tags": ["DORA", "Register of Information", "xBRL", "CIF", "AP2"],
  "ap2_export": true,
  "mcp": {
    "name": "build_dora_roi",
    "description": "Build and validate a DORA Register of Information structure for ICT third-party providers",
    "input_schema": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "description": "List of ICT provider entries",
          "items": {
            "type": "object",
            "properties": {
              "provider_name": {"type":"string"},
              "service_type": {"type":"string"},
              "cif_tier": {"type":"string","enum":["T1","T2","T3"]},
              "annual_spend_eur": {"type":"number"},
              "substitutability": {"type":"integer","minimum":1,"maximum":5}
            }
          }
        }
      },
      "required": ["providers"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "timeout_ms": 5000
  },
  "regulatory_frameworks": ["EU 2022/2554"],
  "jurisdictions": ["EU","EEA"],
  "last_reviewed": "2025-05-01"
}
