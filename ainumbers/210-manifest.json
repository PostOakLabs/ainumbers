{
  "tool_id": "cross-border-payment-failure-model",
  "version": "1.0.0",
  "title": "Cross-Border Payment Failure Probability Model",
  "description": "Models failure probability for cross-border payment instructions using originator bank tier, correspondent chain length, beneficiary jurisdiction risk, and payment purpose code. Outputs failure probability score, primary cause distribution, and ranked mitigations. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "cross-border",
    "payment failure",
    "correspondent risk",
    "SWIFT",
    "probability"
  ],
  "audience": [
    "payments-engineer",
    "operations",
    "compliance"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "originator_tier": {
        "type": "string",
        "enum": [
          "1",
          "2",
          "3",
          "4"
        ]
      },
      "chain_length": {
        "type": "string",
        "enum": [
          "0",
          "1",
          "2",
          "3"
        ]
      },
      "jurisdiction_risk": {
        "type": "string",
        "enum": [
          "1",
          "2",
          "3",
          "4"
        ]
      },
      "purpose_code": {
        "type": "string",
        "enum": [
          "SUPP",
          "SALA",
          "TRAD",
          "CORT",
          "PENS",
          "OTHR",
          "FCOL"
        ]
      },
      "payment_amount": {
        "type": "string"
      },
      "swift_gpi": {
        "type": "string",
        "enum": [
          "yes",
          "no"
        ]
      }
    },
    "required": [
      "originator_tier",
      "chain_length",
      "jurisdiction_risk",
      "purpose_code"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "failure_probability_pct": {
        "type": "number"
      },
      "risk_band": {
        "type": "string"
      },
      "cause_distribution": {
        "type": "object"
      },
      "mitigations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "model_payment_failure_probability",
    "description": "Models failure probability for a cross-border payment instruction based on originator tier, correspondent chain length, jurisdiction risk, and purpose code. Use when a payments agent needs to assess corridor risk before routing.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "originator_tier": {
          "type": "string"
        },
        "chain_length": {
          "type": "string"
        },
        "jurisdiction_risk": {
          "type": "string"
        },
        "purpose_code": {
          "type": "string"
        }
      },
      "required": [
        "originator_tier",
        "chain_length",
        "jurisdiction_risk",
        "purpose_code"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/210-cross-border-payment-failure-model.html",
    "function_name": "runModel",
    "timeout_ms": 5000
  },
  "ap2_export": false
}