{
  "tool_id": "fx-settlement-fails-assessor",
  "version": "1.0.0",
  "title": "FX Settlement Fails Risk Assessor",
  "description": "Assesses FX settlement risk for CLS-eligible vs non-CLS trades. Quantifies principal risk, replacement cost (97.5th pct), Herstatt risk window, expected loss, and CLS netting benefit. Reference: BIS PvP guidance Nov 2022. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "FX settlement",
    "CLS",
    "principal risk",
    "Herstatt",
    "PvP",
    "BIS CPMI"
  ],
  "audience": [
    "treasury",
    "operations",
    "risk"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "settlement_type": {
        "type": "string",
        "enum": [
          "cls",
          "nonCLS",
          "bilateral_pvp",
          "sequential"
        ]
      },
      "notional_usd_millions": {
        "type": "number"
      },
      "counterparty_quality": {
        "type": "string",
        "enum": [
          "aaa",
          "a",
          "bb",
          "nonbank"
        ]
      },
      "pair_class": {
        "type": "string",
        "enum": [
          "g10",
          "em"
        ]
      },
      "settlement_lag_hours": {
        "type": "number"
      }
    },
    "required": [
      "settlement_type",
      "notional_usd_millions",
      "counterparty_quality"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "principal_risk_usd_m": {
        "type": "number"
      },
      "replacement_cost_usd_m": {
        "type": "number"
      },
      "expected_loss_usd_m": {
        "type": "number"
      },
      "herstatt_window_hours": {
        "type": "number"
      },
      "cls_netting_benefit": {
        "type": "string"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "assess_fx_settlement_risk",
    "description": "Assesses FX settlement risk quantifying principal risk, replacement cost, Herstatt window, and expected loss for CLS vs non-CLS trades. Use when evaluating settlement risk on FX transactions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "settlement_type": {
          "type": "string"
        },
        "notional_usd_millions": {
          "type": "number"
        },
        "counterparty_quality": {
          "type": "string"
        }
      },
      "required": [
        "settlement_type",
        "notional_usd_millions",
        "counterparty_quality"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/215-fx-settlement-fails-assessor.html",
    "function_name": "runAssessor",
    "timeout_ms": 5000
  },
  "ap2_export": false
}