#!/bin/sh
# Pre-push shift-left gate. Runs the full preflight suite so a red tree never reaches CI
# (green here == green in CI). Enabled per-clone via `core.hooksPath = .githooks`; run
# `node scripts/setup-hooks.mjs` once after cloning (worktrees inherit it automatically).
#
# Emergency bypass (use sparingly, e.g. pushing a WIP branch you know is red): git push --no-verify
#
# CI remains the real backstop — this hook only enforces locally and can be bypassed.

# Re-entry guard: the attestation step below pushes refs/notes/preflight-attestation,
# which re-invokes this same hook. That inner push is already covered by the outer
# preflight run — running preflight again on it is redundant and, worse, its own
# diff-against-merge-base can re-trigger the attestation push, recursing without end
# (PREPUSH-RECURSION-1: observed depth ≥6 nested git/node processes, killed after 280s
# still descending). The outer invocation exports this sentinel only around the notes
# push; the inner hook process inherits it and exits immediately instead of re-running
# preflight.
if [ -n "$AINUM_PREPUSH_ATTESTING" ]; then
  exit 0
fi

# RECONCILE-PUSH-QUARANTINE-1 (Tim directive, 2026-08-22): reconcile-class ref
# creation is quarantined to refs/heads/wip/. On 2026-08-22 a reconcile-class row
# pushed 16 bare branch names straight to origin in one --no-verify push, on a
# `git cherry` classification that was wrong — all 16 were SUPERSEDED and were
# deleted the same day. This guard runs FIRST (it is cheap and needs no network)
# so the refusal lands before anything expensive, and it reads git's pre-push
# stdin, which is why stdin is captured here rather than left unread.
#
# Honest limit: `git push --no-verify` skips this hook entirely, as it skips
# every client-side hook. Only a server-side push ruleset can close that, and
# rulesets are Tim-only (SO #8). What IS closed is the REASON the 2026-08-22
# push reached for --no-verify: it was escaping preflight, which fails by
# construction on ancient branches (SO #27). A push whose refs are ALL under
# refs/heads/wip/ now skips preflight outright (see below), so the sanctioned
# path is strictly cheaper than the bypass.
refs_stdin=$(cat)
quarantine_only=""
if [ -f scripts/reconcile-guard.mjs ]; then
  guard_out=$(printf '%s\n' "$refs_stdin" | node scripts/reconcile-guard.mjs --prepush 2>&1)
  guard_status=$?
  [ -n "$guard_out" ] && printf '%s\n' "$guard_out"
  if [ "$guard_status" -ne 0 ]; then
    exit 1
  fi
  case "$guard_out" in
    *AINUM_QUARANTINE_ONLY=1*) quarantine_only=1 ;;
  esac
fi

# Branches that predate preflight (or non-site checkouts) have nothing to gate.
if [ ! -f scripts/preflight.mjs ]; then
  exit 0
fi

# Quarantine refs are a holding pen, never product: nothing merges out of
# refs/heads/wip/ without a human reading the per-branch verdict first, and CI
# still runs on any PR opened from one. Running the full site preflight against
# a stale branch parked in quarantine proves nothing, and that cost is exactly
# what made --no-verify attractive on 2026-08-22.
if [ -n "$quarantine_only" ]; then
  echo "pre-push: quarantine-only push (refs/heads/wip/) — preflight skipped by design (RECONCILE-PUSH-QUARANTINE-1)."
  exit 0
fi

# PREREQ-EXPECTRED-FLAG-1 (2026-08-27, J22 builder-contract addendum, §2
# ":139-:143"): "if your row's diff is red on a branch purely because its
# target exists only on an unmerged branch/shard ... you push normally; the
# hook accepts a declared --expect-red per invocation." scripts/preflight.mjs
# has carried `--expect-red <gate-id>` since PREFLIGHT-KEEPGOING-1
# (2026-08-15, #1283) — it waives ONLY gates whose label substring-matches a
# declared id, and any OTHER red gate still fails the run (see preflight.mjs's
# own EXPECT_RED / expectedRedFor). What was missing was the HOOK-side half:
# a per-invocation way to declare the id(s) to a `git push`, forward them into
# preflight, and disclose the declaration somewhere it can't be silently
# dropped.
#
# PER-INVOCATION ONLY, by design (contract: "There is no waiver file on
# purpose: a persisted waiver accumulates silently"). Declare via an env var
# prefixed onto the ONE push command — nothing written to disk, nothing that
# survives the process:
#   AINUM_EXPECT_RED="<gate-id>[,<gate-id>...]" [AINUM_EXPECT_RED_ROW="<row-id>"] git push ...
# Multiple ids are comma-separated; each is matched by preflight.mjs as a
# case-insensitive SUBSTRING of a gate label — identical semantics to calling
# `preflight.mjs --expect-red <id>` once per id directly. Zero gate semantics
# lives here: nothing in this hook inspects WHY a gate is red — that
# discipline (by-construction, documented in the row, never a defect in your
# own diff) is on the pusher, per SO #27/the contract, not mechanically
# checked. What IS mechanically guaranteed: any gate NOT named in the
# declaration — including a genuine defect on an undeclared gate — still
# fails the preflight run and still blocks this push (see preflight.mjs:
# EXPECTED-RED only covers a matched label; every other FAIL stays FAIL).
set --
if [ -n "$AINUM_EXPECT_RED" ]; then
  _ier_ifs=$IFS
  IFS=','
  for _ier_id in $AINUM_EXPECT_RED; do
    _ier_trim=$(printf '%s' "$_ier_id" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$_ier_trim" ] && set -- "$@" --expect-red "$_ier_trim"
  done
  IFS=$_ier_ifs
  echo "════════════════════════════════════════════════════════════════"
  echo "⚠ pre-push: --expect-red DECLARED for THIS invocation only (env, not persisted): $AINUM_EXPECT_RED"
  echo "  Scope: by-construction red only (target exists only on an unmerged branch/shard)."
  echo "  Any OTHER red gate, or a genuine defect on a named one, still blocks this push."
  echo "════════════════════════════════════════════════════════════════"
fi

echo "pre-push: running scripts/preflight.mjs --changed origin/main (bypass with 'git push --no-verify') ..."
node scripts/preflight.mjs --changed origin/main "$@"
status=$?

# Disclosure — DISCLOSURE, not permission: runs regardless of outcome, so a
# declaration that failed to clear the push (RED control) is logged exactly
# like one that succeeded (GREEN control). "The tooling enforces it, not
# honor" (J21 invariant 5): this append happens whether or not the pusher
# would have remembered to report it.
if [ -n "$AINUM_EXPECT_RED" ]; then
  _ier_denied=false
  [ "$status" -ne 0 ] && _ier_denied=true
  if [ "$_ier_denied" = "false" ]; then
    echo "✅ pre-push: --expect-red ACCEPTED — [$AINUM_EXPECT_RED] was the only red; push proceeds. Declaration made, not silent."
  else
    echo "⛔ pre-push: --expect-red did NOT clear this push — a red exists outside [$AINUM_EXPECT_RED] (or a declared id matched no gate). Still blocking, by design." 1>&2
  fi
  _ier_json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n'; }
  _ier_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  _ier_gate=$(_ier_json_escape "$AINUM_EXPECT_RED")
  _ier_row=$(_ier_json_escape "${AINUM_EXPECT_RED_ROW:-unspecified}")
  _ier_branch=$(_ier_json_escape "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)")
  _ier_sha=$(git rev-parse HEAD 2>/dev/null)
  # AINUM_GUARDRAIL_METRICS_PATH is a TEST-ONLY override (see .githooks/pre-push.test.mjs);
  # production always resolves to the workspace-root metrics file at its fixed absolute path.
  _ier_metrics_file="${AINUM_GUARDRAIL_METRICS_PATH:-/c/dev/Claude/Projects/AINumbers/board/reference/GUARDRAIL-METRICS.jsonl}"
  _ier_line="{\"event\":\"expect-red-declaration\",\"ts\":\"$_ier_ts\",\"gate\":\"$_ier_gate\",\"mechanism\":\"--expect-red\",\"row\":\"$_ier_row\",\"branch\":\"$_ier_branch\",\"commit\":\"$_ier_sha\",\"denied\":$_ier_denied}"
  if [ -f "$_ier_metrics_file" ] && printf '%s\n' "$_ier_line" >> "$_ier_metrics_file" 2>/dev/null; then
    echo "pre-push: --expect-red declaration appended to GUARDRAIL-METRICS.jsonl as an override event (denied=$_ier_denied)."
  else
    echo "pre-push: (non-fatal) could not append the --expect-red declaration to GUARDRAIL-METRICS.jsonl (path: $_ier_metrics_file)." 1>&2
  fi
fi

if [ "$status" -ne 0 ]; then
  echo "pre-push: preflight FAILED — push blocked. Fix the gate above, or 'git push --no-verify' to override." 1>&2
  exit 1
fi

# PREPUSH-SKEW-ADVISORY-1 (2026-08-12): sibling-page skew advisory — ADVISORY ONLY, NEVER BLOCKS.
# The structural fix is SITEMAP-MAIN-REGEN-1 (main auto-regenerates sitemap.html on every merge);
# until that lands, a branch cut before a sibling page merged to origin/main can push a sitemap.html
# that's already stale the moment it lands. This shrinks that window by telling the pusher up front.
# Requires a fetch — kept cheap (--quiet) and tolerant of no network: any fetch failure just skips
# the check silently, it never fails or delays the push.
merge_base_skew=$(git merge-base origin/main HEAD 2>/dev/null) || merge_base_skew=""
if [ -n "$merge_base_skew" ]; then
  page_paths_here=$(git diff --name-only "$merge_base_skew" HEAD -- tools/ guides/ chaingraph/chains/ 'chaingraph/*.html' 2>/dev/null)
  if [ -n "$page_paths_here" ] && timeout 5 git fetch origin main --quiet 2>/dev/null; then
    page_paths_main=$(git diff --name-only "$merge_base_skew" origin/main -- tools/ guides/ chaingraph/chains/ 'chaingraph/*.html' sitemap.html 2>/dev/null)
    if [ -n "$page_paths_main" ]; then
      echo "────────────────────────────────────────────────────────────────" 1>&2
      echo "⚠ pre-push advisory: sibling pages landed on origin/main since this branch was cut." 1>&2
      echo "  Rebase onto origin/main and re-run node scripts/gen-sitemap-html.mjs before pushing," 1>&2
      echo "  or expect the main-side regen to follow your merge." 1>&2
      echo "  (advisory only — this does not block the push)" 1>&2
      echo "────────────────────────────────────────────────────────────────" 1>&2
    fi
  fi
fi

# PREPUSH-SITEHOOK-1 (2026-08-04): VISIBILITY, not prevention — SO #27 stays legal,
# a documented --no-verify bypass is still possible. The gap this closes: a push that
# skips this hook (--no-verify) produces IDENTICAL terminal output to a clean push —
# nothing distinguishes "preflight ran and passed" from "preflight never ran" at push
# time. This hook cannot warn about its own bypass (it doesn't run when bypassed), so
# for pushes touching a PROTECTED path we leave a POSITIVE attestation a later reader
# can check for and find ABSENT on a bypassed push: a git note on the pushed commit,
# on its own ref, pushed alongside the branch.
#   Check it:  git fetch origin refs/notes/preflight-attestation:refs/notes/preflight-attestation
#              git notes --ref=preflight-attestation show <sha>
#   Present = preflight ran and passed for that commit.
#
# PREPUSH-ATTEST-CHECK-1 (2026-08-22, 0xAlpha mechanical-verification audit Finding 2
# / Rec A1) — TWO changes, and the marker string on this line is load-bearing:
#   1. SCOPE. The note used to be written ONLY for chaingraph.json pushes. The blind
#      spot is wider: kernels, manifests, scripts/ (where every gate lives) and
#      .github/workflows/ (where CI itself lives) could all be pushed past preflight
#      with nothing recording it. The protected set is now read back out of
#      scripts/check-prepush-attestation.mjs --print-pathspec, so the WRITER (here)
#      and the READER (that gate) cannot drift into disagreeing about what is covered.
#   2. A READER EXISTS NOW. .github/workflows/prepush-attestation.yml fails main when
#      a protected-path commit has no note, turning SO #27's manual "name the gate in
#      the PR body" into a mechanical verdict. A LEGITIMATE bypass stays legal and
#      green — declare it BEFORE the push:
#          node scripts/check-prepush-attestation.mjs --attest-bypass "<SO #27 reason>"
#      which writes a PREFLIGHT-BYPASS note and pushes the ref. Missing note = red,
#      declared bypass = green and logged. The SILENT bypass is the only thing closed.
#   ⛔ Do not delete the PREPUSH-ATTEST-CHECK-1 marker above: the reader asserts it is
#      still present and goes red (WRITER-REMOVED) if it is not, so the writer cannot
#      be quietly removed while the gate keeps reporting green over an empty ref.
merge_base=$(git merge-base origin/main HEAD 2>/dev/null) || merge_base=""
protected_spec=$(node scripts/check-prepush-attestation.mjs --print-pathspec 2>/dev/null)
protected_hits=""
if [ -n "$merge_base" ] && [ -n "$protected_spec" ]; then
  # Unquoted on purpose: the pathspec list is space-separated, and word-splitting is
  # what turns it into separate `git diff` pathspec arguments.
  # shellcheck disable=SC2086
  protected_hits=$(git diff --name-only "$merge_base" HEAD -- $protected_spec | head -n 6)
fi
if [ -n "$protected_hits" ]; then
  note_sha=$(git rev-parse HEAD)
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  echo "════════════════════════════════════════════════════════════════"
  echo "✅ PREFLIGHT VERIFIED — protected path touched, all hard CI gates passed."
  echo "$protected_hits" | sed 's/^/     /'
  echo "   Attesting commit $note_sha at $ts (git note, ref preflight-attestation)."
  echo "════════════════════════════════════════════════════════════════"
  if git notes --ref=preflight-attestation add -f -m "PREFLIGHT-VERIFIED sha=$note_sha ts=$ts" "$note_sha" >/dev/null 2>&1; then
    AINUM_PREPUSH_ATTESTING=1 git push origin refs/notes/preflight-attestation >/dev/null 2>&1 || \
      echo "pre-push: (non-fatal) could not push preflight-attestation note upstream — local note still recorded." 1>&2
  else
    echo "pre-push: (non-fatal) could not write preflight-attestation note." 1>&2
  fi
fi

exit 0
