# ledger.ainumbers.co — always revalidate the single-file app (spec §7; version constant in footer)
<IfModule mod_headers.c>
Header set Cache-Control "no-cache"
</IfModule>

# §HASHRES-1 addressing convention (SPEC.md :1301): GET ledger.ainumbers.co/<execution_hash>
# serves the app shell so client-side JS can recompute-and-match the hash against this
# Ledger's local store, or show a 404 state — never different content under the same address.
# Anything NOT shaped like a hash falls through to Apache's normal 404 (no rule matches it).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([0-9a-fA-F]{64,66})/?$ index.html [L]
</IfModule>
