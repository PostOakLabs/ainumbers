# frame-ancestors: same-origin only (AIN Bridge same-origin iframes are legit; embedding ruled NOT a supported use 2026-09-03)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

# DID + Web Bot Auth directory content types (DIDWEB-WBA-DIRECTORY-1)
<IfModule mod_mime.c>
  <Files "did.json">
    ForceType application/did+json
  </Files>
  <Files "http-message-signatures-directory">
    ForceType application/http-message-signatures-directory+json
  </Files>
</IfModule>

# ---------------------------------------------------------------------------
# 2026-10-31 GSC-HTACCESS-REDIRECTS-1: renamed tools + parity-deleted guides.
# RedirectMatch (anchored) not plain Redirect: mod_alias prefix-matches, so
# /old.html would otherwise become /new.html.html. First mod_rewrite use on
# this host — the extensionless rule is guarded by IfModule and only fires
# when the requested path has no file/dir but <path>.html does.
# ---------------------------------------------------------------------------
RedirectMatch 301 ^/tools/tool-43-batch-sanctions-screening(\.html)?$ /tools/43-batch-sanctions-screening.html
RedirectMatch 301 ^/tools/tool-88-compliance-readiness(\.html)?$ /tools/88-compliance-readiness.html
RedirectMatch 301 ^/tools/tool-98-iso20022-validator(\.html)?$ /tools/98-iso20022-validator.html
