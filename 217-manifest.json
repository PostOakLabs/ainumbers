{
  "tool_id": "em-fx-risk-classifier",
  "version": "1.0.0",
  "title": "Emerging Market FX Risk Classifier",
  "description": "Classifies EM FX risk for 40+ currencies: convertibility tier, capital controls, NDF market depth, annualised volatility, and recommended hedging approach. IMF AREAER 2024 data. Client-side. Zero PII.",
  "category": "cat-18",
  "tags": [
    "EM FX",
    "convertibility",
    "capital controls",
    "NDF",
    "IMF AREAER",
    "hedging"
  ],
  "audience": [
    "treasury",
    "compliance",
    "risk"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "currency": {
        "type": "string",
        "description": "ISO 4217 3-letter currency code, e.g. BRL, INR, TRY"
      },
      "region": {
        "type": "string",
        "enum": [
          "LATAM",
          "APAC",
          "EMEA",
          "MENA",
          ""
        ]
      }
    },
    "required": [
      "currency"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "currency": {
        "type": "string"
      },
      "convertibility_tier": {
        "type": "string"
      },
      "ndf_available": {
        "type": "boolean"
      },
      "annualised_vol_pct": {
        "type": "number"
      },
      "capital_controls": {
        "type": "string"
      },
      "recommended_hedge": {
        "type": "string"
      }
    }
  },
  "mcp_tool_definition": {
    "name": "classify_em_fx_risk",
    "description": "Classifies EM FX risk for a given currency: convertibility tier, capital controls, NDF availability, volatility, and hedging approach. Use when assessing cross-border exposure to EM currencies.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "currency"
      ]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "tools/217-em-fx-risk-classifier.html",
    "function_name": "runClassifier",
    "timeout_ms": 5000
  },
  "ap2_export": false
}