{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vintage table",
  "description": "One dated value of one named fact. Entries are added, never rewritten; a correction is a new entry with `corrects`.",
  "type": "object",
  "required": ["vintages"],
  "properties": {
    "vintages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact", "vintage", "value", "unit", "effective_from", "effective_to", "source", "successor_expected_by", "entered_by", "entered_at"],
        "additionalProperties": false,
        "properties": {
          "fact": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
          "vintage": { "type": "string" },
          "value": { "type": ["number", "string", "object"] },
          "unit": { "type": "string" },
          "effective_from": { "type": "string", "format": "date" },
          "effective_to": { "type": ["string", "null"], "format": "date" },
          "source": {
            "type": "object",
            "required": ["clause_digest", "scheme", "id"],
            "additionalProperties": false,
            "properties": {
              "clause_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "scheme": { "type": "string" },
              "id": { "type": "string" }
            }
          },
          "successor_expected_by": { "type": ["string", "null"], "format": "date" },
          "corrects": { "type": "string" },
          "entered_by": { "type": "string" },
          "entered_at": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
