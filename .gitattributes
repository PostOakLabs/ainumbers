# Enforce LF line endings for all text files.
# This prevents Windows CRLF phantom diffs — without this every push
# from a Windows checkout flags 300+ unmodified files as "changed".
#
# After adding this file, run once in your terminal to renormalise:
#   git add --renormalize .
#   git commit -m "chore: normalise all line endings to LF"
#   git push

* text=auto eol=lf

# Explicit text overrides for common types
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.svg   text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary

# Vendored byte-exact test data (JCS-RFC8785-VECTORS-1) — never touch line
# endings; the RFC 8785 vector gate pins each file's sha256 at the upstream pin
# 19d51d7fe467d4706a3ff08adf8a748f29fc21e0 (LICENSE upstream is CRLF).
chaingraph/standard/vendor/rfc8785-testdata/** -text

# PR-AUTOFIX-DERIVABLES-1: the per-PR derivables the autofix bot writes
# (.github/workflows/pr-autofix.yml) are machine-regenerated region-bearing
# files — the §18 deferred ratchet baseline, the manifest example/annotation
# regions, and the a11y stamp baseline. Marking them linguist-generated keeps
# their autofix/bump diffs collapsed in review so a reviewer sees the PR's own
# authored bytes first (RED-PATTERNS-4WK-2026-10-08 §4 fix 1 pre-condition).
# ⛔ Region-level marking does not exist in gitattributes, so the generated
# stamp regions INSIDE chaingraph/*.html node pages deliberately stay unmarked:
# collapsing whole page diffs would hide the PR's own review surface.
scripts/compute-proof-baseline.json linguist-generated=true
scripts/a11y-baseline.json linguist-generated=true
scripts/manifest-examples-baseline.json linguist-generated=true
manifests/*.manifest.json linguist-generated=true
