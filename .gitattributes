# Enforce LF line endings for all text files.
# This prevents Windows CRLF phantom diffs — without this every push
# from a Windows checkout flags 300+ unmodified files as "changed".
#
# After adding this file, run once in your terminal to renormalise:
#   git add --renormalize .
#   git commit -m "chore: normalise all line endings to LF"
#   git push

* text=auto eol=lf

# Explicit text overrides for common types
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.svg   text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
