      "fix": "Add a canonical-sort step: function canonStr(v) { if (v===null||typeof v!==\"object\") return JSON.stringify(v); if (Array.isArray(v)) return \"[\"+v.map(canonStr).join(\",\")+\"]\"; return \"{\"+Object.keys(v).sort().map(k=>JSON.stringify(k)+\":\"+canonStr(v[k])).join(\",\")+\"}\"; } then call _sha256(canonStr(obj)) instead of _sha256(JSON.stringify(obj))."
